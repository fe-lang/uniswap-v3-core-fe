use core::ptr::{self, MemSpan}

/// The byte address `offset` bytes past `base`.
pub fn at(_ base: *u8, _ offset: u256) -> *u8 {
    ptr::offset_bytes(base, offset)
}

/// The byte range `[base, base + len)`.
///
/// # Safety
/// The complete range must fit without wrapping in a live allocation and remain
/// initialized and valid for every operation receiving this temporary view.
pub unsafe fn span(_ base: *u8, _ len: u256) -> ref MemSpan {
    MemSpan::from_raw_parts(ptr: base, len)
}
