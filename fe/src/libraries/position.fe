use std::evm::encode_abi_payload
use std::evm::{Address, Evm}
use super::fixed_point_128::Q128
use super::full_math::mul_div
use super::liquidity_math::add_delta
use super::revert_reason::{require_short, MSG_NP}
use super::tick_bitmap::int_key

const MASK_U24: u256 = 0xffffff
const MASK_U128: u256 = 0xffffffffffffffffffffffffffffffff
const MIN_I24: i256 = -0x800000
const MAX_I24: i256 = 0x7fffff

#[arithmetic(unchecked)]
fn checked_int24_word(_ value: i256) -> u256 {
    assert(value >= MIN_I24 && value <= MAX_I24)
    int_key(value) & MASK_U24
}

#[arithmetic(unchecked)]
pub fn position_key(owner: Address, tick_lower: i256, tick_upper: i256) -> u256
uses (evm: mut Evm)
{
    let word = (owner.inner << 96)
        | (checked_int24_word(tick_lower) << 72)
        | (checked_int24_word(tick_upper) << 48)
    let ptr = encode_abi_payload((word,))
    evm.keccak256(data: ptr.span().head(26))
}

/// The four words of a Solidity position entry. Keeping liquidity in a full
/// word preserves the existing layout; the two owed amounts share the last word.
pub struct Info {
    liquidity: u256,
    fee_growth_inside0_last_x128: u256,
    fee_growth_inside1_last_x128: u256,
    tokens_owed0: u128,
    tokens_owed1: u128,
}

pub fn read_tokens_owed(_ info: ref Info) -> (u128, u128) {
    (info.tokens_owed0, info.tokens_owed1)
}

pub fn set_tokens_owed(_ info: mut Info, token0: u128, token1: u128) {
    info.tokens_owed0 = token0
    info.tokens_owed1 = token1
}

pub fn read_position(_ info: ref Info) -> (u128, u256, u256, u128, u128) {
    (
        (info.liquidity & MASK_U128).downcast_unchecked(),
        info.fee_growth_inside0_last_x128,
        info.fee_growth_inside1_last_x128,
        info.tokens_owed0,
        info.tokens_owed1,
    )
}

#[arithmetic(unchecked)]
pub fn update(
    _ info: mut Info,
    liquidity_delta: i128,
    fee_growth_inside0_x128: u256,
    fee_growth_inside1_x128: u256,
    principal_owed0_delta: u128,
    principal_owed1_delta: u128,
) {
    let liquidity_before: u128 = (info.liquidity & MASK_U128).downcast_unchecked()
    let fee_growth_inside0_last_x128_before = info.fee_growth_inside0_last_x128
    let fee_growth_inside1_last_x128_before = info.fee_growth_inside1_last_x128
    let tokens_owed0_before = info.tokens_owed0
    let tokens_owed1_before = info.tokens_owed1

    let liquidity_next = if liquidity_delta == 0 {
        require_short(condition: liquidity_before > 0, code: MSG_NP, len: 2)
        liquidity_before
    } else {
        add_delta(liquidity_before, liquidity_delta)
    }

    let fee_tokens_owed0_delta: u128 = mul_div(
        fee_growth_inside0_x128 - fee_growth_inside0_last_x128_before,
        liquidity_before as u256,
        denominator: Q128,
    )
        .downcast_unchecked()
    let fee_tokens_owed1_delta: u128 = mul_div(
        fee_growth_inside1_x128 - fee_growth_inside1_last_x128_before,
        liquidity_before as u256,
        denominator: Q128,
    )
        .downcast_unchecked()

    if liquidity_delta != 0 {
        info.liquidity = liquidity_next as u256
    }
    info.fee_growth_inside0_last_x128 = fee_growth_inside0_x128
    info.fee_growth_inside1_last_x128 = fee_growth_inside1_x128

    let total_tokens_owed0_delta = fee_tokens_owed0_delta + principal_owed0_delta
    let total_tokens_owed1_delta = fee_tokens_owed1_delta + principal_owed1_delta

    if total_tokens_owed0_delta > 0 || total_tokens_owed1_delta > 0 {
        info.tokens_owed0 = tokens_owed0_before + total_tokens_owed0_delta
        info.tokens_owed1 = tokens_owed1_before + total_tokens_owed1_delta
    }
}
