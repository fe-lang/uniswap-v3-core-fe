use std::abi::sol::{self, Int24}
use std::evm::ops::signextend
use std::evm::{Evm, RawOps, StorageMap}
use super::liquidity_math::add_delta
use super::revert_reason::{require_short, MSG_LO}
use super::safe_cast::to_int128
use super::tick_bitmap::int_key
use super::tick_math::{MAX_TICK, MIN_TICK}

const MAX_U128: u256 = 0xffffffffffffffffffffffffffffffff
const MAX_U160: u256 = 0xffffffffffffffffffffffffffffffffffffffff
const MAX_U32: u256 = 0xffffffff
const MASK_U128: u256 = 0xffffffffffffffffffffffffffffffff
const MASK_U160: u256 = 0xffffffffffffffffffffffffffffffffffffffff
const OVERFLOW_MIN_TICK: i256 = -16
const OVERFLOW_MAX_TICK: i256 = 16
const OVERFLOW_MAX_LIQUIDITY: u128 = 0x7ffffffffffffffffffffffffffffff
const U256_HALF_MAX: u256 = 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// Four complete words preserve the original Solidity tick record layout.
pub struct Info { word0: u256, word1: u256, word2: u256, word3: u256 }

pub type Ticks = StorageMap<i256, Info>

struct OverflowState {
    tick: u256,
    total_liquidity: u256,
    fee0: u256,
    fee1: u256,
    growth0: u256,
    growth1: u256,
}

#[arithmetic(unchecked)]
fn signed_word(_ value: i256, bits: u256) -> u256 {
    int_key(value) & ((1 << bits) - 1)
}

fn decode_i24_word(_ word: u256) -> i256 {
    signextend(byte: 2, value: word).downcast_unchecked()
}

fn decode_i56_word(_ word: u256) -> i256 {
    signextend(byte: 6, value: word).downcast_unchecked()
}

fn decode_i128_word(_ word: u256) -> i256 {
    signextend(byte: 15, value: word).downcast_unchecked()
}

#[arithmetic(unchecked)]
fn slot0(_ tick: i256) -> u256 uses (ticks: Ticks) {
    ticks[tick].word0
}

#[arithmetic(unchecked)]
fn slot1(_ tick: i256) -> u256 uses (ticks: Ticks) {
    ticks[tick].word1
}

#[arithmetic(unchecked)]
fn slot2(_ tick: i256) -> u256 uses (ticks: Ticks) {
    ticks[tick].word2
}

#[arithmetic(unchecked)]
fn slot3(_ tick: i256) -> u256 uses (ticks: Ticks) {
    ticks[tick].word3
}

#[arithmetic(unchecked)]
fn slot3_at(_ tick: i256, ticks: ref Ticks) -> u256 {
    ticks[tick].word3
}

#[arithmetic(unchecked)]
fn store_slot0_at(tick: i256, liquidity_gross: u128, liquidity_net: i128, ticks: mut Ticks) {
    let gross_word = liquidity_gross as u256
    let net_word = signed_word(liquidity_net as i256, bits: 128) << 128
    ticks[tick].word0 = gross_word | net_word
}

#[arithmetic(unchecked)]
fn store_slot0(tick: i256, liquidity_gross: u128, liquidity_net: i128)
uses (ticks: mut Ticks)
{
    store_slot0_at(
        tick,
        liquidity_gross: liquidity_gross,
        liquidity_net: liquidity_net,
        ticks: mut ticks,
    )
}

#[arithmetic(unchecked)]
fn store_slot3_at(
    tick: i256,
    tick_cumulative_outside: i256,
    seconds_per_liquidity_outside_x128: u256,
    seconds_outside: u32,
    initialized: bool,
    ticks: mut Ticks,
) {
    assert(seconds_per_liquidity_outside_x128 <= MAX_U160)
    let initialized_word = if initialized { 1 } else { 0 }
    let word = signed_word(tick_cumulative_outside, bits: 56)
        | (seconds_per_liquidity_outside_x128 << 56)
        | ((seconds_outside as u256) << 216)
        | (initialized_word << 248)
    ticks[tick].word3 = word
}

#[arithmetic(unchecked)]
fn store_slot3(
    tick: i256,
    tick_cumulative_outside: i256,
    seconds_per_liquidity_outside_x128: u256,
    seconds_outside: u32,
    initialized: bool,
)
uses (ticks: mut Ticks)
{
    store_slot3_at(
        tick,
        tick_cumulative_outside: tick_cumulative_outside,
        seconds_per_liquidity_outside_x128: seconds_per_liquidity_outside_x128,
        seconds_outside: seconds_outside,
        initialized: initialized,
        ticks: mut ticks,
    )
}

fn liquidity_gross(_ tick: i256) -> u128 uses (ticks: Ticks) {
    (slot0(tick) & MASK_U128).downcast_unchecked()
}

fn liquidity_net(_ tick: i256) -> i128 uses (ticks: Ticks) {
    let value = decode_i128_word(slot0(tick) >> 128)
    value.downcast_unchecked()
}

fn tick_cumulative_outside(_ tick: i256) -> i256 uses (ticks: Ticks) {
    decode_i56_word(slot3(tick))
}

fn seconds_per_liquidity_outside_x128(_ tick: i256) -> u256
uses (ticks: Ticks)
{
    (slot3(tick) >> 56) & MASK_U160
}

fn seconds_outside(_ tick: i256) -> u32 uses (ticks: Ticks) {
    ((slot3(tick) >> 216) & MAX_U32).downcast_unchecked()
}

fn initialized(_ tick: i256) -> bool uses (ticks: Ticks) {
    ((slot3(tick) >> 248) & 0xff) != 0
}

fn overflow_current_tick() -> i256 uses (overflow: OverflowState) {
    decode_i24_word(overflow.tick)
}

fn set_overflow_current_tick(_ tick: i256) uses (overflow: mut OverflowState) {
    overflow.tick = signed_word(tick, bits: 24)
}

fn overflow_total_liquidity() -> i256 uses (overflow: OverflowState) {
    overflow.total_liquidity.downcast_unchecked()
}

fn set_overflow_total_liquidity(_ liquidity: i256)
uses (overflow: mut OverflowState)
{
    overflow.total_liquidity = int_key(liquidity)
}

fn overflow_fee_growth_global0_x128() -> u256 uses (overflow: OverflowState) {
    overflow.fee0
}

fn overflow_fee_growth_global1_x128() -> u256 uses (overflow: OverflowState) {
    overflow.fee1
}

fn overflow_total_growth0() -> u256 uses (overflow: OverflowState) {
    overflow.growth0
}

fn overflow_total_growth1() -> u256 uses (overflow: OverflowState) {
    overflow.growth1
}

#[arithmetic(unchecked)]
fn increase_overflow_fee_growth_global0_x128(amount: u256)
uses (overflow: mut OverflowState)
{
    let total_growth = overflow_total_growth0()
    assert(total_growth + amount > total_growth)
    overflow.fee0 = overflow_fee_growth_global0_x128() + amount
    overflow.growth0 = total_growth + amount
}

#[arithmetic(unchecked)]
fn increase_overflow_fee_growth_global1_x128(amount: u256)
uses (overflow: mut OverflowState)
{
    let total_growth = overflow_total_growth1()
    assert(total_growth + amount > total_growth)
    overflow.fee1 = overflow_fee_growth_global1_x128() + amount
    overflow.growth1 = total_growth + amount
}

#[arithmetic(unchecked)]
pub fn tick_spacing_to_max_liquidity_per_tick(_ tick_spacing: i256) -> u128 {
    let min_tick = (MIN_TICK / tick_spacing) * tick_spacing
    let max_tick = (MAX_TICK / tick_spacing) * tick_spacing
    let num_ticks: u256 = ((max_tick - min_tick) / tick_spacing + 1).downcast_unchecked()
    (MAX_U128 / num_ticks).downcast_unchecked()
}

#[arithmetic(unchecked)]
pub fn get_fee_growth_inside_at(
    tick_lower: i256,
    tick_upper: i256,
    tick_current: i256,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    ticks: ref Ticks,
) -> (u256, u256) {
    let lower = ref ticks[tick_lower]
    let upper = ref ticks[tick_upper]
    let lower_fee_growth_outside0_x128 = lower.word1
    let lower_fee_growth_outside1_x128 = lower.word2
    let upper_fee_growth_outside0_x128 = upper.word1
    let upper_fee_growth_outside1_x128 = upper.word2

    let (fee_growth_below0_x128, fee_growth_below1_x128) = if tick_current >= tick_lower {
        (lower_fee_growth_outside0_x128, lower_fee_growth_outside1_x128)
    } else {
        (
            fee_growth_global0_x128 - lower_fee_growth_outside0_x128,
            fee_growth_global1_x128 - lower_fee_growth_outside1_x128,
        )
    }

    let (fee_growth_above0_x128, fee_growth_above1_x128) = if tick_current < tick_upper {
        (upper_fee_growth_outside0_x128, upper_fee_growth_outside1_x128)
    } else {
        (
            fee_growth_global0_x128 - upper_fee_growth_outside0_x128,
            fee_growth_global1_x128 - upper_fee_growth_outside1_x128,
        )
    }

    (
        fee_growth_global0_x128 - fee_growth_below0_x128 - fee_growth_above0_x128,
        fee_growth_global1_x128 - fee_growth_below1_x128 - fee_growth_above1_x128,
    )
}

#[arithmetic(unchecked)]
pub fn get_fee_growth_inside(
    tick_lower: i256,
    tick_upper: i256,
    tick_current: i256,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
) -> (u256, u256)
uses (ticks: Ticks)
{
    get_fee_growth_inside_at(
        tick_lower,
        tick_upper,
        tick_current,
        fee_growth_global0_x128,
        fee_growth_global1_x128,
        ticks: ref ticks,
    )
}

pub fn set_tick(
    tick: i256,
    liquidity_gross_value: u128,
    liquidity_net_value: i128,
    fee_growth_outside0_x128: u256,
    fee_growth_outside1_x128: u256,
    tick_cumulative_outside_value: i256,
    seconds_per_liquidity_outside_x128_value: u256,
    seconds_outside_value: u32,
    initialized_value: bool,
)
uses (ticks: mut Ticks)
{
    store_slot0(
        tick,
        liquidity_gross: liquidity_gross_value,
        liquidity_net: liquidity_net_value,
    )
    ticks[tick].word1 = fee_growth_outside0_x128
    ticks[tick].word2 = fee_growth_outside1_x128
    store_slot3(
        tick,
        tick_cumulative_outside: tick_cumulative_outside_value,
        seconds_per_liquidity_outside_x128: seconds_per_liquidity_outside_x128_value,
        seconds_outside: seconds_outside_value,
        initialized: initialized_value,
    )
}

#[arithmetic(unchecked)]
pub fn read_tick_at(_ tick: i256, ticks: ref Ticks) -> (
    u128,
    i128,
    u256,
    u256,
    i256,
    u256,
    u32,
    bool,
) {
    let info = ref ticks[tick]
    let slot0_word = info.word0
    let slot3_word = info.word3
    let liquidity_net_word = decode_i128_word(slot0_word >> 128)
    (
        (slot0_word & MASK_U128).downcast_unchecked(),
        liquidity_net_word.downcast_unchecked(),
        info.word1,
        info.word2,
        decode_i56_word(slot3_word),
        (slot3_word >> 56) & MASK_U160,
        ((slot3_word >> 216) & MAX_U32).downcast_unchecked(),
        ((slot3_word >> 248) & 0xff) != 0,
    )
}

pub fn read_tick(_ tick: i256) -> (u128, i128, u256, u256, i256, u256, u32, bool)
uses (ticks: Ticks)
{
    read_tick_at(tick, ticks: ref ticks)
}

#[arithmetic(unchecked)]
pub fn read_observation_tick_at(_ tick: i256, ticks: ref Ticks) -> (i256, u256, u32, bool) {
    let slot3_word = slot3_at(tick, ticks: ref ticks)
    (
        decode_i56_word(slot3_word),
        (slot3_word >> 56) & MASK_U160,
        ((slot3_word >> 216) & MAX_U32).downcast_unchecked(),
        ((slot3_word >> 248) & 0xff) != 0,
    )
}

#[arithmetic(unchecked)]
pub fn update_at(
    tick: i256,
    tick_current: i256,
    liquidity_delta: i128,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    seconds_per_liquidity_cumulative_x128: u256,
    tick_cumulative: i256,
    time: u32,
    upper: bool,
    max_liquidity: u128,
    ticks: mut Ticks,
) -> bool {
    assert(seconds_per_liquidity_cumulative_x128 <= MAX_U160)
    let info = mut ticks[tick]
    let slot0_word = info.word0
    let liquidity_gross_before: u128 = (slot0_word & MASK_U128).downcast_unchecked()
    let liquidity_gross_after = add_delta(liquidity_gross_before, liquidity_delta)
    require_short(
        condition: liquidity_gross_after <= max_liquidity,
        code: MSG_LO,
        len: 2,
    )

    let flipped = (liquidity_gross_after == 0) != (liquidity_gross_before == 0)
    if liquidity_gross_before == 0 {
        if tick <= tick_current {
            info.word1 = fee_growth_global0_x128
            info.word2 = fee_growth_global1_x128
            info.word3 = signed_word(tick_cumulative, bits: 56)
                | (seconds_per_liquidity_cumulative_x128 << 56)
                | ((time as u256) << 216)
                | ((1 as u256) << 248)
        } else {
            info.word3 = (1 as u256) << 248
        }
    }

    let liquidity_net_before = decode_i128_word(slot0_word >> 128)
    let liquidity_net_after = if upper {
        to_int128(liquidity_net_before - liquidity_delta as i256)
    } else {
        to_int128(liquidity_net_before + liquidity_delta as i256)
    }
    info.word0 = (liquidity_gross_after as u256)
        | (signed_word(liquidity_net_after as i256, bits: 128) << 128)

    flipped
}
pub fn update(
    tick: i256,
    tick_current: i256,
    liquidity_delta: i128,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    seconds_per_liquidity_cumulative_x128: u256,
    tick_cumulative: i256,
    time: u32,
    upper: bool,
    max_liquidity: u128,
) -> bool
uses (ticks: mut Ticks)
{
    update_at(
        tick,
        tick_current,
        liquidity_delta,
        fee_growth_global0_x128,
        fee_growth_global1_x128,
        seconds_per_liquidity_cumulative_x128,
        tick_cumulative,
        time,
        upper,
        max_liquidity,
        ticks: mut ticks,
    )
}

#[arithmetic(unchecked)]
pub fn clear_at(tick: i256, ticks: mut Ticks) {
    let info = mut ticks[tick]
    info.word0 = 0
    info.word1 = 0
    info.word2 = 0
    info.word3 = 0
}

pub fn clear(tick: i256) uses (ticks: mut Ticks) {
    clear_at(tick, ticks: mut ticks)
}

#[arithmetic(unchecked)]
pub fn cross(
    tick: i256,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    seconds_per_liquidity_cumulative_x128: u256,
    tick_cumulative: i256,
    time: u32,
) -> i128
uses (ticks: mut Ticks)
{
    assert(seconds_per_liquidity_cumulative_x128 <= MAX_U160)
    let fee_growth_outside0_x128 = fee_growth_global0_x128 - slot1(tick)
    let fee_growth_outside1_x128 = fee_growth_global1_x128 - slot2(tick)
    let old_spl = seconds_per_liquidity_outside_x128(tick)
    let new_spl = seconds_per_liquidity_cumulative_x128 - old_spl
    let tick_cumulative_outside_value = tick_cumulative - tick_cumulative_outside(tick)
    let seconds_outside_value = time - seconds_outside(tick)
    let liquidity_net_value = liquidity_net(tick)

    ticks[tick].word1 = fee_growth_outside0_x128
    ticks[tick].word2 = fee_growth_outside1_x128
    store_slot3(
        tick,
        tick_cumulative_outside: tick_cumulative_outside_value,
        seconds_per_liquidity_outside_x128: new_spl,
        seconds_outside: seconds_outside_value,
        initialized: initialized(tick),
    )

    liquidity_net_value
}

#[arithmetic(unchecked)]
pub fn cross_at(
    tick: i256,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    seconds_per_liquidity_cumulative_x128: u256,
    tick_cumulative: i256,
    time: u32,
    ticks: mut Ticks,
) -> i128 {
    assert(seconds_per_liquidity_cumulative_x128 <= MAX_U160)
    let info = mut ticks[tick]
    let slot0_word = info.word0
    let slot3_word = info.word3

    info.word1 = fee_growth_global0_x128 - info.word1
    info.word2 = fee_growth_global1_x128 - info.word2

    let tick_cumulative_outside = decode_i56_word(slot3_word)
    let seconds_per_liquidity_outside = (slot3_word >> 56) & MASK_U160
    let seconds_outside_value: u32 = ((slot3_word >> 216) & MAX_U32).downcast_unchecked()
    let word = signed_word(tick_cumulative - tick_cumulative_outside, bits: 56)
        | ((seconds_per_liquidity_cumulative_x128 - seconds_per_liquidity_outside) << 56)
        | (((time - seconds_outside_value) as u256) << 216)
        | (((slot3_word >> 248) & 0xff) << 248)
    info.word3 = word

    let liquidity_net = decode_i128_word(slot0_word >> 128)
    liquidity_net.downcast_unchecked()
}

msg TickTestMsg {
    #[selector = 0xf30dba93]
    Ticks { tick: i256 } -> (u128, i128, u256, u256, i256, u256, u32, bool),

    #[selector = 0x82c66f87]
    TickSpacingToMaxLiquidityPerTick { tickSpacing: i256 } -> u128,

    #[selector = 0x5cb083ce]
    SetTick {
        tick: i256,
        liquidityGross: u128,
        liquidityNet: i128,
        feeGrowthOutside0X128: u256,
        feeGrowthOutside1X128: u256,
        tickCumulativeOutside: i256,
        secondsPerLiquidityOutsideX128: u256,
        secondsOutside: u32,
        initialized: bool,
    },

    #[selector = 0x30e3ff4c]
    GetFeeGrowthInside {
        tickLower: i256,
        tickUpper: i256,
        tickCurrent: i256,
        feeGrowthGlobal0X128: u256,
        feeGrowthGlobal1X128: u256,
    } -> (u256, u256),

    #[selector = 0x20b90da9]
    Update {
        tick: i256,
        tickCurrent: i256,
        liquidityDelta: i128,
        feeGrowthGlobal0X128: u256,
        feeGrowthGlobal1X128: u256,
        secondsPerLiquidityCumulativeX128: u256,
        tickCumulative: i256,
        time: u32,
        upper: bool,
        maxLiquidity: u128,
    } -> bool,

    #[selector = 0xb613524a]
    Clear { tick: i256 },

    #[selector = 0xdf33fa88]
    Cross {
        tick: i256,
        feeGrowthGlobal0X128: u256,
        feeGrowthGlobal1X128: u256,
        secondsPerLiquidityCumulativeX128: u256,
        tickCumulative: i256,
        time: u32,
    } -> i128,
}

pub contract TickTest {
    mut ticks: Ticks,
    recv TickTestMsg {
        Ticks { tick } -> (u128, i128, u256, u256, i256, u256, u32, bool)
        uses (ticks)
        {
            read_tick(tick)
        }

        TickSpacingToMaxLiquidityPerTick { tickSpacing } -> u128 {
            tick_spacing_to_max_liquidity_per_tick(tickSpacing)
        }

        SetTick {
            tick,
            liquidityGross,
            liquidityNet,
            feeGrowthOutside0X128,
            feeGrowthOutside1X128,
            tickCumulativeOutside,
            secondsPerLiquidityOutsideX128,
            secondsOutside,
            initialized,
        }
        uses (mut ticks)
        {
            set_tick(
                tick,
                liquidity_gross_value: liquidityGross,
                liquidity_net_value: liquidityNet,
                fee_growth_outside0_x128: feeGrowthOutside0X128,
                fee_growth_outside1_x128: feeGrowthOutside1X128,
                tick_cumulative_outside_value: tickCumulativeOutside,
                seconds_per_liquidity_outside_x128_value: secondsPerLiquidityOutsideX128,
                seconds_outside_value: secondsOutside,
                initialized_value: initialized,
            )
        }

        GetFeeGrowthInside {
            tickLower,
            tickUpper,
            tickCurrent,
            feeGrowthGlobal0X128,
            feeGrowthGlobal1X128,
        } -> (u256, u256)
        uses (ticks)
        {
            get_fee_growth_inside(
                tick_lower: tickLower,
                tick_upper: tickUpper,
                tick_current: tickCurrent,
                fee_growth_global0_x128: feeGrowthGlobal0X128,
                fee_growth_global1_x128: feeGrowthGlobal1X128,
            )
        }

        Update {
            tick,
            tickCurrent,
            liquidityDelta,
            feeGrowthGlobal0X128,
            feeGrowthGlobal1X128,
            secondsPerLiquidityCumulativeX128,
            tickCumulative,
            time,
            upper,
            maxLiquidity,
        } -> bool
        uses (mut ticks)
        {
            update(
                tick,
                tick_current: tickCurrent,
                liquidity_delta: liquidityDelta,
                fee_growth_global0_x128: feeGrowthGlobal0X128,
                fee_growth_global1_x128: feeGrowthGlobal1X128,
                seconds_per_liquidity_cumulative_x128: secondsPerLiquidityCumulativeX128,
                tick_cumulative: tickCumulative,
                time,
                upper,
                max_liquidity: maxLiquidity,
            )
        }

        Clear { tick } uses (mut ticks) {
            clear(tick)
        }

        Cross {
            tick,
            feeGrowthGlobal0X128,
            feeGrowthGlobal1X128,
            secondsPerLiquidityCumulativeX128,
            tickCumulative,
            time,
        } -> i128
        uses (mut ticks)
        {
            cross(
                tick,
                fee_growth_global0_x128: feeGrowthGlobal0X128,
                fee_growth_global1_x128: feeGrowthGlobal1X128,
                seconds_per_liquidity_cumulative_x128: secondsPerLiquidityCumulativeX128,
                tick_cumulative: tickCumulative,
                time,
            )
        }
    }
}

msg TickEchidnaTestMsg {
    #[selector = sol("checkTickSpacingToParametersInvariants(int24)")]
    CheckTickSpacingToParametersInvariants { tickSpacing: Int24 },
}

pub contract TickEchidnaTest {
    recv TickEchidnaTestMsg {
        CheckTickSpacingToParametersInvariants { tickSpacing } {
            let spacing = tickSpacing.val as i256
            assert(spacing <= MAX_TICK)
            assert(spacing > 0)

            let min_tick = (MIN_TICK / spacing) * spacing
            let max_tick = (MAX_TICK / spacing) * spacing
            let max_liquidity_per_tick = tick_spacing_to_max_liquidity_per_tick(spacing)

            assert(max_tick == 0 - min_tick)
            assert(max_tick > 0)
            assert((max_tick - min_tick) % spacing == 0)

            let num_ticks: u256 = ((max_tick - min_tick) / spacing + 1).downcast_unchecked()
            assert((max_liquidity_per_tick as u256) * num_ticks <= MAX_U128)
        }
    }
}

msg TickOverflowSafetyEchidnaTestMsg {
    #[selector = sol("increaseFeeGrowthGlobal0X128(uint256)")]
    IncreaseFeeGrowthGlobal0X128 { amount: u256 },

    #[selector = sol("increaseFeeGrowthGlobal1X128(uint256)")]
    IncreaseFeeGrowthGlobal1X128 { amount: u256 },

    #[selector = sol("setPosition(int24,int24,int128)")]
    SetPosition { tickLower: Int24, tickUpper: Int24, liquidityDelta: i128 },

    #[selector = sol("moveToTick(int24)")]
    MoveToTick { target: Int24 },
}

pub contract TickOverflowSafetyEchidnaTest uses (evm: Evm) {
    mut ticks: Ticks,
    mut overflow: OverflowState,
    init()
    uses (mut overflow)
    {
        overflow.fee0 = U256_HALF_MAX
        overflow.fee1 = U256_HALF_MAX
    }

    recv TickOverflowSafetyEchidnaTestMsg {
        IncreaseFeeGrowthGlobal0X128 { amount } uses (mut overflow) {
            increase_overflow_fee_growth_global0_x128(amount)
        }

        IncreaseFeeGrowthGlobal1X128 { amount } uses (mut overflow) {
            increase_overflow_fee_growth_global1_x128(amount)
        }

        SetPosition { tickLower, tickUpper, liquidityDelta }
        uses (evm, mut ticks, mut overflow)
        {
            let lower = tickLower.val as i256
            let upper = tickUpper.val as i256
            assert(lower > OVERFLOW_MIN_TICK)
            assert(upper < OVERFLOW_MAX_TICK)
            assert(lower < upper)

            let current_tick = overflow_current_tick()
            let flipped_lower = update(
                tick: lower,
                tick_current: current_tick,
                liquidity_delta: liquidityDelta,
                fee_growth_global0_x128: overflow_fee_growth_global0_x128(),
                fee_growth_global1_x128: overflow_fee_growth_global1_x128(),
                seconds_per_liquidity_cumulative_x128: 0,
                tick_cumulative: 0,
                time: evm.timestamp().downcast_unchecked(),
                upper: false,
                max_liquidity: OVERFLOW_MAX_LIQUIDITY,
            )
            let flipped_upper = update(
                tick: upper,
                tick_current: current_tick,
                liquidity_delta: liquidityDelta,
                fee_growth_global0_x128: overflow_fee_growth_global0_x128(),
                fee_growth_global1_x128: overflow_fee_growth_global1_x128(),
                seconds_per_liquidity_cumulative_x128: 0,
                tick_cumulative: 0,
                time: evm.timestamp().downcast_unchecked(),
                upper: true,
                max_liquidity: OVERFLOW_MAX_LIQUIDITY,
            )

            if flipped_lower {
                let (liquidity_gross_value, _, _, _, _, _, _, _) = read_tick(lower)
                if liquidityDelta < 0 {
                    assert(liquidity_gross_value == 0)
                    clear(tick: lower)
                } else {
                    assert(liquidity_gross_value > 0)
                }
            }

            if flipped_upper {
                let (liquidity_gross_value, _, _, _, _, _, _, _) = read_tick(upper)
                if liquidityDelta < 0 {
                    assert(liquidity_gross_value == 0)
                    clear(tick: upper)
                } else {
                    assert(liquidity_gross_value > 0)
                }
            }

            let total_liquidity = overflow_total_liquidity() + liquidityDelta as i256
            set_overflow_total_liquidity(total_liquidity)
            assert(total_liquidity >= 0)

            if total_liquidity == 0 {
                overflow.growth0 = 0
                overflow.growth1 = 0
            }
        }

        MoveToTick { target } uses (evm, mut ticks, mut overflow) {
            let target_tick = target.val as i256
            assert(target_tick > OVERFLOW_MIN_TICK)
            assert(target_tick < OVERFLOW_MAX_TICK)

            let mut current_tick = overflow_current_tick()
            while current_tick != target_tick {
                if current_tick < target_tick {
                    let next_tick = current_tick + 1
                    let (liquidity_gross_value, _, _, _, _, _, _, _) = read_tick(next_tick)
                    if liquidity_gross_value > 0 {
                        cross(
                            tick: next_tick,
                            fee_growth_global0_x128: overflow_fee_growth_global0_x128(),
                            fee_growth_global1_x128: overflow_fee_growth_global1_x128(),
                            seconds_per_liquidity_cumulative_x128: 0,
                            tick_cumulative: 0,
                            time: evm.timestamp().downcast_unchecked(),
                        )
                    }
                    current_tick = next_tick
                } else {
                    let (liquidity_gross_value, _, _, _, _, _, _, _) = read_tick(current_tick)
                    if liquidity_gross_value > 0 {
                        cross(
                            tick: current_tick,
                            fee_growth_global0_x128: overflow_fee_growth_global0_x128(),
                            fee_growth_global1_x128: overflow_fee_growth_global1_x128(),
                            seconds_per_liquidity_cumulative_x128: 0,
                            tick_cumulative: 0,
                            time: evm.timestamp().downcast_unchecked(),
                        )
                    }
                    current_tick = current_tick - 1
                }
            }

            set_overflow_current_tick(current_tick)
        }
    }
}
