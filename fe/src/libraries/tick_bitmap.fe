use std::abi::sol::{self, Int24}
use std::evm::StorageMap

use super::bit_math::{least_significant_bit, most_significant_bit}

pub type Bitmap = StorageMap<i256, u256>

pub fn int_key(_ value: i256) -> u256 {
    value.downcast_unchecked()
}

#[arithmetic(unchecked)]
fn position(_ tick: i256) -> (i256, u256) {
    (tick >> 8, int_key(tick) & 0xff)
}

#[arithmetic(unchecked)]
pub fn flip_tick_at(tick: i256, tick_spacing: i256, bitmap: mut Bitmap) {
    assert(tick % tick_spacing == 0)
    let (word_pos, bit_pos) = position(tick / tick_spacing)
    let mask = 1 << bit_pos
    bitmap[word_pos] ^= mask
}

#[arithmetic(unchecked)]
pub fn next_initialized_tick_within_one_word_at(
    tick: i256,
    tick_spacing: i256,
    lte: bool,
    bitmap: ref Bitmap,
) -> (i256, bool) {
    let mut compressed = tick / tick_spacing
    if tick < 0 && tick % tick_spacing != 0 {
        compressed = compressed - 1
    }

    if lte {
        let (word_pos, bit_pos) = position(compressed)
        let bit = 1 << bit_pos
        let mask = (bit - 1) + bit
        let masked = bitmap[word_pos] & mask
        if masked != 0 {
            let delta: i256 = (bit_pos - (most_significant_bit(masked) as u256))
                .downcast_unchecked()
            return ((compressed - delta) * tick_spacing, true)
        }

        let delta: i256 = bit_pos.downcast_unchecked()
        return ((compressed - delta) * tick_spacing, false)
    }

    let (word_pos, bit_pos) = position(compressed + 1)
    let mask = !((1 << bit_pos) - 1)
    let masked = bitmap[word_pos] & mask
    if masked != 0 {
        let delta: i256 = ((least_significant_bit(masked) as u256) - bit_pos).downcast_unchecked()
        return ((compressed + 1 + delta) * tick_spacing, true)
    }

    let delta: i256 = (0xff - bit_pos).downcast_unchecked()
    ((compressed + 1 + delta) * tick_spacing, false)
}

fn is_initialized_at(_ tick: i256, bitmap: ref Bitmap) -> bool {
    let (next, initialized) = next_initialized_tick_within_one_word_at(
        tick,
        tick_spacing: 1,
        lte: true,
        bitmap: ref bitmap,
    )

    next == tick && initialized
}

msg TickBitmapTestMsg {
    #[selector = 0x8815912f]
    FlipTick { tick: i256 },

    #[selector = 0x3e7ba228]
    NextInitializedTickWithinOneWord { tick: i256, lte: bool } -> (i256, bool),

    #[selector = 0x2bdc2fd3]
    IsInitialized { tick: i256 } -> bool,
}

pub contract TickBitmapTest {
    mut bitmap: Bitmap,
    recv TickBitmapTestMsg {
        FlipTick { tick } uses (mut bitmap) {
            flip_tick_at(tick, tick_spacing: 1, bitmap: mut bitmap)
        }

        NextInitializedTickWithinOneWord { tick, lte } -> (i256, bool)
        uses (bitmap)
        {
            next_initialized_tick_within_one_word_at(tick, tick_spacing: 1, lte, bitmap: ref bitmap)
        }

        IsInitialized { tick } -> bool uses (bitmap) {
            is_initialized_at(tick, bitmap: ref bitmap)
        }
    }
}

msg TickBitmapEchidnaTestMsg {
    #[selector = sol("flipTick(int24)")]
    FlipTick { tick: Int24 },

    #[selector = sol(
        "checkNextInitializedTickWithinOneWordInvariants(int24,bool)",
    )]
    CheckNextInitializedTickWithinOneWordInvariants { tick: Int24, lte: bool },
}

pub contract TickBitmapEchidnaTest {
    mut bitmap: Bitmap,
    recv TickBitmapEchidnaTestMsg {
        FlipTick { tick } uses (mut bitmap) {
            let tick_i = tick.val as i256
            let before = is_initialized_at(tick_i, bitmap: ref bitmap)
            flip_tick_at(tick: tick_i, tick_spacing: 1, bitmap: mut bitmap)
            let after = is_initialized_at(tick_i, bitmap: ref bitmap)
            assert(after == !before)
        }

        CheckNextInitializedTickWithinOneWordInvariants { tick, lte }
        uses (bitmap)
        {
            let tick_i = tick.val as i256
            let (next, initialized) = next_initialized_tick_within_one_word_at(
                tick: tick_i,
                tick_spacing: 1,
                lte,
                bitmap: ref bitmap,
            )

            if lte {
                assert(tick_i >= -8388352)
                assert(next <= tick_i)
                assert(tick_i - next < 256)

                let mut i = tick_i
                while i > next {
                    assert(!is_initialized_at(i, bitmap: ref bitmap))
                    i = i - 1
                }
                assert(is_initialized_at(next, bitmap: ref bitmap) == initialized)
            } else {
                assert(tick_i < 8388351)
                assert(next > tick_i)
                assert(next - tick_i <= 256)

                let mut i = tick_i + 1
                while i < next {
                    assert(!is_initialized_at(i, bitmap: ref bitmap))
                    i = i + 1
                }
                assert(is_initialized_at(next, bitmap: ref bitmap) == initialized)
            }
        }
    }
}
