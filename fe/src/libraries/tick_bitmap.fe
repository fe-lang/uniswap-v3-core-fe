use core::ptr
use super::mem::{at, span}
use std::abi::sol::{self, Int24}
use std::evm::{Evm, RawMem, RawStorage}
use super::bit_math::{least_significant_bit, most_significant_bit}

pub fn int_key(_ value: i256) -> u256 {
    value.downcast_unchecked()
}

#[arithmetic(unchecked)]
fn position(_ tick: i256) -> (i256, u256) {
    (tick >> 8, int_key(tick) & 0xff)
}

#[arithmetic(unchecked)]
pub fn word_slot(word_pos: i256, bitmap_slot: u256) -> u256 uses (evm: mut Evm) {
    let ptr = ptr::alloc_bytes(64)
    evm.mstore(addr: ptr, value: int_key(word_pos))
    evm.mstore(addr: at(ptr, 32), value: bitmap_slot)
    evm.keccak256(data: span(ptr, 64))
}

#[arithmetic(unchecked)]
pub fn flip_tick_at(tick: i256, tick_spacing: i256, bitmap_slot: u256)
uses (evm: mut Evm)
{
    assert(tick % tick_spacing == 0)
    let (word_pos, bit_pos) = position(tick / tick_spacing)
    let slot = word_slot(word_pos, bitmap_slot: bitmap_slot)
    let mask = 1 << bit_pos
    evm.sstore(slot: slot, value: evm.sload(slot) ^ mask)
}

#[arithmetic(unchecked)]
pub fn next_initialized_tick_within_one_word_at(
    tick: i256,
    tick_spacing: i256,
    lte: bool,
    bitmap_slot: u256,
) -> (i256, bool)
uses (evm: mut Evm)
{
    let mut compressed = tick / tick_spacing
    if tick < 0 && tick % tick_spacing != 0 {
        compressed = compressed - 1
    }

    if lte {
        let (word_pos, bit_pos) = position(compressed)
        let bit = 1 << bit_pos
        let mask = (bit - 1) + bit
        let masked = evm.sload(word_slot(word_pos, bitmap_slot: bitmap_slot)) & mask
        if masked != 0 {
            let delta: i256 = (bit_pos - (most_significant_bit(masked) as u256))
                .downcast_unchecked()
            return ((compressed - delta) * tick_spacing, true)
        }

        let delta: i256 = bit_pos.downcast_unchecked()
        return ((compressed - delta) * tick_spacing, false)
    }

    let (word_pos, bit_pos) = position(compressed + 1)
    let mask = !((1 << bit_pos) - 1)
    let masked = evm.sload(word_slot(word_pos, bitmap_slot: bitmap_slot)) & mask
    if masked != 0 {
        let delta: i256 = ((least_significant_bit(masked) as u256) - bit_pos).downcast_unchecked()
        return ((compressed + 1 + delta) * tick_spacing, true)
    }

    let delta: i256 = (0xff - bit_pos).downcast_unchecked()
    ((compressed + 1 + delta) * tick_spacing, false)
}

const TEST_BITMAP_SLOT: u256 = 0

fn is_initialized_at(_ tick: i256, bitmap_slot: u256) -> bool
uses (evm: mut Evm)
{
    let (next, initialized) = next_initialized_tick_within_one_word_at(
        tick,
        tick_spacing: 1,
        lte: true,
        bitmap_slot,
    )

    next == tick && initialized
}

msg TickBitmapTestMsg {
    #[selector = 0x8815912f]
    FlipTick { tick: i256 },

    #[selector = 0xf04bc943]
    GetGasCostOfFlipTick { tick: i256 } -> u256,

    #[selector = 0x3e7ba228]
    NextInitializedTickWithinOneWord { tick: i256, lte: bool } -> (i256, bool),

    #[selector = 0xf0fc9224]
    GetGasCostOfNextInitializedTickWithinOneWord { tick: i256, lte: bool } -> u256,

    #[selector = 0x2bdc2fd3]
    IsInitialized { tick: i256 } -> bool,
}

pub contract TickBitmapTest uses (evm: mut Evm) {
    recv TickBitmapTestMsg {
        FlipTick { tick } uses (mut evm) {
            flip_tick_at(tick, tick_spacing: 1, bitmap_slot: TEST_BITMAP_SLOT)
        }

        GetGasCostOfFlipTick { tick } -> u256 uses (mut evm) {
            let gas_before = evm.gas()
            flip_tick_at(tick, tick_spacing: 1, bitmap_slot: TEST_BITMAP_SLOT)
            gas_before - evm.gas()
        }

        NextInitializedTickWithinOneWord { tick, lte } -> (i256, bool)
        uses (mut evm)
        {
            next_initialized_tick_within_one_word_at(
                tick,
                tick_spacing: 1,
                lte,
                bitmap_slot: TEST_BITMAP_SLOT,
            )
        }

        GetGasCostOfNextInitializedTickWithinOneWord { tick, lte } -> u256
        uses (mut evm)
        {
            let gas_before = evm.gas()
            next_initialized_tick_within_one_word_at(
                tick,
                tick_spacing: 1,
                lte,
                bitmap_slot: TEST_BITMAP_SLOT,
            )
            gas_before - evm.gas()
        }

        IsInitialized { tick } -> bool uses (mut evm) {
            is_initialized_at(tick, bitmap_slot: TEST_BITMAP_SLOT)
        }
    }
}

msg TickBitmapEchidnaTestMsg {
    #[selector = sol("flipTick(int24)")]
    FlipTick { tick: Int24 },

    #[selector = sol(
        "checkNextInitializedTickWithinOneWordInvariants(int24,bool)",
    )]
    CheckNextInitializedTickWithinOneWordInvariants { tick: Int24, lte: bool },
}

pub contract TickBitmapEchidnaTest uses (evm: mut Evm) {
    recv TickBitmapEchidnaTestMsg {
        FlipTick { tick } uses (mut evm) {
            let tick_i = tick.val as i256
            let before = is_initialized_at(tick_i, bitmap_slot: TEST_BITMAP_SLOT)
            flip_tick_at(
                tick: tick_i,
                tick_spacing: 1,
                bitmap_slot: TEST_BITMAP_SLOT,
            )
            let after = is_initialized_at(tick_i, bitmap_slot: TEST_BITMAP_SLOT)
            assert(after == !before)
        }

        CheckNextInitializedTickWithinOneWordInvariants { tick, lte }
        uses (mut evm)
        {
            let tick_i = tick.val as i256
            let (next, initialized) = next_initialized_tick_within_one_word_at(
                tick: tick_i,
                tick_spacing: 1,
                lte,
                bitmap_slot: TEST_BITMAP_SLOT,
            )

            if lte {
                assert(tick_i >= -8388352)
                assert(next <= tick_i)
                assert(tick_i - next < 256)

                let mut i = tick_i
                while i > next {
                    assert(!is_initialized_at(i, bitmap_slot: TEST_BITMAP_SLOT))
                    i = i - 1
                }
                assert(
                    is_initialized_at(next, bitmap_slot: TEST_BITMAP_SLOT) == initialized,
                )
            } else {
                assert(tick_i < 8388351)
                assert(next > tick_i)
                assert(next - tick_i <= 256)

                let mut i = tick_i + 1
                while i < next {
                    assert(!is_initialized_at(i, bitmap_slot: TEST_BITMAP_SLOT))
                    i = i + 1
                }
                assert(
                    is_initialized_at(next, bitmap_slot: TEST_BITMAP_SLOT) == initialized,
                )
            }
        }
    }
}
