use core::abi::ByteInput
use core::ptr::MemBuffer
use std::evm::{Address, Call, Evm}

msg TokenMsg {
    #[selector = 0xa9059cbb]
    Transfer { to: Address, value: u256 },
}

pub fn safe_transfer(token: Address, to: Address, value: u256) uses (evm: mut Evm) {
    var ret = MemBuffer::with_capacity(32)
    let outcome = evm
        .try_call_into(
            addr: token,
            gas: evm.gas(),
            value: 0,
            message: TokenMsg::Transfer { to, value },
            ret: mut ret,
        )
    let ret_len = outcome.returndata_len()
    var returned_true = false
    if ret_len >= 32 {
        returned_true = ret.span().word_at(0) != 0
    }

    assert!(outcome.success() && (ret_len == 0 || returned_true), "TF")
}
