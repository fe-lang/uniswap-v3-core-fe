use std::abi::sol::{self, Bytes32, Int24, Uint160}
use std::evm::{assert_msg, Address, Call, Ctx, Evm, Log, RawMem}
use super::libraries::liquidity_math::add_delta
use super::libraries::position
use super::libraries::safe_cast::to_int128
use super::libraries::sqrt_price_math::{get_amount0_delta, get_amount1_delta}
use super::libraries::tick
use super::libraries::tick::tick_spacing_to_max_liquidity_per_tick
use super::libraries::tick_bitmap::{flip_tick_at, int_key}
use super::libraries::tick_math::{
    get_sqrt_ratio_at_tick,
    get_tick_at_sqrt_ratio,
    max_sqrt_ratio,
    min_sqrt_ratio,
    MAX_TICK,
    MIN_TICK,
}

const TEST_POOL_START_TIME: u256 = 1601906400
const TICKS_SLOT: u256 = 5
const TICK_BITMAP_SLOT: u256 = 6
const POSITIONS_SLOT: u256 = 7
const INITIALIZE_TOPIC: u256 = 0x98636036cb66a9c19a37435efc1e90142190214e8abeb821bdba3f2990dd4c95
const INCREASE_OBSERVATION_CARDINALITY_NEXT_TOPIC: u256 = 0xac49e518f90a358f652e4400164f05a5d8f7e35e7747279bc3a93dbf584e125a
const MINT_TOPIC: u256 = 0x7a53080ba414158be7ec69b987b5fb7d07dee101fe85488f0853ae16239d0bde

msg MockTimePoolDeployerMsg {
    #[selector = sol("parameters()")]
    Parameters -> (u256, u256, u256, u32, i32),
}

msg MockTimeUniswapV3PoolMsg {
    #[selector = sol("factory()")]
    Factory -> u256,

    #[selector = sol("token0()")]
    Token0 -> u256,

    #[selector = sol("token1()")]
    Token1 -> u256,

    #[selector = sol("fee()")]
    Fee -> u32,

    #[selector = sol("tickSpacing()")]
    TickSpacing -> i32,

    #[selector = sol("maxLiquidityPerTick()")]
    MaxLiquidityPerTick -> u128,

    #[selector = sol("slot0()")]
    Slot0 -> (u256, i32, u16, u16, u16, u8, bool),

    #[selector = sol("observations(uint256)")]
    Observations { index: u256 } -> (u32, i64, u256, bool),

    #[selector = sol("initialize(uint160)")]
    Initialize { sqrtPriceX96: Uint160 },

    #[selector = sol("increaseObservationCardinalityNext(uint16)")]
    IncreaseObservationCardinalityNext { observationCardinalityNext: u16 },

    #[selector = sol("time()")]
    Time -> u256,

    #[selector = sol("advanceTime(uint256)")]
    AdvanceTime { by: u256 },

    #[selector = sol("setFeeGrowthGlobal0X128(uint256)")]
    SetFeeGrowthGlobal0X128 { value: u256 },

    #[selector = sol("setFeeGrowthGlobal1X128(uint256)")]
    SetFeeGrowthGlobal1X128 { value: u256 },

    #[selector = sol("feeGrowthGlobal0X128()")]
    FeeGrowthGlobal0X128 -> u256,

    #[selector = sol("feeGrowthGlobal1X128()")]
    FeeGrowthGlobal1X128 -> u256,

    #[selector = sol("liquidity()")]
    Liquidity -> u128,

    #[selector = sol("ticks(int24)")]
    Ticks { tick: Int24 } -> (u128, i128, u256, u256, i64, u256, u32, bool),

    #[selector = sol("positions(bytes32)")]
    Positions { key: Bytes32 } -> (u128, u256, u256, u128, u128),

    #[selector = sol("mint(address,int24,int24,uint128,bytes)")]
    Mint { recipient: Address, tickLower: Int24, tickUpper: Int24, amount: u128, data: Bytes } -> (
        u256,
        u256,
    ),
}

msg Erc20MinimalMsg {
    #[selector = sol("balanceOf(address)")]
    BalanceOf { account: Address } -> u256,
}

msg MintCallbackMsg {
    #[selector = sol("uniswapV3MintCallback(uint256,uint256,bytes)")]
    UniswapV3MintCallback { amount0Owed: u256, amount1Owed: u256, data: Bytes },
}

struct MockTimePoolStore {
    factory: Address,
    token0: Address,
    token1: Address,
    fee: u32,
    tick_spacing: i32,
    max_liquidity_per_tick: u128,
    sqrt_price_x96: u256,
    tick: i32,
    observation_index: u16,
    observation_cardinality: u16,
    observation_cardinality_next: u16,
    fee_protocol: u8,
    unlocked: bool,
    observation0_block_timestamp: u32,
    observation0_tick_cumulative: i64,
    observation0_seconds_per_liquidity_cumulative_x128: u256,
    observation0_initialized: bool,
    time: u256,
    liquidity: u128,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
}

fn int24_abi_word(_ value: i32) -> u256 {
    int_key(value as i256)
}

fn check_ticks(tick_lower: i256, tick_upper: i256) {
    assert_msg(tick_lower < tick_upper, "TLU")
    assert_msg(tick_lower >= MIN_TICK, "TLM")
    assert_msg(tick_upper <= MAX_TICK, "TUM")
}

fn current_tick_cumulative(tick_cumulative: i64, tick_current: i32, time_delta: u32) -> i256 {
    (tick_cumulative as i256) + ((tick_current as i256) * (time_delta as i256))
}

fn current_seconds_per_liquidity(
    seconds_per_liquidity_cumulative_x128: u256,
    time_delta: u32,
    liquidity: u128,
) -> u256 {
    let denominator = if liquidity > 0 { liquidity as u256 } else { 1 }
    seconds_per_liquidity_cumulative_x128 + (((time_delta as u256) << 128) / denominator)
}

fn emit_initialize(sqrt_price_x96: u256, tick: i32) uses (evm: mut Evm) {
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(addr: ptr, value: sqrt_price_x96)
    evm.mstore(addr: ptr + 32, value: int24_abi_word(tick))
    evm.log1(offset: ptr, len: 64, topic0: INITIALIZE_TOPIC)
}

fn emit_increase_observation_cardinality_next(old: u16, new: u16)
uses (evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(addr: ptr, value: old as u256)
    evm.mstore(addr: ptr + 32, value: new as u256)
    evm.log1(
        offset: ptr,
        len: 64,
        topic0: INCREASE_OBSERVATION_CARDINALITY_NEXT_TOPIC,
    )
}

fn emit_mint(
    sender: Address,
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(addr: ptr, value: sender.inner)
    evm.mstore(addr: ptr + 32, value: amount as u256)
    evm.mstore(addr: ptr + 64, value: amount0)
    evm.mstore(addr: ptr + 96, value: amount1)
    evm.log4(
        offset: ptr,
        len: 128,
        topic0: MINT_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

pub contract MockTimeUniswapV3Pool uses (ctx: Ctx, call: mut Call, evm: mut Evm) {
    mut store: MockTimePoolStore,

    init()
    uses (ctx, mut call, mut store)
    {
        let params: (u256, u256, u256, u32, i32) = ctx
            .caller()
            .call(MockTimePoolDeployerMsg::Parameters {})
        let (factory, token0, token1, fee, tick_spacing) = params
        store.factory = Address { inner: factory }
        store.token0 = Address { inner: token0 }
        store.token1 = Address { inner: token1 }
        store.fee = fee
        store.tick_spacing = tick_spacing
        store.max_liquidity_per_tick = tick_spacing_to_max_liquidity_per_tick(tick_spacing as i256)
        store.time = TEST_POOL_START_TIME
    }

    recv MockTimeUniswapV3PoolMsg {
        Factory -> u256 uses (store) {
            store.factory.inner
        }

        Token0 -> u256 uses (store) {
            store.token0.inner
        }

        Token1 -> u256 uses (store) {
            store.token1.inner
        }

        Fee -> u32 uses (store) {
            store.fee
        }

        TickSpacing -> i32 uses (store) {
            store.tick_spacing
        }

        MaxLiquidityPerTick -> u128 uses (store) {
            store.max_liquidity_per_tick
        }

        Slot0 -> (u256, i32, u16, u16, u16, u8, bool)
        uses (store)
        {
            (
                store.sqrt_price_x96,
                store.tick,
                store.observation_index,
                store.observation_cardinality,
                store.observation_cardinality_next,
                store.fee_protocol,
                store.unlocked,
            )
        }

        Observations { index } -> (u32, i64, u256, bool)
        uses (store)
        {
            assert(index == 0)
            (
                store.observation0_block_timestamp,
                store.observation0_tick_cumulative,
                store.observation0_seconds_per_liquidity_cumulative_x128,
                store.observation0_initialized,
            )
        }

        Initialize { sqrtPriceX96 } uses (mut store, mut evm) {
            assert(store.sqrt_price_x96 == 0)
            assert_msg(
                sqrtPriceX96.val >= min_sqrt_ratio() && sqrtPriceX96.val < max_sqrt_ratio(),
                "R",
            )
            let tick: i32 = get_tick_at_sqrt_ratio(sqrt_price_x96: sqrtPriceX96.val)
                .downcast_unchecked()
            store.sqrt_price_x96 = sqrtPriceX96.val
            store.tick = tick
            store.observation_index = 0
            store.observation_cardinality = 1
            store.observation_cardinality_next = 1
            store.unlocked = true
            store.observation0_block_timestamp = store.time.downcast_unchecked()
            store.observation0_tick_cumulative = 0
            store.observation0_seconds_per_liquidity_cumulative_x128 = 0
            store.observation0_initialized = true
            emit_initialize(sqrt_price_x96: sqrtPriceX96.val, tick)
        }

        IncreaseObservationCardinalityNext { observationCardinalityNext }
        uses (mut store, mut evm)
        {
            assert_msg(store.unlocked, "LOK")
            store.unlocked = false
            let old = store.observation_cardinality_next
            let new = if observationCardinalityNext > old {
                observationCardinalityNext
            } else {
                old
            }
            store.observation_cardinality_next = new
            if old != new {
                emit_increase_observation_cardinality_next(old, new)
            }
            store.unlocked = true
        }

        Time -> u256 uses (store) {
            store.time
        }

        AdvanceTime { by } uses (mut store) {
            store.time += by
        }

        SetFeeGrowthGlobal0X128 { value } uses (mut store) {
            store.fee_growth_global0_x128 = value
        }

        SetFeeGrowthGlobal1X128 { value } uses (mut store) {
            store.fee_growth_global1_x128 = value
        }

        FeeGrowthGlobal0X128 -> u256 uses (store) {
            store.fee_growth_global0_x128
        }

        FeeGrowthGlobal1X128 -> u256 uses (store) {
            store.fee_growth_global1_x128
        }

        Liquidity -> u128 uses (store) {
            store.liquidity
        }

        Ticks { tick } -> (u128, i128, u256, u256, i64, u256, u32, bool)
        uses (mut evm)
        {
            let (
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside,
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            ) = tick::read_tick_at(tick.val as i256, ticks_slot: TICKS_SLOT)
            (
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside.downcast_unchecked(),
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            )
        }

        Positions { key } -> (u128, u256, u256, u128, u128)
        uses (mut evm)
        {
            position::read_position(
                position::mapping_slot(key: key.val, positions_slot: POSITIONS_SLOT),
            )
        }

        Mint { recipient, tickLower, tickUpper, amount, data } -> (u256, u256)
        uses (ctx, mut call, mut evm, mut store)
        {
            assert_msg(store.unlocked, "LOK")
            store.unlocked = false

            assert(amount > 0)
            let tick_lower = tickLower.val as i256
            let tick_upper = tickUpper.val as i256
            check_ticks(tick_lower, tick_upper: tick_upper)

            let liquidity_delta = to_int128(amount as i256)
            let current_time: u32 = store.time.downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = current_tick_cumulative(
                tick_cumulative: store.observation0_tick_cumulative,
                tick_current: store.tick,
                time_delta,
            )
            let previous_seconds_per_liquidity = store
                .observation0_seconds_per_liquidity_cumulative_x128
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: previous_seconds_per_liquidity,
                time_delta,
                liquidity: store.liquidity,
            )

            let flipped_lower = tick::update_at(
                tick: tick_lower,
                tick_current: store.tick as i256,
                liquidity_delta,
                fee_growth_global0_x128: store.fee_growth_global0_x128,
                fee_growth_global1_x128: store.fee_growth_global1_x128,
                seconds_per_liquidity_cumulative_x128,
                tick_cumulative,
                time: current_time,
                upper: false,
                max_liquidity: store.max_liquidity_per_tick,
                ticks_slot: TICKS_SLOT,
            )
            let flipped_upper = tick::update_at(
                tick: tick_upper,
                tick_current: store.tick as i256,
                liquidity_delta,
                fee_growth_global0_x128: store.fee_growth_global0_x128,
                fee_growth_global1_x128: store.fee_growth_global1_x128,
                seconds_per_liquidity_cumulative_x128,
                tick_cumulative,
                time: current_time,
                upper: true,
                max_liquidity: store.max_liquidity_per_tick,
                ticks_slot: TICKS_SLOT,
            )

            if flipped_lower {
                flip_tick_at(
                    tick: tick_lower,
                    tick_spacing: store.tick_spacing as i256,
                    bitmap_slot: TICK_BITMAP_SLOT,
                )
            }
            if flipped_upper {
                flip_tick_at(
                    tick: tick_upper,
                    tick_spacing: store.tick_spacing as i256,
                    bitmap_slot: TICK_BITMAP_SLOT,
                )
            }

            let (fee_growth_inside0_x128, fee_growth_inside1_x128) = tick::get_fee_growth_inside_at(
                tick_lower,
                tick_upper,
                tick_current: store.tick as i256,
                fee_growth_global0_x128: store.fee_growth_global0_x128,
                fee_growth_global1_x128: store.fee_growth_global1_x128,
                ticks_slot: TICKS_SLOT,
            )
            let position_slot = position::position_slot(
                owner: recipient,
                tick_lower,
                tick_upper,
                positions_slot: POSITIONS_SLOT,
            )
            position::update(
                base_slot: position_slot,
                liquidity_delta,
                fee_growth_inside0_x128,
                fee_growth_inside1_x128,
            )

            let amount0 = if (store.tick as i256) < tick_lower {
                get_amount0_delta(
                    sqrt_ratio_a_x96: get_sqrt_ratio_at_tick(tick: tick_lower),
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up: true,
                )
            } else if (store.tick as i256) < tick_upper {
                get_amount0_delta(
                    sqrt_ratio_a_x96: store.sqrt_price_x96,
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up: true,
                )
            } else {
                0
            }
            let amount1 = if (store.tick as i256) < tick_lower {
                0
            } else if (store.tick as i256) < tick_upper {
                get_amount1_delta(
                    sqrt_ratio_a_x96: get_sqrt_ratio_at_tick(tick: tick_lower),
                    sqrt_ratio_b_x96: store.sqrt_price_x96,
                    amount,
                    round_up: true,
                )
            } else {
                get_amount1_delta(
                    sqrt_ratio_a_x96: get_sqrt_ratio_at_tick(tick: tick_lower),
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up: true,
                )
            }

            if (store.tick as i256) >= tick_lower && (store.tick as i256) < tick_upper {
                store.observation0_block_timestamp = current_time
                store.observation0_tick_cumulative = tick_cumulative.downcast_unchecked()
                store
                    .observation0_seconds_per_liquidity_cumulative_x128 = seconds_per_liquidity_cumulative_x128
                store.liquidity = add_delta(store.liquidity, liquidity_delta)
            }

            let balance0_before = if amount0 > 0 {
                call.static(
                    addr: store.token0,
                    gas: evm.gas(),
                    message: Erc20MinimalMsg::BalanceOf { account: ctx.address() },
                )
            } else {
                0
            }
            let balance1_before = if amount1 > 0 {
                call.static(
                    addr: store.token1,
                    gas: evm.gas(),
                    message: Erc20MinimalMsg::BalanceOf { account: ctx.address() },
                )
            } else {
                0
            }

            call.call(
                addr: ctx.caller(),
                gas: evm.gas(),
                value: 0,
                message: MintCallbackMsg::UniswapV3MintCallback {
                    amount0Owed: amount0,
                    amount1Owed: amount1,
                    data,
                },
            )

            if amount0 > 0 {
                let balance0_after: u256 = call
                    .static(
                        addr: store.token0,
                        gas: evm.gas(),
                        message: Erc20MinimalMsg::BalanceOf { account: ctx.address() },
                    )
                assert_msg(balance0_before + amount0 <= balance0_after, "M0")
            }
            if amount1 > 0 {
                let balance1_after: u256 = call
                    .static(
                        addr: store.token1,
                        gas: evm.gas(),
                        message: Erc20MinimalMsg::BalanceOf { account: ctx.address() },
                    )
                assert_msg(balance1_before + amount1 <= balance1_after, "M1")
            }

            store.unlocked = true
            emit_mint(
                sender: ctx.caller(),
                owner: recipient,
                tick_lower: tickLower.val,
                tick_upper: tickUpper.val,
                amount,
                amount0,
                amount1,
            )
            (amount0, amount1)
        }
    }
}
