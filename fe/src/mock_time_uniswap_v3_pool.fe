    #[selector = 0x70cf754a]
    MaxLiquidityPerTick,

    #[selector = 0x3850c7bd]
    Slot0,

    #[selector = 0x252c09d7]
    Observations,

    #[selector = 0xf637731d]
    Initialize,

    #[selector = 0x32148f67]
    IncreaseObservationCardinalityNext,

    #[selector = 0x07e32f0a]
    AdvanceTime,

    #[selector = 0x16ada547]
    Time,

    #[selector = 0xd380c679]
    SetFeeGrowthGlobal0X128,

    #[selector = 0xf6eb760f]
    SetFeeGrowthGlobal1X128,

    #[selector = 0xf3058399]
    FeeGrowthGlobal0X128,

    #[selector = 0x46141319]
    FeeGrowthGlobal1X128,

    #[selector = 0x1a686502]
    Liquidity,

    #[selector = 0x1ad8b03b]
    ProtocolFees,

    #[selector = 0xa38807f2]
    SnapshotCumulativesInside,

    #[selector = 0x8206a4d1]
    SetFeeProtocol,

    #[selector = 0x85b66729]
    CollectProtocol,

    #[selector = 0x490e6cbc]
    Flash,

    #[selector = 0x128acb08]
