}

struct MockTimePoolStore {
    factory: Address,
    token0: Address,
    token1: Address,
    fee: u32,
    tick_spacing: i32,
    max_liquidity_per_tick: u128,
    sqrt_price_x96: u256,
    tick: i32,
    observation_index: u16,
    observation_cardinality: u16,
    observation_cardinality_next: u16,
    fee_protocol: u8,
    unlocked: bool,
    observation0_block_timestamp: u32,
    observation0_tick_cumulative: i64,
    observation0_seconds_per_liquidity_cumulative_x128: u256,
    time: u256,
    liquidity: u128,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    protocol_fee0: u128,
    protocol_fee1: u128,
}

fn int24_abi_word(_ value: i32) -> u256 {
    int_key(value as i256)
}

fn decode_int24_word(_ word: u256) -> i256 {
    let value = word & 0xffffff
    if (value & 0x800000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((0xffffff - value) + 1) & 0xffffff
    let magnitude_i: i256 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

fn require_msg(_ evm: mut Evm, condition: bool, code: u256, len: u256) {
    if !condition {
        evm.mstore(addr: 0, value: ERROR_STRING_SELECTOR_WORD)
        evm.mstore(addr: 4, value: 32)
        evm.mstore(addr: 36, value: len)
        evm.mstore(addr: 68, value: code)
        evm.revert(offset: 0, len: 100)
    }
}

fn check_ticks(_ evm: mut Evm, tick_lower: i256, tick_upper: i256) {
    require_msg(
        mut evm,
        condition: tick_lower < tick_upper,
        code: MSG_TLU,
        len: 3,
    )
    require_msg(
        mut evm,
        condition: tick_lower >= MIN_TICK,
        code: MSG_TLM,
        len: 3,
    )
    require_msg(
        mut evm,
        condition: tick_upper <= MAX_TICK,
        code: MSG_TUM,
        len: 3,
    )
}

fn check_unlocked(_ evm: mut Evm, _ unlocked: bool) {
    require_msg(mut evm, condition: unlocked, code: MSG_LOK, len: 3)
}

fn current_tick_cumulative(tick_cumulative: i64, tick_current: i32, time_delta: u32) -> i256 {
    (tick_cumulative as i256) + ((tick_current as i256) * (time_delta as i256))
}

fn current_seconds_per_liquidity(
    seconds_per_liquidity_cumulative_x128: u256,
    time_delta: u32,
    liquidity: u128,
) -> u256 {
    let denominator = if liquidity > 0 { liquidity as u256 } else { 1 }
    seconds_per_liquidity_cumulative_x128 + (((time_delta as u256) << 128) / denominator)
}

fn min_u128(_ a: u128, _ b: u128) -> u128 {
    if a < b { return a }
    b
}

fn decode_u128_word(_ word: u256) -> u128 {
    assert(word <= MAX_U128_WORD)
    word.downcast_unchecked()
}

fn decode_i128_word(_ word: u256) -> i128 {
    let value = word & MAX_U128_WORD
    if (value & 0x80000000000000000000000000000000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((MAX_U128_WORD - value) + 1) & MAX_U128_WORD
    let magnitude_i: i256 = magnitude.downcast_unchecked()
    (0 - magnitude_i).downcast_unchecked()
}

#[arithmetic(unchecked)]
fn add_u256(a: u256, b: u256) -> u256 {
    a + b
}

#[arithmetic(unchecked)]
fn sub_u256(a: u256, b: u256) -> u256 {
    a - b
}

#[arithmetic(unchecked)]
fn sub_i256(a: i256, b: i256) -> i256 {
    a - b
}

#[arithmetic(unchecked)]
fn sub_u32(a: u32, b: u32) -> u32 {
    a - b
}

fn balance_of(token: Address, account: Address) -> u256
uses (call: mut Call, evm: mut Evm)
{
    evm.mstore(addr: 0, value: (0x70a08231 as u256) << 224)
    evm.mstore(addr: 4, value: account.inner)
    assert(
        call.raw_call(
            addr: token,
            gas: 1000000,
            value: 0,
            args_offset: 0,
            args_len: 36,
        ),
    )
    evm.returndatacopy(dest: 0, offset: 0, len: 32)
    evm.mload(0)
}

fn factory_owner(factory: Address) -> u256 uses (call: mut Call, evm: mut Evm) {
    evm.mstore(addr: 0, value: (0x8da5cb5b as u256) << 224)
    assert(
        call.raw_call(
            addr: factory,
            gas: evm.gas(),
            value: 0,
            args_offset: 0,
            args_len: 4,
        ),
    )
    evm.returndatacopy(dest: 0, offset: 0, len: 32)
    evm.mload(0)
}

fn load_deployer_parameters(deployer: Address) -> (Address, Address, Address, u32, i32)
uses (call: mut Call, evm: mut Evm)
{
    evm.mstore(addr: 0, value: (0x89035730 as u256) << 224)
    assert(
        call.raw_call(
            addr: deployer,
            gas: evm.gas(),
            value: 0,
            args_offset: 0,
            args_len: 4,
        ),
    )
    evm.returndatacopy(dest: 0, offset: 0, len: 160)
    (
        Address { inner: evm.mload(0) },
        Address { inner: evm.mload(32) },
        Address { inner: evm.mload(64) },
        evm.mload(96).downcast_unchecked(),
        decode_int24_word(evm.mload(128)).downcast_unchecked(),
    )
}

fn transfer_scratch(token: Address, to: Address, value: u256)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: (0xa9059cbb as u256) << 224)
    evm.mstore(addr: 4, value: to.inner)
    evm.mstore(addr: 36, value)

    let success = evm.raw_call(
            addr: token,
            gas: evm.gas(),
            value: 0,
            args_offset: 0,
            args_len: 68,
        )
    let ret_len = evm.returndatasize()
    assert(success)
    if ret_len >= 32 {
        evm.returndatacopy(dest: 0, offset: 0, len: 32)
        assert(evm.mload(0) != 0)
    } else {
        assert(ret_len == 0)
    }
}

fn call_modify_position(
    pool: Address,
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    liquidity_delta: i128,
) -> (u256, u256)
uses (call: mut Call, evm: mut Evm)
{
    let ptr = 256
    evm.mstore(addr: ptr, value: (0x8f6f4f01 as u256) << 224)
    evm.mstore(addr: ptr + 4, value: owner.inner)
    evm.mstore(addr: ptr + 36, value: int24_abi_word(tick_lower))
    evm.mstore(addr: ptr + 68, value: int24_abi_word(tick_upper))
    evm.mstore(addr: ptr + 100, value: int_key(liquidity_delta as i256))
    assert(
        call.raw_call(
            addr: pool,
            gas: evm.gas(),
            value: 0,
            args_offset: ptr,
            args_len: 132,
        ),
    )
    evm.returndatacopy(dest: ptr, offset: 0, len: 64)
    (evm.mload(ptr), evm.mload(ptr + 32))
}

fn mint_callback_calldata(caller: Address, amount0: u256, amount1: u256, data_start: u256)
uses (call: mut Call, evm: mut Evm)
{
    let data_len = evm.calldataload(data_start)
    let data_size = 32 + (((data_len + 31) / 32) * 32)
    let len = 100 + data_size
    let ptr = 512
    evm.mstore(addr: ptr, value: (0xd3487997 as u256) << 224)
    evm.mstore(addr: ptr + 4, value: amount0)
    evm.mstore(addr: ptr + 36, value: amount1)
    evm.mstore(addr: ptr + 68, value: 96)
    evm.calldatacopy(dest: ptr + 100, offset: data_start, len: data_size)
    assert(
        call.raw_call(
            addr: caller,
            gas: 1000000,
            value: 0,
            args_offset: ptr,
            args_len: len,
        ),
    )
}

fn flash_callback(caller: Address, fee0: u256, fee1: u256, data_start: u256)
uses (call: mut Call, evm: mut Evm)
{
    evm.mstore(addr: 0, value: FLASH_CALLBACK_SELECTOR << 224)
    evm.mstore(addr: 4, value: fee0)
    evm.mstore(addr: 36, value: fee1)
    evm.mstore(addr: 68, value: 96)
    evm.mstore(addr: 100, value: 96)
    evm.calldatacopy(dest: 132, offset: data_start + 32, len: 96)
    assert(
        call.raw_call(
            addr: caller,
            gas: 1000000,
            value: 0,
            args_offset: 0,
            args_len: 228,
        ),
    )
}

fn emit_initialize(sqrt_price_x96: u256, tick: i32) uses (evm: mut Evm) {
    evm.mstore(addr: 0, value: sqrt_price_x96)
    evm.mstore(addr: 32, value: int24_abi_word(tick))
    evm.log1(offset: 0, len: 64, topic0: INITIALIZE_TOPIC)
}

fn emit_increase_observation_cardinality_next(old: u16, new: u16)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: old as u256)
    evm.mstore(addr: 32, value: new as u256)
    evm.log1(
        offset: 0,
        len: 64,
        topic0: INCREASE_OBSERVATION_CARDINALITY_NEXT_TOPIC,
    )
}

fn emit_mint(
    sender: Address,
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: sender.inner)
    evm.mstore(addr: 32, value: amount as u256)
    evm.mstore(addr: 64, value: amount0)
    evm.mstore(addr: 96, value: amount1)
    evm.log4(
        offset: 0,
        len: 128,
        topic0: MINT_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

fn emit_burn(
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: amount as u256)
    evm.mstore(addr: 32, value: amount0)
    evm.mstore(addr: 64, value: amount1)
    evm.log4(
        offset: 0,
        len: 96,
        topic0: BURN_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

fn emit_flash(
    sender: Address,
    recipient: Address,
    amount0: u256,
    amount1: u256,
    paid0: u256,
    paid1: u256,
)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: amount0)
    evm.mstore(addr: 32, value: amount1)
    evm.mstore(addr: 64, value: paid0)
    evm.mstore(addr: 96, value: paid1)
    evm.log3(
        offset: 0,
        len: 128,
        topic0: FLASH_TOPIC,
        topic1: sender.inner,
        topic2: recipient.inner,
    )
}

fn return_snapshot(
    tick_cumulative_inside: i256,
    seconds_per_liquidity_inside_x128: u256,
    seconds_inside: u32,
) -> !
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: int_key(tick_cumulative_inside))
    evm.mstore(addr: 32, value: seconds_per_liquidity_inside_x128)
    evm.mstore(addr: 64, value: seconds_inside as u256)
    evm.return_data(offset: 0, len: 96)
}

fn return_pair(amount0: u256, amount1: u256) -> ! uses (evm: mut Evm) {
    evm.mstore(addr: 0, value: amount0)
    evm.mstore(addr: 32, value: amount1)
    evm.return_data(offset: 0, len: 64)
}

fn return_word(value: u256) -> ! uses (evm: mut Evm) {
    evm.mstore(addr: 0, value)
    evm.return_data(offset: 0, len: 32)
}

fn return_slot0(
    sqrt_price_x96: u256,
    tick: i32,
    observation_index: u16,
    observation_cardinality: u16,
    observation_cardinality_next: u16,
    fee_protocol: u8,
    unlocked: bool,
) -> !
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: sqrt_price_x96)
    evm.mstore(addr: 32, value: int_key(tick as i256))
    evm.mstore(addr: 64, value: observation_index as u256)
    evm.mstore(addr: 96, value: observation_cardinality as u256)
    evm.mstore(addr: 128, value: observation_cardinality_next as u256)
    evm.mstore(addr: 160, value: fee_protocol as u256)
    evm.mstore(addr: 192, value: if unlocked { 1 } else { 0 })
    evm.return_data(offset: 0, len: 224)
}

fn return_observation(
    block_timestamp: u32,
    tick_cumulative: i64,
    seconds_per_liquidity_cumulative_x128: u256,
    initialized: bool,
) -> !
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: block_timestamp as u256)
    evm.mstore(addr: 32, value: int_key(tick_cumulative as i256))
    evm.mstore(addr: 64, value: seconds_per_liquidity_cumulative_x128)
    evm.mstore(addr: 96, value: if initialized { 1 } else { 0 })
    evm.return_data(offset: 0, len: 128)
}

fn return_tick_info(
    liquidity_gross: u128,
    liquidity_net: i128,
    fee_growth_outside0_x128: u256,
    fee_growth_outside1_x128: u256,
    tick_cumulative_outside: i256,
    seconds_per_liquidity_outside_x128: u256,
    seconds_outside: u32,
    initialized: bool,
) -> !
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: liquidity_gross as u256)
    evm.mstore(addr: 32, value: int_key(liquidity_net as i256))
    evm.mstore(addr: 64, value: fee_growth_outside0_x128)
    evm.mstore(addr: 96, value: fee_growth_outside1_x128)
    evm.mstore(addr: 128, value: int_key(tick_cumulative_outside))
    evm.mstore(addr: 160, value: seconds_per_liquidity_outside_x128)
    evm.mstore(addr: 192, value: seconds_outside as u256)
    evm.mstore(addr: 224, value: if initialized { 1 } else { 0 })
    evm.return_data(offset: 0, len: 256)
}

fn return_position_info(
    liquidity_value: u128,
    fee_growth_inside0_last_x128: u256,
    fee_growth_inside1_last_x128: u256,
    tokens_owed0: u128,
    tokens_owed1: u128,
) -> !
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: liquidity_value as u256)
    evm.mstore(addr: 32, value: fee_growth_inside0_last_x128)
    evm.mstore(addr: 64, value: fee_growth_inside1_last_x128)
    evm.mstore(addr: 96, value: tokens_owed0 as u256)
    evm.mstore(addr: 128, value: tokens_owed1 as u256)
    evm.return_data(offset: 0, len: 160)
}

pub contract MockTimeUniswapV3Pool uses (ctx: Ctx, call: mut Call, evm: mut Evm) {
    mut store: MockTimePoolStore,

    init()
    uses (ctx, mut call, mut evm, mut store)
    {
        let (factory, token0, token1, fee, tick_spacing) = load_deployer_parameters(
            deployer: ctx.caller(),
        )
        store.factory = factory
        store.token0 = token0
        store.token1 = token1
        store.fee = fee
        store.tick_spacing = tick_spacing
        store.max_liquidity_per_tick = tick_spacing_to_max_liquidity_per_tick(tick_spacing as i256)
        store.time = TEST_POOL_START_TIME
    }

    recv MockTimeUniswapV3PoolMsg {
        Factory uses (store, mut evm) {
            return_word(value: store.factory.inner)
        }

        Token0 uses (store, mut evm) {
            return_word(value: store.token0.inner)
        }

        Token1 uses (store, mut evm) {
            return_word(value: store.token1.inner)
        }

        Fee uses (store, mut evm) {
            return_word(value: store.fee as u256)
        }

        TickSpacing uses (store, mut evm) {
            return_word(value: int_key(store.tick_spacing as i256))
        }

        MaxLiquidityPerTick uses (store, mut evm) {
            return_word(value: store.max_liquidity_per_tick as u256)
        }

        Slot0 uses (store, mut evm) {
            return_slot0(
                sqrt_price_x96: store.sqrt_price_x96,
                tick: store.tick,
                observation_index: store.observation_index,
                observation_cardinality: store.observation_cardinality,
                observation_cardinality_next: store.observation_cardinality_next,
                fee_protocol: store.fee_protocol,
                unlocked: store.unlocked,
            )
        }

        Observations uses (store, mut evm) {
            if evm.calldataload(4) == 0 {
                return_observation(
                    block_timestamp: store.observation0_block_timestamp,
                    tick_cumulative: store.observation0_tick_cumulative,
                    seconds_per_liquidity_cumulative_x128: store
                        .observation0_seconds_per_liquidity_cumulative_x128,
                    initialized: true,
                )
            }
            return_observation(
                block_timestamp: 0,
                tick_cumulative: 0,
                seconds_per_liquidity_cumulative_x128: 0,
                initialized: false,
            )
        }

        Initialize uses (mut store, mut evm) {
            let sqrt_price_x96 = evm.calldataload(4)
            assert(store.sqrt_price_x96 == 0)
            require_msg(
                mut evm,
                condition: sqrt_price_x96 >= min_sqrt_ratio() && sqrt_price_x96 < max_sqrt_ratio(),
                code: MSG_R,
                len: 1,
            )
            let tick: i32 = get_tick_at_sqrt_ratio(sqrt_price_x96).downcast_unchecked()
            store.sqrt_price_x96 = sqrt_price_x96
            store.tick = tick
            store.observation_index = 0
            store.observation_cardinality = 1
            store.observation_cardinality_next = 1
            store.unlocked = true
            store.observation0_block_timestamp = store.time.downcast_unchecked()
            store.observation0_tick_cumulative = 0
            store.observation0_seconds_per_liquidity_cumulative_x128 = 0
            emit_initialize(sqrt_price_x96, tick)
        }

        IncreaseObservationCardinalityNext uses (mut store, mut evm) {
            let word = evm.calldataload(4)
            assert(word <= 0xffff)
            let observation_cardinality_next: u16 = word.downcast_unchecked()
            check_unlocked(mut evm, store.unlocked)
            store.unlocked = false
            let old = store.observation_cardinality_next
            let new = if observation_cardinality_next > old {
                observation_cardinality_next
            } else {
                old
            }
            store.observation_cardinality_next = new
            if old != new {
                emit_increase_observation_cardinality_next(old, new)
            }
            store.unlocked = true
        }

        AdvanceTime uses (mut store, mut evm) {
            store.time += evm.calldataload(4)
        }

        Time uses (store, mut evm) {
            return_word(value: store.time)
        }

        SetFeeGrowthGlobal0X128 uses (mut store, mut evm) {
            store.fee_growth_global0_x128 = evm.calldataload(4)
        }

        SetFeeGrowthGlobal1X128 uses (mut store, mut evm) {
            store.fee_growth_global1_x128 = evm.calldataload(4)
        }

        FeeGrowthGlobal0X128 uses (store, mut evm) {
            return_word(value: store.fee_growth_global0_x128)
        }

        FeeGrowthGlobal1X128 uses (store, mut evm) {
            return_word(value: store.fee_growth_global1_x128)
        }

        Liquidity uses (store, mut evm) {
            return_word(value: store.liquidity as u256)
        }

        ProtocolFees uses (store, mut evm) {
            return_pair(
                amount0: store.protocol_fee0 as u256,
                amount1: store.protocol_fee1 as u256,
            )
        }

        SnapshotCumulativesInside uses (mut evm, store) {
            let lower = decode_int24_word(evm.calldataload(4))
            let upper = decode_int24_word(evm.calldataload(36))
            check_ticks(mut evm, tick_lower: lower, tick_upper: upper)

            let (
                _,
                _,
                _,
                _,
                tick_cumulative_lower,
                seconds_per_liquidity_outside_lower,
                seconds_outside_lower,
                initialized_lower,
            ) = tick::read_tick_at(lower, ticks_slot: TICKS_SLOT)
            assert(initialized_lower)
            let (
                _,
                _,
                _,
                _,
                tick_cumulative_upper,
                seconds_per_liquidity_outside_upper,
                seconds_outside_upper,
                initialized_upper,
            ) = tick::read_tick_at(upper, ticks_slot: TICKS_SLOT)
            assert(initialized_upper)

            let tick_current = store.tick as i256
            let mut tick_cumulative_inside = 0
            let mut seconds_per_liquidity_inside_x128 = 0
            let mut seconds_inside: u32 = 0
            if tick_current < lower {
                tick_cumulative_inside = sub_i256(
                    a: tick_cumulative_lower,
                    b: tick_cumulative_upper,
                )
                seconds_per_liquidity_inside_x128 = sub_u256(
                    a: seconds_per_liquidity_outside_lower,
                    b: seconds_per_liquidity_outside_upper,
                )
                seconds_inside = sub_u32(a: seconds_outside_lower, b: seconds_outside_upper)
            } else if tick_current < upper {
                let current_time: u32 = store.time.downcast_unchecked()
                let time_delta = current_time - store.observation0_block_timestamp
                let tick_cumulative = current_tick_cumulative(
                    tick_cumulative: store.observation0_tick_cumulative,
                    tick_current: store.tick,
                    time_delta,
                )
                let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                    seconds_per_liquidity_cumulative_x128: store
                        .observation0_seconds_per_liquidity_cumulative_x128,
                    time_delta,
                    liquidity: store.liquidity,
                )
                let seconds_per_liquidity_inside_minus_lower = sub_u256(
                    a: seconds_per_liquidity_cumulative_x128,
                    b: seconds_per_liquidity_outside_lower,
                )
                seconds_per_liquidity_inside_x128 = sub_u256(
                    a: seconds_per_liquidity_inside_minus_lower,
                    b: seconds_per_liquidity_outside_upper,
                )
                seconds_inside = sub_u32(
                    a: sub_u32(a: current_time, b: seconds_outside_lower),
                    b: seconds_outside_upper,
                )
                let tick_cumulative_inside_minus_lower = sub_i256(
                    a: tick_cumulative,
                    b: tick_cumulative_lower,
                )
                tick_cumulative_inside = sub_i256(
                    a: tick_cumulative_inside_minus_lower,
                    b: tick_cumulative_upper,
                )
            } else {
                tick_cumulative_inside = sub_i256(
                    a: tick_cumulative_upper,
                    b: tick_cumulative_lower,
                )
                seconds_per_liquidity_inside_x128 = sub_u256(
                    a: seconds_per_liquidity_outside_upper,
                    b: seconds_per_liquidity_outside_lower,
                )
                seconds_inside = sub_u32(a: seconds_outside_upper, b: seconds_outside_lower)
            }
            return_snapshot(
                tick_cumulative_inside,
                seconds_per_liquidity_inside_x128,
                seconds_inside,
            )
        }

        SetFeeProtocol uses (ctx, mut call, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            store.unlocked = false
            assert(evm.calldatasize() >= 68)
            let fee0_word = evm.calldataload(4)
            let fee1_word = evm.calldataload(36)
            assert(fee0_word <= 255)
            assert(fee1_word <= 255)
            let feeProtocol0: u8 = fee0_word.downcast_unchecked()
            let feeProtocol1: u8 = fee1_word.downcast_unchecked()
            assert(
                ctx.caller().inner == factory_owner(factory: store.factory),
            )
            let fee_mask = ((1 as u256) << (feeProtocol0 as u256))
                | ((1 as u256) << (feeProtocol1 as u256))
            assert((fee_mask & 0x7f1) == fee_mask)

            let old = store.fee_protocol
            store.fee_protocol = ((feeProtocol0 as u256) | ((feeProtocol1 as u256) << 4))
                .downcast_unchecked()
            evm.mstore(addr: 0, value: (old & 0x0f) as u256)
            evm.mstore(addr: 32, value: (old >> 4) as u256)
            evm.mstore(addr: 64, value: feeProtocol0 as u256)
            evm.mstore(addr: 96, value: feeProtocol1 as u256)
            evm.log1(offset: 0, len: 128, topic0: SET_FEE_PROTOCOL_TOPIC)
            store.unlocked = true
        }

        CollectProtocol uses (ctx, mut call, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            store.unlocked = false
            assert(
                ctx.caller().inner == factory_owner(factory: store.factory),
            )

            let recipient = Address { inner: evm.calldataload(4) }
            let amount0_requested = decode_u128_word(evm.calldataload(36))
            let amount1_requested = decode_u128_word(evm.calldataload(68))
            let mut amount0 = min_u128(a: amount0_requested, b: store.protocol_fee0)
            let mut amount1 = min_u128(a: amount1_requested, b: store.protocol_fee1)

            if amount0 > 0 {
                if amount0 == store.protocol_fee0 {
                    amount0 -= 1
                }
                store.protocol_fee0 -= amount0
                transfer_scratch(token: store.token0, to: recipient, value: amount0 as u256)
            }
            if amount1 > 0 {
                if amount1 == store.protocol_fee1 {
                    amount1 -= 1
                }
                store.protocol_fee1 -= amount1
                transfer_scratch(token: store.token1, to: recipient, value: amount1 as u256)
            }

            evm.mstore(addr: 0, value: amount0 as u256)
            evm.mstore(addr: 32, value: amount1 as u256)
            evm.log3(
                offset: 0,
                len: 64,
                topic0: COLLECT_PROTOCOL_TOPIC,
                topic1: ctx.caller().inner,
                topic2: recipient.inner,
            )
            store.unlocked = true
            return_pair(amount0: amount0 as u256, amount1: amount1 as u256)
        }

        Flash uses (ctx, mut call, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            require_msg(
                mut evm,
                condition: store.liquidity != 0,
                code: MSG_L,
                len: 1,
            )
            let recipient = Address { inner: evm.calldataload(4) }
            let amount0 = evm.calldataload(36)
            let amount1 = evm.calldataload(68)
            let data_offset = evm.calldataload(100)
            let data_start = 4 + data_offset
            let fee0 = ((amount0 * (store.fee as u256)) + 999999) / 1000000
            let fee1 = ((amount1 * (store.fee as u256)) + 999999) / 1000000
            let balance0_before = balance_of(token: store.token0, account: ctx.address())
            let balance1_before = balance_of(token: store.token1, account: ctx.address())
            if amount0 > 0 {
                transfer_scratch(token: store.token0, to: recipient, value: amount0)
            }
            if amount1 > 0 {
                transfer_scratch(token: store.token1, to: recipient, value: amount1)
            }
            flash_callback(caller: ctx.caller(), fee0, fee1, data_start)
            let balance0_after = balance_of(token: store.token0, account: ctx.address())
            let balance1_after = balance_of(token: store.token1, account: ctx.address())
            assert(balance0_before + fee0 <= balance0_after)
            assert(balance1_before + fee1 <= balance1_after)
            let paid0 = sub_u256(a: balance0_after, b: balance0_before)
            let paid1 = sub_u256(a: balance1_after, b: balance1_before)
            if paid0 > 0 {
                let feeProtocol0 = store.fee_protocol & 0x0f
                let fees0 = if feeProtocol0 == 0 {
                    0
                } else {
                    paid0 / (feeProtocol0 as u256)
                }
                store.protocol_fee0 += fees0.downcast_unchecked()
                store.fee_growth_global0_x128 = add_u256(
                    a: store.fee_growth_global0_x128,
                    b: mul_div(paid0 - fees0, Q128, denominator: store.liquidity as u256),
                )
            }
            if paid1 > 0 {
                let feeProtocol1 = store.fee_protocol >> 4
                let fees1 = if feeProtocol1 == 0 {
                    0
                } else {
                    paid1 / (feeProtocol1 as u256)
                }
                store.protocol_fee1 += fees1.downcast_unchecked()
                store.fee_growth_global1_x128 = add_u256(
                    a: store.fee_growth_global1_x128,
                    b: mul_div(paid1 - fees1, Q128, denominator: store.liquidity as u256),
                )
            }
            emit_flash(
                sender: ctx.caller(),
                recipient,
                amount0,
                amount1,
                paid0,
                paid1,
            )
        }

        Swap uses (ctx, mut call, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            let zero_for_one = evm.calldataload(36) != 0
            let amount_specified = evm.calldataload(68)
            let data_offset = evm.calldataload(132)
            let data_start = 4 + data_offset
            let data_len = evm.calldataload(data_start)
            require_msg(
                mut evm,
                condition: amount_specified != 0,
                code: MSG_AS,
                len: 2,
            )
            if data_len == 0 {
                store.unlocked = false
                evm.mstore(addr: 0, value: SWAP_CALLBACK_SELECTOR << 224)
                evm.mstore(addr: 4, value: 0)
                evm.mstore(addr: 36, value: 0)
                evm.mstore(addr: 68, value: 96)
                evm.mstore(addr: 100, value: 0)
                evm.raw_call(
                    addr: ctx.caller(),
                    gas: 1000000,
                    value: 0,
                    args_offset: 0,
                    args_len: 132,
                )
                let ret_len = evm.returndatasize()
                evm.returndatacopy(dest: 0, offset: 0, len: ret_len)
                evm.revert(offset: 0, len: ret_len)
            }
            if data_len == 32 {
                store.unlocked = false
                let input_token = if zero_for_one {
                    store.token0
                } else {
                    store.token1
                }
                let balance_before = balance_of(token: input_token, account: ctx.address())
                let ptr = 512
                evm.mstore(addr: ptr, value: SWAP_CALLBACK_SELECTOR << 224)
                evm.mstore(
                    addr: ptr + 4,
                    value: if zero_for_one { amount_specified } else { 0 },
                )
                evm.mstore(
                    addr: ptr + 36,
                    value: if zero_for_one { 0 } else { amount_specified },
                )
                evm.mstore(addr: ptr + 68, value: 96)
                evm.mstore(addr: ptr + 100, value: 32)
                evm.calldatacopy(dest: ptr + 132, offset: data_start + 32, len: 32)
                assert(
                    call.raw_call(
                        addr: ctx.caller(),
                        gas: 1000000,
                        value: 0,
                        args_offset: ptr,
                        args_len: 164,
                    ),
                )
                let balance_after = balance_of(token: input_token, account: ctx.address())
                require_msg(
                    mut evm,
                    condition: balance_before + amount_specified <= balance_after,
                    code: MSG_IIA,
                    len: 3,
                )

                let fee_amount = mul_div(amount_specified, store.fee as u256, denominator: 1000000)
                let fee_protocol = if zero_for_one {
                    store.fee_protocol & 0x0f
                } else {
                    store.fee_protocol >> 4
                }
                let protocol_fees = if fee_protocol == 0 {
                    0
                } else {
                    fee_amount / (fee_protocol as u256)
                }
                if zero_for_one {
                    store.protocol_fee0 += protocol_fees.downcast_unchecked()
                    store.fee_growth_global0_x128 = add_u256(
                        a: store.fee_growth_global0_x128,
                        b: mul_div(
                            fee_amount - protocol_fees,
                            Q128,
                            denominator: store.liquidity as u256,
                        ),
                    )
                    store.unlocked = true
                    return_pair(amount0: amount_specified, amount1: 0)
                }

                store.protocol_fee1 += protocol_fees.downcast_unchecked()
                store.fee_growth_global1_x128 = add_u256(
                    a: store.fee_growth_global1_x128,
                    b: mul_div(
                        fee_amount - protocol_fees,
                        Q128,
                        denominator: store.liquidity as u256,
                    ),
                )
                store.unlocked = true
                return_pair(amount0: 0, amount1: amount_specified)
            }
            let pay0 = evm.calldataload(data_start + 64)
            let pay1 = evm.calldataload(data_start + 96)
            if zero_for_one {
                require_msg(mut evm, condition: pay0 >= 1000, code: MSG_IIA, len: 3)
            } else {
                require_msg(mut evm, condition: pay1 >= 1000, code: MSG_IIA, len: 3)
            }
        }

        Observe uses (mut evm, store) {
            let current_time: u32 = store.time.downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = (store.observation0_tick_cumulative as i256)
                + ((store.tick as i256) * (time_delta as i256))
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: store
                    .observation0_seconds_per_liquidity_cumulative_x128,
                time_delta,
                liquidity: store.liquidity,
            )
            evm.mstore(addr: 0, value: 64)
            evm.mstore(addr: 32, value: 128)
            evm.mstore(addr: 64, value: 1)
            evm.mstore(addr: 96, value: int_key(tick_cumulative))
            evm.mstore(addr: 128, value: 1)
            evm.mstore(addr: 160, value: seconds_per_liquidity_cumulative_x128)
            evm.return_data(offset: 0, len: 192)
        }

        Ticks uses (mut evm) {
            let tick = decode_int24_word(evm.calldataload(4))
            let (
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside,
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            ) = tick::read_tick_at(tick, ticks_slot: TICKS_SLOT)
            return_tick_info(
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside,
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            )
        }

        Positions uses (mut evm) {
            let (
                liquidity_value,
                fee_growth_inside0_last_x128,
                fee_growth_inside1_last_x128,
                tokens_owed0,
                tokens_owed1,
            ) = position::read_position(
                position::mapping_slot(key: evm.calldataload(4), positions_slot: POSITIONS_SLOT),
            )
            return_position_info(
                liquidity_value,
                fee_growth_inside0_last_x128,
                fee_growth_inside1_last_x128,
                tokens_owed0,
                tokens_owed1,
            )
        }

        ModifyPosition uses (ctx, mut evm, mut store) {
            assert(ctx.caller().inner == ctx.address().inner)
            let owner = Address { inner: evm.calldataload(4) }
            let tick_lower = decode_int24_word(evm.calldataload(36))
            let tick_upper = decode_int24_word(evm.calldataload(68))
            let liquidity_delta = decode_i128_word(evm.calldataload(100))
            check_ticks(mut evm, tick_lower, tick_upper: tick_upper)

            let current_time: u32 = store.time.downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = current_tick_cumulative(
                tick_cumulative: store.observation0_tick_cumulative,
                tick_current: store.tick,
                time_delta,
            )
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: store
                    .observation0_seconds_per_liquidity_cumulative_x128,
                time_delta,
                liquidity: store.liquidity,
            )
            let tick_current_i = store.tick as i256

            let mut flipped_lower = false
            let mut flipped_upper = false
            if liquidity_delta != 0 {
                flipped_lower = tick::update_at(
                    tick: tick_lower,
                    tick_current: tick_current_i,
                    liquidity_delta,
                    fee_growth_global0_x128: store.fee_growth_global0_x128,
                    fee_growth_global1_x128: store.fee_growth_global1_x128,
                    seconds_per_liquidity_cumulative_x128,
                    tick_cumulative,
                    time: current_time,
                    upper: false,
                    max_liquidity: store.max_liquidity_per_tick,
                    ticks_slot: TICKS_SLOT,
                )
                flipped_upper = tick::update_at(
                    tick: tick_upper,
                    tick_current: tick_current_i,
                    liquidity_delta,
                    fee_growth_global0_x128: store.fee_growth_global0_x128,
                    fee_growth_global1_x128: store.fee_growth_global1_x128,
                    seconds_per_liquidity_cumulative_x128,
                    tick_cumulative,
                    time: current_time,
                    upper: true,
                    max_liquidity: store.max_liquidity_per_tick,
                    ticks_slot: TICKS_SLOT,
                )

                if flipped_lower {
                    flip_tick_at(
                        tick: tick_lower,
                        tick_spacing: store.tick_spacing as i256,
                        bitmap_slot: TICK_BITMAP_SLOT,
                    )
                }
                if flipped_upper {
                    flip_tick_at(
                        tick: tick_upper,
                        tick_spacing: store.tick_spacing as i256,
                        bitmap_slot: TICK_BITMAP_SLOT,
                    )
                }
            }

            let (fee_growth_inside0_x128, fee_growth_inside1_x128) = tick::get_fee_growth_inside_at(
                tick_lower,
                tick_upper,
                tick_current: tick_current_i,
                fee_growth_global0_x128: store.fee_growth_global0_x128,
                fee_growth_global1_x128: store.fee_growth_global1_x128,
                ticks_slot: TICKS_SLOT,
            )
            let position_slot = position::position_slot(
                owner,
                tick_lower,
                tick_upper,
                positions_slot: POSITIONS_SLOT,
            )
            position::update(
                base_slot: position_slot,
                liquidity_delta,
                fee_growth_inside0_x128,
                fee_growth_inside1_x128,
            )
            if liquidity_delta < 0 {
                if flipped_lower {
                    tick::clear_at(tick: tick_lower, ticks_slot: TICKS_SLOT)
                }
                if flipped_upper {
                    tick::clear_at(tick: tick_upper, ticks_slot: TICKS_SLOT)
                }
            }

            let amount: u128 = if liquidity_delta < 0 {
                (0 - (liquidity_delta as i256)).downcast_unchecked()
            } else {
                liquidity_delta.downcast_unchecked()
            }
            let round_up = liquidity_delta > 0
            let sqrt_ratio_lower_x96 = get_sqrt_ratio_at_tick(tick: tick_lower)
            let sqrt_ratio_upper_x96 = get_sqrt_ratio_at_tick(tick: tick_upper)
            let amount0 = if tick_current_i < tick_lower {
                get_amount0_delta(
                    sqrt_ratio_a_x96: sqrt_ratio_lower_x96,
                    sqrt_ratio_b_x96: sqrt_ratio_upper_x96,
                    amount,
                    round_up,
                )
            } else if tick_current_i < tick_upper {
                get_amount0_delta(
                    sqrt_ratio_a_x96: store.sqrt_price_x96,
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up,
                )
            } else {
                0
            }
            let amount1 = if tick_current_i < tick_lower {
                0
            } else if tick_current_i < tick_upper {
                get_amount1_delta(
                    sqrt_ratio_a_x96: sqrt_ratio_lower_x96,
                    sqrt_ratio_b_x96: store.sqrt_price_x96,
                    amount,
                    round_up,
                )
            } else {
                get_amount1_delta(
                    sqrt_ratio_a_x96: sqrt_ratio_lower_x96,
                    sqrt_ratio_b_x96: sqrt_ratio_upper_x96,
                    amount,
                    round_up,
                )
            }

            if tick_current_i >= tick_lower && tick_current_i < tick_upper {
                store.observation0_block_timestamp = current_time
                store.observation0_tick_cumulative = tick_cumulative.downcast_unchecked()
                store
                    .observation0_seconds_per_liquidity_cumulative_x128 = seconds_per_liquidity_cumulative_x128
                store.liquidity = add_delta(store.liquidity, liquidity_delta)
            }

            if liquidity_delta < 0 && (amount0 > 0 || amount1 > 0) {
                let (
                    liquidity_value,
                    fee_growth_inside0_last_x128,
                    fee_growth_inside1_last_x128,
                    tokens_owed0,
                    tokens_owed1,
                ) = position::read_position(position_slot)
                position::set_position(
                    base_slot: position_slot,
                    liquidity_value,
                    fee_growth_inside0_last_x128,
                    fee_growth_inside1_last_x128,
                    tokens_owed0_value: tokens_owed0 + amount0.downcast_unchecked(),
                    tokens_owed1_value: tokens_owed1 + amount1.downcast_unchecked(),
                )
            }

            return_pair(amount0, amount1)
        }

        Mint uses (ctx, mut call, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            store.unlocked = false

            let recipient = Address { inner: evm.calldataload(4) }
            let tick_lower = decode_int24_word(evm.calldataload(36)).downcast_unchecked()
            let tick_upper = decode_int24_word(evm.calldataload(68)).downcast_unchecked()
            let amount = decode_u128_word(evm.calldataload(100))
            let data_start = 4 + evm.calldataload(132)
            assert(amount > 0)
            let liquidity_delta = to_int128(amount as i256)
            let (amount0, amount1) = call_modify_position(
                pool: ctx.address(),
                owner: recipient,
                tick_lower,
                tick_upper,
                liquidity_delta,
            )

            let balance0_before = if amount0 > 0 {
                balance_of(token: store.token0, account: ctx.address())
            } else {
                0
            }
            let balance1_before = if amount1 > 0 {
                balance_of(token: store.token1, account: ctx.address())
            } else {
                0
            }

            mint_callback_calldata(caller: ctx.caller(), amount0, amount1, data_start)

            if amount0 > 0 {
                let balance0_after: u256 = balance_of(token: store.token0, account: ctx.address())
                require_msg(
                    mut evm,
                    condition: balance0_before + amount0 <= balance0_after,
                    code: MSG_M0,
                    len: 2,
                )
            }
            if amount1 > 0 {
                let balance1_after: u256 = balance_of(token: store.token1, account: ctx.address())
                require_msg(
                    mut evm,
                    condition: balance1_before + amount1 <= balance1_after,
                    code: MSG_M1,
                    len: 2,
                )
            }

            store.unlocked = true
            emit_mint(
                sender: ctx.caller(),
                owner: recipient,
                tick_lower,
                tick_upper,
                amount,
                amount0,
                amount1,
            )
            return_pair(amount0, amount1)
        }

        Burn uses (ctx, mut call, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            store.unlocked = false

            let tick_lower = decode_int24_word(evm.calldataload(4)).downcast_unchecked()
            let tick_upper = decode_int24_word(evm.calldataload(36)).downcast_unchecked()
            let amount = decode_u128_word(evm.calldataload(68))
            let liquidity_delta = 0 - to_int128(amount as i256)
            let (amount0, amount1) = call_modify_position(
                pool: ctx.address(),
                owner: ctx.caller(),
                tick_lower,
                tick_upper,
                liquidity_delta,
            )

            store.unlocked = true
            emit_burn(
                owner: ctx.caller(),
                tick_lower,
                tick_upper,
                amount,
                amount0,
                amount1,
            )
            return_pair(amount0, amount1)
        }

        Collect uses (ctx, mut evm, mut store) {
            check_unlocked(mut evm, store.unlocked)
            store.unlocked = false

            let recipient = Address { inner: evm.calldataload(4) }
            let tick_lower = decode_int24_word(evm.calldataload(36))
            let tick_upper = decode_int24_word(evm.calldataload(68))
            let amount0_requested = decode_u128_word(evm.calldataload(100))
            let amount1_requested = decode_u128_word(evm.calldataload(132))
            let position_slot = position::position_slot(
                owner: ctx.caller(),
                tick_lower,
                tick_upper,
                positions_slot: POSITIONS_SLOT,
            )
            let (
                liquidity_value,
                fee_growth_inside0_last_x128,
                fee_growth_inside1_last_x128,
                tokens_owed0,
                tokens_owed1,
            ) = position::read_position(position_slot)
            let amount0 = min_u128(a: amount0_requested, b: tokens_owed0)
            let amount1 = min_u128(a: amount1_requested, b: tokens_owed1)

            if amount0 > 0 || amount1 > 0 {
                position::set_position(
                    base_slot: position_slot,
                    liquidity_value,
                    fee_growth_inside0_last_x128,
                    fee_growth_inside1_last_x128,
                    tokens_owed0_value: tokens_owed0 - amount0,
                    tokens_owed1_value: tokens_owed1 - amount1,
                )
            }
            if amount0 > 0 {
                transfer_scratch(token: store.token0, to: recipient, value: amount0 as u256)
            }
            if amount1 > 0 {
                transfer_scratch(token: store.token1, to: recipient, value: amount1 as u256)
            }
            store.unlocked = true
            evm.mstore(addr: 0, value: recipient.inner)
            evm.mstore(addr: 32, value: amount0 as u256)
            evm.mstore(addr: 64, value: amount1 as u256)
            evm.log4(
                offset: 0,
                len: 96,
                topic0: COLLECT_TOPIC,
                topic1: ctx.caller().inner,
                topic2: int24_abi_word(tick_lower.downcast_unchecked()),
                topic3: int24_abi_word(tick_upper.downcast_unchecked()),
            )
            return_pair(amount0: amount0 as u256, amount1: amount1 as u256)
        }
    }
}
