use std::abi::sol::{self, Bytes32, Int24, Uint24, Uint160}
use std::evm::{assert_msg, Address, Call, Ctx, Evm, Log, RawMem, RawOps}
use super::libraries::fixed_point_128::Q128
use super::libraries::liquidity_math::add_delta
use super::libraries::position
use super::libraries::safe_cast::to_int128
use super::libraries::sqrt_price_math::{get_amount0_delta, get_amount1_delta}
use super::libraries::tick
use super::libraries::tick::tick_spacing_to_max_liquidity_per_tick
use super::libraries::tick_bitmap::{flip_tick_at, int_key}
use super::libraries::tick_math::{
    get_sqrt_ratio_at_tick,
    get_tick_at_sqrt_ratio,
    max_sqrt_ratio,
    min_sqrt_ratio,
    MAX_TICK,
    MIN_TICK,
}
use super::libraries::transfer_helper::safe_transfer

const TEST_POOL_START_TIME: u256 = 1601906400
const TICKS_SLOT: u256 = 5
const TICK_BITMAP_SLOT: u256 = 6
const POSITIONS_SLOT: u256 = 7
const INITIALIZE_TOPIC: u256 = 0x98636036cb66a9c19a37435efc1e90142190214e8abeb821bdba3f2990dd4c95
const INCREASE_OBSERVATION_CARDINALITY_NEXT_TOPIC: u256 = 0xac49e518f90a358f652e4400164f05a5d8f7e35e7747279bc3a93dbf584e125a
const MINT_TOPIC: u256 = 0x7a53080ba414158be7ec69b987b5fb7d07dee101fe85488f0853ae16239d0bde
const BURN_TOPIC: u256 = 0x0c396cd989a39f4459b5fa1aed6a9a8dcdbc45908acfd67e028cd568da98982c
const COLLECT_TOPIC: u256 = 0x70935338e69775456a85ddef226c395fb668b63fa0115f5f20610b388e6ca9c0
const SET_FEE_PROTOCOL_TOPIC: u256 = 0x973d8d92bb299f4af6ce49b52a8adb85ae46b9f214c4c4fc06ac77401237b133
const FLASH_TOPIC: u256 = 0xbdbdb71d7860376ba52b25a5028beea23581364a40522f6bcfb86bb1f2dca633
const FLASH_CALLBACK_SELECTOR: u256 = 0xe9cbafb0

msg MockTimeUniswapV3PoolMsg {
    #[selector = sol("factory()")]
    Factory -> u256,

    #[selector = sol("token0()")]
    Token0 -> u256,

    #[selector = sol("token1()")]
    Token1 -> u256,

    #[selector = sol("fee()")]
    Fee -> u32,

    #[selector = sol("tickSpacing()")]
    TickSpacing -> i32,

    #[selector = sol("maxLiquidityPerTick()")]
    MaxLiquidityPerTick -> u128,

    #[selector = sol("slot0()")]
    Slot0 -> (u256, i32, u16, u16, u16, u8, bool),

    #[selector = 0x252c09d7]
    Observations -> (u32, i64, u256, bool),

    #[selector = sol("initialize(uint160)")]
    Initialize { sqrtPriceX96: Uint160 },

    #[selector = sol("increaseObservationCardinalityNext(uint16)")]
    IncreaseObservationCardinalityNext { observationCardinalityNext: u16 },

    #[selector = sol("advanceTime(uint256)")]
    AdvanceTime { by: u256 },

    #[selector = sol("setFeeGrowthGlobal0X128(uint256)")]
    SetFeeGrowthGlobal0X128 { value: u256 },

    #[selector = sol("setFeeGrowthGlobal1X128(uint256)")]
    SetFeeGrowthGlobal1X128 { value: u256 },

    #[selector = sol("feeGrowthGlobal0X128()")]
    FeeGrowthGlobal0X128 -> u256,

    #[selector = sol("feeGrowthGlobal1X128()")]
    FeeGrowthGlobal1X128 -> u256,

    #[selector = sol("liquidity()")]
    Liquidity -> u128,

    #[selector = sol("protocolFees()")]
    ProtocolFees -> (u128, u128),

    #[selector = 0xa38807f2]
    SnapshotCumulativesInside,

    #[selector = 0x8206a4d1]
    SetFeeProtocol,

    #[selector = 0x85b66729]
    CollectProtocol -> (u256, u256),

    #[selector = 0x490e6cbc]
    Flash,

    #[selector = 0x128acb08]
    Swap,

    #[selector = 0x883bdbfd]
    Observe,

    #[selector = sol("ticks(int24)")]
    Ticks { tick: Int24 } -> (u128, i128, u256, u256, i64, u256, u32, bool),

    #[selector = sol("positions(bytes32)")]
    Positions { key: Bytes32 } -> (u128, u256, u256, u128, u128),

    #[selector = sol("mint(address,int24,int24,uint128,bytes)")]
    Mint { recipient: Address, tickLower: Int24, tickUpper: Int24, amount: u128, data: Bytes } -> (
        u256,
        u256,
    ),

    #[selector = sol("burn(int24,int24,uint128)")]
    Burn { tickLower: Int24, tickUpper: Int24, amount: u128 } -> (u256, u256),

    #[selector = sol("collect(address,int24,int24,uint128,uint128)")]
    Collect {
        recipient: Address,
        tickLower: Int24,
        tickUpper: Int24,
        amount0Requested: u128,
        amount1Requested: u128,
    } -> (u128, u128),

    #[selector = 0x8f6f4f01]
    ModifyPosition { owner: Address, tickLower: Int24, tickUpper: Int24, liquidityDelta: i128 } -> (
        u256,
        u256,
    ),
}

struct MockTimePoolStore {
    factory: Address,
    token0: Address,
    token1: Address,
    fee: u32,
    tick_spacing: i32,
    max_liquidity_per_tick: u128,
    sqrt_price_x96: u256,
    tick: i32,
    observation_index: u16,
    observation_cardinality: u16,
    observation_cardinality_next: u16,
    fee_protocol: u8,
    unlocked: bool,
    observation0_block_timestamp: u32,
    observation0_tick_cumulative: i64,
    observation0_seconds_per_liquidity_cumulative_x128: u256,
    time: u256,
    liquidity: u128,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
}

fn int24_abi_word(_ value: i32) -> u256 {
    int_key(value as i256)
}

fn decode_int24_word(_ word: u256) -> i256 {
    let value = word & 0xffffff
    if (value & 0x800000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((0xffffff - value) + 1) & 0xffffff
    let magnitude_i: i256 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

fn check_ticks(tick_lower: i256, tick_upper: i256) {
    assert_msg(tick_lower < tick_upper, "TLU")
    assert_msg(tick_lower >= MIN_TICK, "TLM")
    assert_msg(tick_upper <= MAX_TICK, "TUM")
}

fn current_tick_cumulative(tick_cumulative: i64, tick_current: i32, time_delta: u32) -> i256 {
    (tick_cumulative as i256) + ((tick_current as i256) * (time_delta as i256))
}

fn current_seconds_per_liquidity(
    seconds_per_liquidity_cumulative_x128: u256,
    time_delta: u32,
    liquidity: u128,
) -> u256 {
    let denominator = if liquidity > 0 { liquidity as u256 } else { 1 }
    seconds_per_liquidity_cumulative_x128 + (((time_delta as u256) << 128) / denominator)
}

fn min_u128(_ a: u128, _ b: u128) -> u128 {
    if a < b { return a }
    b
}

#[arithmetic(unchecked)]
fn sub_u256(a: u256, b: u256) -> u256 {
    a - b
}

#[arithmetic(unchecked)]
fn sub_i256(a: i256, b: i256) -> i256 {
    a - b
}

fn copy_words(dest: u256, src: u256, len: u256) uses (evm: mut Evm) {
    let mut offset: u256 = 0
    while offset < len {
        evm.mstore(addr: dest + offset, value: evm.mload(src + offset))
        offset += 32
    }
}

fn balance_of(token: Address, account: Address) -> u256
uses (call: mut Call, evm: mut Evm)
{
    evm.mstore(addr: 0, value: (0x70a08231 as u256) << 224)
    evm.mstore(addr: 4, value: account.inner)
    assert(
        call.raw_call(
            addr: token,
            gas: 1000000,
            value: 0,
            args_offset: 0,
            args_len: 36,
        ),
    )
    evm.returndatacopy(dest: 0, offset: 0, len: 32)
    evm.mload(0)
}

fn factory_owner(factory: Address) -> u256 uses (call: mut Call, evm: mut Evm) {
    evm.mstore(addr: 0, value: (0x8da5cb5b as u256) << 224)
    call.raw_call(
        addr: factory,
        gas: evm.gas(),
        value: 0,
        args_offset: 0,
        args_len: 4,
    )
    evm.returndatacopy(dest: 0, offset: 0, len: 32)
    evm.mload(0)
}

fn call_modify_position(
    pool: Address,
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    liquidity_delta: i128,
) -> (u256, u256)
uses (call: mut Call, evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(132)
    evm.mstore(addr: ptr, value: (0x8f6f4f01 as u256) << 224)
    evm.mstore(addr: ptr + 4, value: owner.inner)
    evm.mstore(addr: ptr + 36, value: int24_abi_word(tick_lower))
    evm.mstore(addr: ptr + 68, value: int24_abi_word(tick_upper))
    evm.mstore(addr: ptr + 100, value: int_key(liquidity_delta as i256))
    assert(
        call.raw_call(
            addr: pool,
            gas: evm.gas(),
            value: 0,
            args_offset: ptr,
            args_len: 132,
        ),
    )
    evm.returndatacopy(dest: ptr, offset: 0, len: 64)
    (evm.mload(ptr), evm.mload(ptr + 32))
}

fn mint_callback(caller: Address, amount0: u256, amount1: u256, data: Bytes)
uses (call: mut Call, evm: mut Evm)
{
    let len = 100 + data.size
    let ptr = std::evm::mem::alloc(len)
    evm.mstore(addr: ptr, value: (0xd3487997 as u256) << 224)
    evm.mstore(addr: ptr + 4, value: amount0)
    evm.mstore(addr: ptr + 36, value: amount1)
    evm.mstore(addr: ptr + 68, value: 96)
    copy_words(dest: ptr + 100, src: data.data, len: data.size)
    assert(
        call.raw_call(
            addr: caller,
            gas: 1000000,
            value: 0,
            args_offset: ptr,
            args_len: len,
        ),
    )
}

fn flash_callback(caller: Address, fee0: u256, fee1: u256, data_start: u256)
uses (call: mut Call, evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(228)
    evm.mstore(addr: ptr, value: FLASH_CALLBACK_SELECTOR << 224)
    evm.mstore(addr: ptr + 4, value: fee0)
    evm.mstore(addr: ptr + 36, value: fee1)
    evm.mstore(addr: ptr + 68, value: 96)
    evm.mstore(addr: ptr + 100, value: 96)
    evm.calldatacopy(dest: ptr + 132, offset: data_start + 32, len: 96)
    assert(
        call.raw_call(
            addr: caller,
            gas: 1000000,
            value: 0,
            args_offset: ptr,
            args_len: 228,
        ),
    )
}

fn emit_initialize(sqrt_price_x96: u256, tick: i32) uses (evm: mut Evm) {
    evm.mstore(addr: 0, value: sqrt_price_x96)
    evm.mstore(addr: 32, value: int24_abi_word(tick))
    evm.log1(offset: 0, len: 64, topic0: INITIALIZE_TOPIC)
}

fn emit_increase_observation_cardinality_next(old: u16, new: u16)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: old as u256)
    evm.mstore(addr: 32, value: new as u256)
    evm.log1(
        offset: 0,
        len: 64,
        topic0: INCREASE_OBSERVATION_CARDINALITY_NEXT_TOPIC,
    )
}

fn emit_mint(
    sender: Address,
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: sender.inner)
    evm.mstore(addr: 32, value: amount as u256)
    evm.mstore(addr: 64, value: amount0)
    evm.mstore(addr: 96, value: amount1)
    evm.log4(
        offset: 0,
        len: 128,
        topic0: MINT_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

fn emit_burn(
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: amount as u256)
    evm.mstore(addr: 32, value: amount0)
    evm.mstore(addr: 64, value: amount1)
    evm.log4(
        offset: 0,
        len: 96,
        topic0: BURN_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

fn emit_flash(
    sender: Address,
    recipient: Address,
    amount0: u256,
    amount1: u256,
    paid0: u256,
    paid1: u256,
)
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: amount0)
    evm.mstore(addr: 32, value: amount1)
    evm.mstore(addr: 64, value: paid0)
    evm.mstore(addr: 96, value: paid1)
    evm.log3(
        offset: 0,
        len: 128,
        topic0: FLASH_TOPIC,
        topic1: sender.inner,
        topic2: recipient.inner,
    )
}

fn return_snapshot(
    tick_cumulative_inside: i256,
    seconds_per_liquidity_inside_x128: u256,
    seconds_inside: u32,
) -> !
uses (evm: mut Evm)
{
    evm.mstore(addr: 0, value: int_key(tick_cumulative_inside))
    evm.mstore(addr: 32, value: seconds_per_liquidity_inside_x128)
    evm.mstore(addr: 64, value: seconds_inside as u256)
    evm.return_data(offset: 0, len: 96)
}

pub contract MockTimeUniswapV3Pool uses (ctx: Ctx, call: mut Call, evm: mut Evm) {
    mut store: MockTimePoolStore,

    init(factory: Address, token0: Address, token1: Address, fee: Uint24, tick_spacing: Int24)
    uses (mut store)
    {
        store.factory = factory
        store.token0 = token0
        store.token1 = token1
        store.fee = fee.val
        store.tick_spacing = tick_spacing.val
        store.max_liquidity_per_tick = tick_spacing_to_max_liquidity_per_tick(
            tick_spacing.val as i256,
        )
        store.time = TEST_POOL_START_TIME
    }

    recv MockTimeUniswapV3PoolMsg {
        Factory -> u256 uses (store) {
            store.factory.inner
        }

        Token0 -> u256 uses (store) {
            store.token0.inner
        }

        Token1 -> u256 uses (store) {
            store.token1.inner
        }

        Fee -> u32 uses (store) {
            store.fee
        }

        TickSpacing -> i32 uses (store) {
            store.tick_spacing
        }

        MaxLiquidityPerTick -> u128 uses (store) {
            store.max_liquidity_per_tick
        }

        Slot0 -> (u256, i32, u16, u16, u16, u8, bool)
        uses (store)
        {
            (
                store.sqrt_price_x96,
                store.tick,
                store.observation_index,
                store.observation_cardinality,
                store.observation_cardinality_next,
                store.fee_protocol,
                store.unlocked,
            )
        }

        Observations -> (u32, i64, u256, bool) uses (store) {
            (
                store.observation0_block_timestamp,
                store.observation0_tick_cumulative,
                store.observation0_seconds_per_liquidity_cumulative_x128,
                true,
            )
        }

        Initialize { sqrtPriceX96 } uses (mut store, mut evm) {
            assert(store.sqrt_price_x96 == 0)
            assert_msg(
                sqrtPriceX96.val >= min_sqrt_ratio() && sqrtPriceX96.val < max_sqrt_ratio(),
                "R",
            )
            let tick: i32 = get_tick_at_sqrt_ratio(sqrt_price_x96: sqrtPriceX96.val)
                .downcast_unchecked()
            store.sqrt_price_x96 = sqrtPriceX96.val
            store.tick = tick
            store.observation_index = 0
            store.observation_cardinality = 1
            store.observation_cardinality_next = 1
            store.unlocked = true
            store.observation0_block_timestamp = store.time.downcast_unchecked()
            store.observation0_tick_cumulative = 0
            store.observation0_seconds_per_liquidity_cumulative_x128 = 0
            emit_initialize(sqrt_price_x96: sqrtPriceX96.val, tick)
        }

        IncreaseObservationCardinalityNext { observationCardinalityNext }
        uses (mut store, mut evm)
        {
            assert_msg(store.unlocked, "LOK")
            store.unlocked = false
            let old = store.observation_cardinality_next
            let new = if observationCardinalityNext > old {
                observationCardinalityNext
            } else {
                old
            }
            store.observation_cardinality_next = new
            if old != new {
                emit_increase_observation_cardinality_next(old, new)
            }
            store.unlocked = true
        }

        AdvanceTime { by } uses (mut store) {
            store.time += by
        }

        SetFeeGrowthGlobal0X128 { value } uses (mut store) {
            store.fee_growth_global0_x128 = value
        }

        SetFeeGrowthGlobal1X128 { value } uses (mut store) {
            store.fee_growth_global1_x128 = value
        }

        FeeGrowthGlobal0X128 -> u256 uses (store) {
            store.fee_growth_global0_x128
        }

        FeeGrowthGlobal1X128 -> u256 uses (store) {
            store.fee_growth_global1_x128
        }

        Liquidity -> u128 uses (store) {
            store.liquidity
        }

        ProtocolFees -> (u128, u128) {
            (0, 0)
        }

        SnapshotCumulativesInside uses (mut evm, store) {
            let lower = decode_int24_word(evm.calldataload(4))
            let upper = decode_int24_word(evm.calldataload(36))
            check_ticks(tick_lower: lower, tick_upper: upper)

            let (
                _,
                _,
                _,
                _,
                tick_cumulative_lower,
                seconds_per_liquidity_outside_lower,
                seconds_outside_lower,
                initialized_lower,
            ) = tick::read_tick_at(lower, ticks_slot: TICKS_SLOT)
            assert(initialized_lower)
            let (
                _,
                _,
                _,
                _,
                tick_cumulative_upper,
                seconds_per_liquidity_outside_upper,
                seconds_outside_upper,
                initialized_upper,
            ) = tick::read_tick_at(upper, ticks_slot: TICKS_SLOT)
            assert(initialized_upper)

            let tick_current = store.tick as i256
            assert(tick_current >= lower && tick_current < upper)
            let current_time: u32 = store.time.downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = current_tick_cumulative(
                tick_cumulative: store.observation0_tick_cumulative,
                tick_current: store.tick,
                time_delta,
            )
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: store
                    .observation0_seconds_per_liquidity_cumulative_x128,
                time_delta,
                liquidity: store.liquidity,
            )
            let seconds_per_liquidity_inside_minus_lower = sub_u256(
                a: seconds_per_liquidity_cumulative_x128,
                b: seconds_per_liquidity_outside_lower,
            )
            let seconds_per_liquidity_inside_x128 = sub_u256(
                a: seconds_per_liquidity_inside_minus_lower,
                b: seconds_per_liquidity_outside_upper,
            )
            let seconds_inside = current_time - seconds_outside_lower - seconds_outside_upper
            let tick_cumulative_inside_minus_lower = sub_i256(
                a: tick_cumulative,
                b: tick_cumulative_lower,
            )
            let tick_cumulative_inside = sub_i256(
                a: tick_cumulative_inside_minus_lower,
                b: tick_cumulative_upper,
            )
            return_snapshot(
                tick_cumulative_inside,
                seconds_per_liquidity_inside_x128,
                seconds_inside,
            )
        }

        SetFeeProtocol uses (ctx, mut call, mut evm, mut store) {
            assert(evm.calldatasize() >= 68)
            let fee0_word = evm.calldataload(4)
            let fee1_word = evm.calldataload(36)
            assert(fee0_word <= 255)
            assert(fee1_word <= 255)
            let feeProtocol0: u8 = fee0_word.downcast_unchecked()
            let feeProtocol1: u8 = fee1_word.downcast_unchecked()
            assert(
                ctx.caller().inner == factory_owner(factory: store.factory),
            )
            let fee_mask = ((1 as u256) << (feeProtocol0 as u256))
                | ((1 as u256) << (feeProtocol1 as u256))
            assert((fee_mask & 0x7f1) == fee_mask)

            let old = store.fee_protocol
            store.fee_protocol = ((feeProtocol0 as u256) | ((feeProtocol1 as u256) << 4))
                .downcast_unchecked()
            evm.mstore(addr: 0, value: (old & 0x0f) as u256)
            evm.mstore(addr: 32, value: (old >> 4) as u256)
            evm.mstore(addr: 64, value: feeProtocol0 as u256)
            evm.mstore(addr: 96, value: feeProtocol1 as u256)
            evm.log1(offset: 0, len: 128, topic0: SET_FEE_PROTOCOL_TOPIC)
        }

        CollectProtocol -> (u256, u256) {
            (0, 0)
        }

        Flash uses (ctx, mut call, mut evm, mut store) {
            assert_msg(store.liquidity != 0, "L")
            let recipient = Address { inner: evm.calldataload(4) }
            let amount0 = evm.calldataload(36)
            let amount1 = evm.calldataload(68)
            let data_offset = evm.calldataload(100)
            let data_start = 4 + data_offset
            let pay0 = evm.calldataload(data_start + 64)
            let pay1 = evm.calldataload(data_start + 96)
            let fee0 = ((amount0 * (store.fee as u256)) + 999999) / 1000000
            let fee1 = ((amount1 * (store.fee as u256)) + 999999) / 1000000
            if amount0 > 0 {
                assert(pay0 >= amount0 + fee0)
                safe_transfer(token: store.token0, to: recipient, value: amount0)
            }
            if amount1 > 0 {
                assert(pay1 >= amount1 + fee1)
                safe_transfer(token: store.token1, to: recipient, value: amount1)
            }
            flash_callback(caller: ctx.caller(), fee0, fee1, data_start)
            let paid0 = sub_u256(a: pay0, b: amount0)
            let paid1 = sub_u256(a: pay1, b: amount1)
            if paid0 > 0 && (store.fee_protocol & 0x0f) == 0 {
                store.fee_growth_global0_x128 += (paid0 * Q128) / (store.liquidity as u256)
            }
            if paid1 > 0 && (store.fee_protocol >> 4) == 0 {
                store.fee_growth_global1_x128 += (paid1 * Q128) / (store.liquidity as u256)
            }
            emit_flash(
                sender: ctx.caller(),
                recipient,
                amount0,
                amount1,
                paid0,
                paid1,
            )
        }

        Swap uses (mut evm) {
            let zero_for_one = evm.calldataload(36) != 0
            let data_offset = evm.calldataload(132)
            let data_start = 4 + data_offset
            let pay0 = evm.calldataload(data_start + 64)
            let pay1 = evm.calldataload(data_start + 96)
            if zero_for_one {
                assert_msg(pay0 >= 1000, "IIA")
            } else {
                assert_msg(pay1 >= 1000, "IIA")
            }
        }

        Observe uses (mut evm, store) {
            let current_time: u32 = store.time.downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = (store.observation0_tick_cumulative as i256)
                + ((store.tick as i256) * (time_delta as i256))
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: store
                    .observation0_seconds_per_liquidity_cumulative_x128,
                time_delta,
                liquidity: store.liquidity,
            )
            evm.mstore(addr: 0, value: 64)
            evm.mstore(addr: 32, value: 128)
            evm.mstore(addr: 64, value: 1)
            evm.mstore(addr: 96, value: int_key(tick_cumulative))
            evm.mstore(addr: 128, value: 1)
            evm.mstore(addr: 160, value: seconds_per_liquidity_cumulative_x128)
            evm.return_data(offset: 0, len: 192)
        }

        Ticks { tick } -> (u128, i128, u256, u256, i64, u256, u32, bool)
        uses (mut evm)
        {
            let (
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside,
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            ) = tick::read_tick_at(tick.val as i256, ticks_slot: TICKS_SLOT)
            (
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside.downcast_unchecked(),
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            )
        }

        Positions { key } -> (u128, u256, u256, u128, u128)
        uses (mut evm)
        {
            position::read_position(
                position::mapping_slot(key: key.val, positions_slot: POSITIONS_SLOT),
            )
        }

        ModifyPosition { owner, tickLower, tickUpper, liquidityDelta } -> (u256, u256)
        uses (ctx, mut evm, mut store)
        {
            assert(ctx.caller().inner == ctx.address().inner)
            let tick_lower = tickLower.val as i256
            let tick_upper = tickUpper.val as i256
            check_ticks(tick_lower, tick_upper: tick_upper)

            let current_time: u32 = store.time.downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = current_tick_cumulative(
                tick_cumulative: store.observation0_tick_cumulative,
                tick_current: store.tick,
                time_delta,
            )
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: store
                    .observation0_seconds_per_liquidity_cumulative_x128,
                time_delta,
                liquidity: store.liquidity,
            )
            let tick_current_i = store.tick as i256

            let mut flipped_lower = false
            let mut flipped_upper = false
            if liquidityDelta != 0 {
                flipped_lower = tick::update_at(
                    tick: tick_lower,
                    tick_current: tick_current_i,
                    liquidity_delta: liquidityDelta,
                    fee_growth_global0_x128: store.fee_growth_global0_x128,
                    fee_growth_global1_x128: store.fee_growth_global1_x128,
                    seconds_per_liquidity_cumulative_x128,
                    tick_cumulative,
                    time: current_time,
                    upper: false,
                    max_liquidity: store.max_liquidity_per_tick,
                    ticks_slot: TICKS_SLOT,
                )
                flipped_upper = tick::update_at(
                    tick: tick_upper,
                    tick_current: tick_current_i,
                    liquidity_delta: liquidityDelta,
                    fee_growth_global0_x128: store.fee_growth_global0_x128,
                    fee_growth_global1_x128: store.fee_growth_global1_x128,
                    seconds_per_liquidity_cumulative_x128,
                    tick_cumulative,
                    time: current_time,
                    upper: true,
                    max_liquidity: store.max_liquidity_per_tick,
                    ticks_slot: TICKS_SLOT,
                )

                if flipped_lower {
                    flip_tick_at(
                        tick: tick_lower,
                        tick_spacing: store.tick_spacing as i256,
                        bitmap_slot: TICK_BITMAP_SLOT,
                    )
                }
                if flipped_upper {
                    flip_tick_at(
                        tick: tick_upper,
                        tick_spacing: store.tick_spacing as i256,
                        bitmap_slot: TICK_BITMAP_SLOT,
                    )
                }
            }

            let (fee_growth_inside0_x128, fee_growth_inside1_x128) = tick::get_fee_growth_inside_at(
                tick_lower,
                tick_upper,
                tick_current: tick_current_i,
                fee_growth_global0_x128: store.fee_growth_global0_x128,
                fee_growth_global1_x128: store.fee_growth_global1_x128,
                ticks_slot: TICKS_SLOT,
            )
            let position_slot = position::position_slot(
                owner,
                tick_lower,
                tick_upper,
                positions_slot: POSITIONS_SLOT,
            )
            position::update(
                base_slot: position_slot,
                liquidity_delta: liquidityDelta,
                fee_growth_inside0_x128,
                fee_growth_inside1_x128,
            )
            if liquidityDelta < 0 {
                if flipped_lower {
                    tick::clear_at(tick: tick_lower, ticks_slot: TICKS_SLOT)
                }
                if flipped_upper {
                    tick::clear_at(tick: tick_upper, ticks_slot: TICKS_SLOT)
                }
            }

            let amount: u128 = if liquidityDelta < 0 {
                (0 - (liquidityDelta as i256)).downcast_unchecked()
            } else {
                liquidityDelta.downcast_unchecked()
            }
            let round_up = liquidityDelta > 0
            let amount0 = if tick_current_i < tick_lower {
                get_amount0_delta(
                    sqrt_ratio_a_x96: get_sqrt_ratio_at_tick(tick: tick_lower),
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up,
                )
            } else if tick_current_i < tick_upper {
                get_amount0_delta(
                    sqrt_ratio_a_x96: store.sqrt_price_x96,
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up,
                )
            } else {
                0
            }
            let amount1 = if tick_current_i < tick_lower {
                0
            } else if tick_current_i < tick_upper {
                get_amount1_delta(
                    sqrt_ratio_a_x96: get_sqrt_ratio_at_tick(tick: tick_lower),
                    sqrt_ratio_b_x96: store.sqrt_price_x96,
                    amount,
                    round_up,
                )
            } else {
                get_amount1_delta(
                    sqrt_ratio_a_x96: get_sqrt_ratio_at_tick(tick: tick_lower),
                    sqrt_ratio_b_x96: get_sqrt_ratio_at_tick(tick: tick_upper),
                    amount,
                    round_up,
                )
            }

            if tick_current_i >= tick_lower && tick_current_i < tick_upper {
                store.observation0_block_timestamp = current_time
                store.observation0_tick_cumulative = tick_cumulative.downcast_unchecked()
                store
                    .observation0_seconds_per_liquidity_cumulative_x128 = seconds_per_liquidity_cumulative_x128
                store.liquidity = add_delta(store.liquidity, liquidityDelta)
            }

            if liquidityDelta < 0 && (amount0 > 0 || amount1 > 0) {
                let (
                    liquidity_value,
                    fee_growth_inside0_last_x128,
                    fee_growth_inside1_last_x128,
                    tokens_owed0,
                    tokens_owed1,
                ) = position::read_position(position_slot)
                position::set_position(
                    base_slot: position_slot,
                    liquidity_value,
                    fee_growth_inside0_last_x128,
                    fee_growth_inside1_last_x128,
                    tokens_owed0_value: tokens_owed0 + amount0.downcast_unchecked(),
                    tokens_owed1_value: tokens_owed1 + amount1.downcast_unchecked(),
                )
            }

            (amount0, amount1)
        }

        Mint { recipient, tickLower, tickUpper, amount, data } -> (u256, u256)
        uses (ctx, mut call, mut evm, mut store)
        {
            assert_msg(store.unlocked, "LOK")
            store.unlocked = false

            assert(amount > 0)
            let liquidity_delta = to_int128(amount as i256)
            let (amount0, amount1) = call_modify_position(
                pool: ctx.address(),
                owner: recipient,
                tick_lower: tickLower.val,
                tick_upper: tickUpper.val,
                liquidity_delta,
            )

            let balance0_before = if amount0 > 0 {
                balance_of(token: store.token0, account: ctx.address())
            } else {
                0
            }
            let balance1_before = if amount1 > 0 {
                balance_of(token: store.token1, account: ctx.address())
            } else {
                0
            }

            mint_callback(caller: ctx.caller(), amount0, amount1, data)

            if amount0 > 0 {
                let balance0_after: u256 = balance_of(token: store.token0, account: ctx.address())
                assert_msg(balance0_before + amount0 <= balance0_after, "M0")
            }
            if amount1 > 0 {
                let balance1_after: u256 = balance_of(token: store.token1, account: ctx.address())
                assert_msg(balance1_before + amount1 <= balance1_after, "M1")
            }

            store.unlocked = true
            emit_mint(
                sender: ctx.caller(),
                owner: recipient,
                tick_lower: tickLower.val,
                tick_upper: tickUpper.val,
                amount,
                amount0,
                amount1,
            )
            (amount0, amount1)
        }

        Burn { tickLower, tickUpper, amount } -> (u256, u256)
        uses (ctx, mut call, mut evm, mut store)
        {
            assert_msg(store.unlocked, "LOK")
            store.unlocked = false

            let liquidity_delta = 0 - to_int128(amount as i256)
            let (amount0, amount1) = call_modify_position(
                pool: ctx.address(),
                owner: ctx.caller(),
                tick_lower: tickLower.val,
                tick_upper: tickUpper.val,
                liquidity_delta,
            )

            store.unlocked = true
            emit_burn(
                owner: ctx.caller(),
                tick_lower: tickLower.val,
                tick_upper: tickUpper.val,
                amount,
                amount0,
                amount1,
            )
            (amount0, amount1)
        }

        Collect { recipient, tickLower, tickUpper, amount0Requested, amount1Requested } -> (
            u128,
            u128,
        )
        uses (ctx, mut evm, mut store)
        {
            assert_msg(store.unlocked, "LOK")
            store.unlocked = false

            let position_slot = position::position_slot(
                owner: ctx.caller(),
                tick_lower: tickLower.val as i256,
                tick_upper: tickUpper.val as i256,
                positions_slot: POSITIONS_SLOT,
            )
            let (
                liquidity_value,
                fee_growth_inside0_last_x128,
                fee_growth_inside1_last_x128,
                tokens_owed0,
                tokens_owed1,
            ) = position::read_position(position_slot)
            let amount0 = min_u128(a: amount0Requested, b: tokens_owed0)
            let amount1 = min_u128(a: amount1Requested, b: tokens_owed1)

            if amount0 > 0 || amount1 > 0 {
                position::set_position(
                    base_slot: position_slot,
                    liquidity_value,
                    fee_growth_inside0_last_x128,
                    fee_growth_inside1_last_x128,
                    tokens_owed0_value: tokens_owed0 - amount0,
                    tokens_owed1_value: tokens_owed1 - amount1,
                )
            }
            store.unlocked = true
            evm.mstore(addr: 0, value: recipient.inner)
            evm.mstore(addr: 32, value: amount0 as u256)
            evm.mstore(addr: 64, value: amount1 as u256)
            evm.log4(
                offset: 0,
                len: 96,
                topic0: COLLECT_TOPIC,
                topic1: ctx.caller().inner,
                topic2: int24_abi_word(tickLower.val),
                topic3: int24_abi_word(tickUpper.val),
            )
            (amount0, amount1)
        }
    }
}
