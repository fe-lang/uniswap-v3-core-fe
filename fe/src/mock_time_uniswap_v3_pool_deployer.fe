use std::evm::{Address, Create, Evm, Log, RawMem, RawOps, RawStorage}
use super::libraries::tick_bitmap::int_key
use super::mock_time_uniswap_v3_pool::MockTimeUniswapV3Pool

const PARAMETERS_FACTORY_SLOT: u256 = 0
const PARAMETERS_TOKEN0_SLOT: u256 = 1
const PARAMETERS_TOKEN1_SLOT: u256 = 2
const PARAMETERS_PACKED_SLOT: u256 = 3
const MASK_U24: u256 = 0xffffff
const POOL_DEPLOYED_TOPIC: u256 = 0xf0d1eeab175eee2e20b8dc452773bf2257b25724b323b42bc6e5b4616233ae1f

#[arithmetic(unchecked)]
fn int24_word(_ value: i32) -> u256 {
    int_key(value as i256) & MASK_U24
}

#[arithmetic(unchecked)]
fn pool_salt(token0: Address, token1: Address, fee: u32, tick_spacing: i32) -> u256
uses (evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(addr: ptr, value: token0.inner << 96)
    evm.mstore(addr: ptr + 20, value: token1.inner << 96)
    evm.mstore(
        addr: ptr + 40,
        value: (((fee as u256) << 24) | int24_word(tick_spacing)) << 208,
    )
    evm.keccak256(offset: ptr, len: 46)
}

#[arithmetic(unchecked)]
fn decode_int24_word(_ word: u256) -> i32 {
    let value = word & MASK_U24
    if (value & 0x800000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((MASK_U24 - value) + 1) & MASK_U24
    let magnitude_i: i32 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

#[arithmetic(unchecked)]
fn store_parameters(factory: Address, token0: Address, token1: Address, fee: u32, tick_spacing: i32)
uses (evm: mut Evm)
{
    evm.sstore(slot: PARAMETERS_FACTORY_SLOT, value: factory.inner)
    evm.sstore(slot: PARAMETERS_TOKEN0_SLOT, value: token0.inner)
    evm.sstore(slot: PARAMETERS_TOKEN1_SLOT, value: token1.inner)
    evm.sstore(
        slot: PARAMETERS_PACKED_SLOT,
        value: (fee as u256) | (int24_word(tick_spacing) << 24),
    )
}

fn clear_parameters() uses (evm: mut Evm) {
    evm.sstore(slot: PARAMETERS_FACTORY_SLOT, value: 0)
    evm.sstore(slot: PARAMETERS_TOKEN0_SLOT, value: 0)
    evm.sstore(slot: PARAMETERS_TOKEN1_SLOT, value: 0)
    evm.sstore(slot: PARAMETERS_PACKED_SLOT, value: 0)
}

#[arithmetic(unchecked)]
fn emit_pool_deployed(_ pool: Address) uses (evm: mut Evm) {
    evm.mstore(addr: 0, value: pool.inner)
    evm.log1(offset: 0, len: 32, topic0: POOL_DEPLOYED_TOPIC)
}

#[arithmetic(unchecked)]
fn return_parameters() uses (evm: mut Evm) {
    let packed = evm.sload(PARAMETERS_PACKED_SLOT)
    evm.mstore(addr: 0, value: evm.sload(PARAMETERS_FACTORY_SLOT))
    evm.mstore(addr: 32, value: evm.sload(PARAMETERS_TOKEN0_SLOT))
    evm.mstore(addr: 64, value: evm.sload(PARAMETERS_TOKEN1_SLOT))
    evm.mstore(addr: 96, value: packed & MASK_U24)
    evm.mstore(addr: 128, value: packed >> 24)
    evm.return_data(offset: 0, len: 160)
}

msg MockTimeUniswapV3PoolDeployerMsg {
    #[selector = 0x89035730]
    Parameters,

    #[selector = 0xfad5359f]
    Deploy,
}

pub contract MockTimeUniswapV3PoolDeployer uses (evm: mut Evm) {
    recv MockTimeUniswapV3PoolDeployerMsg {
        Parameters uses (mut evm) {
            return_parameters()
        }

        Deploy uses (mut evm) {
            assert(evm.calldatasize() >= 164)
            let factory = Address { inner: evm.calldataload(4) }
            let token0 = Address { inner: evm.calldataload(36) }
            let token1 = Address { inner: evm.calldataload(68) }
            let fee: u32 = (evm.calldataload(100) & MASK_U24).downcast_unchecked()
            let tick_spacing = decode_int24_word(evm.calldataload(132))
            store_parameters(factory, token0, token1, fee, tick_spacing)
            let pool = evm
                .create2<MockTimeUniswapV3Pool>(
                    value: 0,
                    args: (),
                    salt: pool_salt(token0, token1, fee, tick_spacing),
                )
            assert(pool.inner != 0)
            clear_parameters()
            emit_pool_deployed(pool)
            evm.mstore(addr: 0, value: pool.inner)
            evm.return_data(offset: 0, len: 32)
        }
    }
}
