use std::evm::packed::Packed
use std::evm::encode_abi_payload
use std::evm::{Address, Create, Evm, Log, RawOps}
use super::libraries::tick_bitmap::int_key
use super::mock_time_uniswap_v3_pool::MockTimeUniswapV3Pool

struct Parameters { factory: u256, token0: u256, token1: u256, packed: u256 }

const MASK_U24: u256 = 0xffffff
const POOL_DEPLOYED_TOPIC: u256 = 0xf0d1eeab175eee2e20b8dc452773bf2257b25724b323b42bc6e5b4616233ae1f

#[arithmetic(unchecked)]
fn int24_word(_ value: i32) -> u256 {
    int_key(value as i256) & MASK_U24
}

#[arithmetic(unchecked)]
fn pool_salt(token0: Address, token1: Address, fee: u32, tick_spacing: i32) -> u256 {
    let packed = (((fee as u256) << 24) | int24_word(tick_spacing)) << 208
    let suffix = encode_abi_payload(packed)
    let mut salt = Packed::with_capacity(bytes: 46)
    salt.address(token0)
    salt.address(token1)
    salt.append_span(suffix.span().head(6))
    salt.keccak256()
}

#[arithmetic(unchecked)]
fn decode_int24_word(_ word: u256) -> i32 {
    let value = word & MASK_U24
    if (value & 0x800000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((MASK_U24 - value) + 1) & MASK_U24
    let magnitude_i: i32 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

#[arithmetic(unchecked)]
fn store_parameters(factory: Address, token0: Address, token1: Address, fee: u32, tick_spacing: i32)
uses (parameters: mut Parameters)
{
    parameters.factory = factory.inner
    parameters.token0 = token0.inner
    parameters.token1 = token1.inner
    parameters.packed = (fee as u256) | (int24_word(tick_spacing) << 24)
}

fn clear_parameters() uses (parameters: mut Parameters) {
    parameters.factory = 0
    parameters.token0 = 0
    parameters.token1 = 0
    parameters.packed = 0
}

#[arithmetic(unchecked)]
fn emit_pool_deployed(_ pool: Address) uses (evm: mut Evm) {
    let ptr = encode_abi_payload((pool.inner,))
    evm.log1(data: ptr.span().head(32), topic0: POOL_DEPLOYED_TOPIC)
}

#[arithmetic(unchecked)]
fn return_parameters() uses (evm: mut Evm, parameters: Parameters) {
    let out = encode_abi_payload(
        (
            parameters.factory,
            parameters.token0,
            parameters.token1,
            parameters.packed & MASK_U24,
            parameters.packed >> 24,
        ),
    )
    evm.return_data(data: out.span())
}

msg MockTimeUniswapV3PoolDeployerMsg {
    #[selector = 0x89035730]
    Parameters,

    #[selector = 0xfad5359f]
    Deploy,
}

pub contract MockTimeUniswapV3PoolDeployer uses (evm: mut Evm) {
    mut parameters: Parameters,
    recv MockTimeUniswapV3PoolDeployerMsg {
        Parameters uses (mut evm, parameters) {
            return_parameters()
        }

        Deploy uses (mut evm, mut parameters) {
            assert(evm.calldatasize() >= 164)
            let factory = Address { inner: evm.calldataload(4) }
            let token0 = Address { inner: evm.calldataload(36) }
            let token1 = Address { inner: evm.calldataload(68) }
            let fee: u32 = (evm.calldataload(100) & MASK_U24).downcast_unchecked()
            let tick_spacing = decode_int24_word(evm.calldataload(132))
            store_parameters(factory, token0, token1, fee, tick_spacing)
            let pool = evm
                .create2<MockTimeUniswapV3Pool>(
                    value: 0,
                    args: (),
                    salt: pool_salt(token0, token1, fee, tick_spacing),
                )
            assert(pool.inner != 0)
            clear_parameters()
            emit_pool_deployed(pool)
            let out = encode_abi_payload((pool.inner,))
            evm.return_data(data: out.span().head(32))
        }
    }
}
