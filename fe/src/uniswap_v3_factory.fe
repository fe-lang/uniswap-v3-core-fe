use std::abi::sol::{self, Int24, Uint24}
use std::evm::{Address, Call, Create, Ctx, Evm, Log, RawMem, RawOps, RawStorage}
use super::libraries::tick_bitmap::int_key

const PARAMETERS_FACTORY_SLOT: u256 = 0
const PARAMETERS_TOKEN0_SLOT: u256 = 1
const PARAMETERS_TOKEN1_SLOT: u256 = 2
const PARAMETERS_PACKED_SLOT: u256 = 3
const OWNER_SLOT: u256 = 4
const FEE_AMOUNT_TICK_SPACING_SLOT: u256 = 5
const GET_POOL_SLOT: u256 = 6
const ORIGINAL_SLOT: u256 = 7
const POOL_INIT_CODE_HOLDER_SLOT: u256 = 8

const MASK_U24: u256 = 0xffffff
const MASK_U160: u256 = 0xffffffffffffffffffffffffffffffffffffffff
const MIN_I24: i256 = -0x800000
const MAX_I24: i256 = 0x7fffff
const OWNER_CHANGED_TOPIC: u256 = 0xb532073b38c83145e3e5135377a08bf9aab55bc0fd7c1179cd4fb995d2a5159c
const POOL_CREATED_TOPIC: u256 = 0x783cca1c0412dd0d695e784568c96da2e9c22ff989357a2e8b1d9b2b4e6b7118
const FEE_AMOUNT_ENABLED_TOPIC: u256 = 0xc66a3fdf07232cdd185febcc6579d408c241b47ae2f9907d84be655141eeaecc

fn checked_fee(_ fee: Uint24) -> u32 {
    assert(fee.val <= MASK_U24.downcast_unchecked())
    fee.val
}

fn checked_int24(_ tick_spacing: Int24) -> i32 {
    let value = tick_spacing.val as i256
    assert(value >= MIN_I24 && value <= MAX_I24)
    tick_spacing.val
}

fn int24_word(_ value: i32) -> u256 {
    int_key(value as i256) & MASK_U24
}

fn int24_abi_word(_ value: i32) -> u256 {
    int_key(value as i256)
}

fn decode_int24(_ word: u256) -> i32 {
    let value = word & MASK_U24
    if (value & 0x800000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((MASK_U24 - value) + 1) & MASK_U24
    let magnitude_i: i32 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

fn address_at(_ slot: u256) -> Address uses (evm: Evm) {
    Address { inner: evm.sload(slot) & MASK_U160 }
}

fn store_address(slot: u256, value: Address) uses (evm: mut Evm) {
    evm.sstore(slot: slot, value: value.inner)
}

fn mapping_slot(key: u256, slot: u256) -> u256 uses (evm: mut Evm) {
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(addr: ptr, value: key)
    evm.mstore(addr: ptr + 32, value: slot)
    evm.keccak256(offset: ptr, len: 64)
}

fn fee_amount_tick_spacing_slot(_ fee: Uint24) -> u256 uses (evm: mut Evm) {
    mapping_slot(
        key: checked_fee(fee) as u256,
        slot: FEE_AMOUNT_TICK_SPACING_SLOT,
    )
}

fn get_pool_slot(token0: Address, token1: Address, fee: Uint24) -> u256
uses (evm: mut Evm)
{
    let token0_slot = mapping_slot(key: token0.inner, slot: GET_POOL_SLOT)
    let token1_slot = mapping_slot(key: token1.inner, slot: token0_slot)
    mapping_slot(key: checked_fee(fee) as u256, slot: token1_slot)
}

fn fee_amount_tick_spacing(_ fee: Uint24) -> Int24 uses (evm: mut Evm) {
    Int24 { val: decode_int24(evm.sload(fee_amount_tick_spacing_slot(fee))) }
}

fn set_fee_amount_tick_spacing(fee: Uint24, tick_spacing: Int24)
uses (evm: mut Evm)
{
    checked_fee(fee)
    checked_int24(tick_spacing)
    evm.sstore(
        slot: fee_amount_tick_spacing_slot(fee),
        value: int24_word(tick_spacing.val),
    )
}

fn get_pool(token0: Address, token1: Address, fee: Uint24) -> Address
uses (evm: mut Evm)
{
    address_at(get_pool_slot(token0, token1, fee))
}

fn set_pool(token0: Address, token1: Address, fee: Uint24, pool: Address)
uses (evm: mut Evm)
{
    store_address(slot: get_pool_slot(token0, token1, fee), value: pool)
}

fn set_parameters(
    factory: Address,
    token0: Address,
    token1: Address,
    fee: Uint24,
    tick_spacing: Int24,
)
uses (evm: mut Evm)
{
    store_address(slot: PARAMETERS_FACTORY_SLOT, value: factory)
    store_address(slot: PARAMETERS_TOKEN0_SLOT, value: token0)
    store_address(slot: PARAMETERS_TOKEN1_SLOT, value: token1)
    evm.sstore(
        slot: PARAMETERS_PACKED_SLOT,
        value: (checked_fee(fee) as u256) | (int24_word(checked_int24(tick_spacing)) << 24),
    )
}

fn clear_parameters() uses (evm: mut Evm) {
    evm.sstore(slot: PARAMETERS_FACTORY_SLOT, value: 0)
    evm.sstore(slot: PARAMETERS_TOKEN0_SLOT, value: 0)
    evm.sstore(slot: PARAMETERS_TOKEN1_SLOT, value: 0)
    evm.sstore(slot: PARAMETERS_PACKED_SLOT, value: 0)
}

#[arithmetic(unchecked)]
fn write_byte(ptr: u256, offset: u256, value: u256) uses (evm: mut Evm) {
    evm.mstore8(addr: ptr + offset, value: value.downcast_unchecked())
}

#[arithmetic(unchecked)]
fn write_push2(ptr: u256, offset: u256, value: u256) uses (evm: mut Evm) {
    assert(value <= 0xffff)
    write_byte(ptr, offset, value: 0x61)
    write_byte(ptr, offset: offset + 1, value: value >> 8)
    write_byte(ptr, offset: offset + 2, value: value & 0xff)
}

#[arithmetic(unchecked)]
fn write_return_code_prefix(ptr: u256, data_len: u256, data_offset: u256)
uses (evm: mut Evm)
{
    write_push2(ptr, offset: 0, value: data_len)
    write_push2(ptr, offset: 3, value: data_offset)
    write_byte(ptr, offset: 6, value: 0x60)
    write_byte(ptr, offset: 7, value: 0)
    write_byte(ptr, offset: 8, value: 0x39)
    write_push2(ptr, offset: 9, value: data_len)
    write_byte(ptr, offset: 12, value: 0x60)
    write_byte(ptr, offset: 13, value: 0)
    write_byte(ptr, offset: 14, value: 0xf3)
}

#[arithmetic(unchecked)]
fn copy_words(dest: u256, src: u256, len: u256) uses (evm: mut Evm) {
    let mut offset: u256 = 0
    while offset < len {
        evm.mstore(addr: dest + offset, value: evm.mload(src + offset))
        offset += 32
    }
}

#[arithmetic(unchecked)]
fn deploy_pool_init_code_holder(pool_init_code: Bytes) -> Address
uses (evm: mut Evm)
{
    let runtime_prefix_len = 15
    let init_prefix_len = 15
    let pool_init_len = pool_init_code.len
    let runtime_len = runtime_prefix_len + pool_init_len
    let init_len = init_prefix_len + runtime_len
    let init_ptr = std::evm::mem::alloc(init_len)

    write_return_code_prefix(
        ptr: init_ptr,
        data_len: runtime_len,
        data_offset: init_prefix_len,
    )
    let runtime_ptr = init_ptr + init_prefix_len
    write_return_code_prefix(
        ptr: runtime_ptr,
        data_len: pool_init_len,
        data_offset: runtime_prefix_len,
    )
    copy_words(
        dest: runtime_ptr + runtime_prefix_len,
        src: pool_init_code.data + 32,
        len: pool_init_len,
    )

    let holder = evm.create_raw(value: 0, offset: init_ptr, len: init_len)
    assert(holder.inner != 0)
    holder
}

fn load_pool_init_code() -> (u256, u256) uses (evm: mut Evm) {
    let holder = address_at(POOL_INIT_CODE_HOLDER_SLOT)
    assert(
        evm.raw_call(
            addr: holder,
            gas: evm.gas(),
            value: 0,
            args_offset: 0,
            args_len: 0,
        ),
    )
    let init_len = evm.returndatasize()
    let init_ptr = std::evm::mem::alloc(init_len)
    evm.returndatacopy(dest: init_ptr, offset: 0, len: init_len)
    (init_ptr, init_len)
}

fn pool_salt(token0: Address, token1: Address, fee: Uint24) -> u256
uses (evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(addr: ptr, value: token0.inner)
    evm.mstore(addr: ptr + 32, value: token1.inner)
    evm.mstore(addr: ptr + 64, value: checked_fee(fee) as u256)
    evm.keccak256(offset: ptr, len: 96)
}

fn check_not_delegate_call() uses (ctx: Ctx, evm: Evm) {
    assert(ctx.address().inner == evm.sload(ORIGINAL_SLOT))
}

fn emit_owner_changed(old_owner: Address, new_owner: Address)
uses (evm: mut Evm)
{
    evm.log3(
        offset: 0,
        len: 0,
        topic0: OWNER_CHANGED_TOPIC,
        topic1: old_owner.inner,
        topic2: new_owner.inner,
    )
}

fn emit_fee_amount_enabled(fee: Uint24, tick_spacing: Int24)
uses (evm: mut Evm)
{
    evm.log3(
        offset: 0,
        len: 0,
        topic0: FEE_AMOUNT_ENABLED_TOPIC,
        topic1: checked_fee(fee) as u256,
        topic2: int24_abi_word(checked_int24(tick_spacing)),
    )
}

fn emit_pool_created(
    token0: Address,
    token1: Address,
    fee: Uint24,
    tick_spacing: Int24,
    pool: Address,
)
uses (evm: mut Evm)
{
    let ptr = std::evm::mem::alloc(0)
    evm.mstore(
        addr: ptr,
        value: int24_abi_word(checked_int24(tick_spacing)),
    )
    evm.mstore(addr: ptr + 32, value: pool.inner)
    evm.log4(
        offset: ptr,
        len: 64,
        topic0: POOL_CREATED_TOPIC,
        topic1: token0.inner,
        topic2: token1.inner,
        topic3: checked_fee(fee) as u256,
    )
}

msg UniswapV3FactoryMsg {
    #[selector = sol("parameters()")]
    Parameters -> (u256, u256, u256, u32, i32),

    #[selector = sol("owner()")]
    Owner -> u256,

    #[selector = sol("feeAmountTickSpacing(uint24)")]
    FeeAmountTickSpacing { fee: Uint24 } -> i32,

    #[selector = sol("getPool(address,address,uint24)")]
    GetPool { tokenA: Address, tokenB: Address, fee: Uint24 } -> u256,

    #[selector = sol("createPool(address,address,uint24)")]
    CreatePool { tokenA: Address, tokenB: Address, fee: Uint24 } -> u256,

    #[selector = sol("setOwner(address)")]
    SetOwner { owner: Address },

    #[selector = sol("enableFeeAmount(uint24,int24)")]
    EnableFeeAmount { fee: Uint24, tickSpacing: Int24 },
}

pub contract UniswapV3Factory uses (ctx: Ctx, evm: mut Evm) {
    init(pool_init_code: Bytes)
    uses (ctx, mut evm)
    {
        let owner = ctx.caller()
        store_address(slot: OWNER_SLOT, value: owner)
        evm.sstore(slot: ORIGINAL_SLOT, value: ctx.address().inner)
        store_address(
            slot: POOL_INIT_CODE_HOLDER_SLOT,
            value: deploy_pool_init_code_holder(pool_init_code),
        )
        emit_owner_changed(old_owner: Address::zero(), new_owner: owner)
        set_fee_amount_tick_spacing(fee: Uint24 { val: 500 }, tick_spacing: Int24 { val: 10 })
        emit_fee_amount_enabled(fee: Uint24 { val: 500 }, tick_spacing: Int24 { val: 10 })
        set_fee_amount_tick_spacing(fee: Uint24 { val: 3000 }, tick_spacing: Int24 { val: 60 })
        emit_fee_amount_enabled(fee: Uint24 { val: 3000 }, tick_spacing: Int24 { val: 60 })
        set_fee_amount_tick_spacing(
            fee: Uint24 { val: 10000 },
            tick_spacing: Int24 { val: 200 },
        )
        emit_fee_amount_enabled(
            fee: Uint24 { val: 10000 },
            tick_spacing: Int24 { val: 200 },
        )
    }

    recv UniswapV3FactoryMsg {
        Parameters -> (u256, u256, u256, u32, i32)
        uses (evm)
        {
            (
                address_at(PARAMETERS_FACTORY_SLOT).inner,
                address_at(PARAMETERS_TOKEN0_SLOT).inner,
                address_at(PARAMETERS_TOKEN1_SLOT).inner,
                (evm.sload(PARAMETERS_PACKED_SLOT) & MASK_U24).downcast_unchecked(),
                decode_int24(evm.sload(PARAMETERS_PACKED_SLOT) >> 24),
            )
        }

        Owner -> u256 uses (evm) {
            address_at(OWNER_SLOT).inner
        }

        FeeAmountTickSpacing { fee } -> i32 uses (mut evm) {
            fee_amount_tick_spacing(fee).val
        }

        GetPool { tokenA, tokenB, fee } -> u256 uses (mut evm) {
            get_pool(token0: tokenA, token1: tokenB, fee).inner
        }

        CreatePool { tokenA, tokenB, fee } -> u256
        uses (ctx, mut evm)
        {
            check_not_delegate_call()
            assert(tokenA != tokenB)
            let (token0, token1) = if tokenA.inner < tokenB.inner {
                (tokenA, tokenB)
            } else {
                (tokenB, tokenA)
            }
            assert(token0 != Address::zero())
            let tick_spacing = fee_amount_tick_spacing(fee)
            assert(tick_spacing.val != 0)
            assert(get_pool(token0, token1, fee) == Address::zero())
            set_parameters(
                factory: ctx.address(),
                token0,
                token1,
                fee,
                tick_spacing: tick_spacing,
            )
            let (init_ptr, init_len) = load_pool_init_code()
            let pool = evm
                .create2_raw(
                    value: 0,
                    offset: init_ptr,
                    len: init_len,
                    salt: pool_salt(token0, token1, fee),
                )
            assert(pool.inner != 0)
            clear_parameters()
            set_pool(token0, token1, fee, pool)
            set_pool(token0: token1, token1: token0, fee, pool)
            emit_pool_created(token0, token1, fee, tick_spacing: tick_spacing, pool)
            pool.inner
        }

        SetOwner { owner } uses (ctx, mut evm) {
            let old_owner = address_at(OWNER_SLOT)
            assert(ctx.caller() == old_owner)
            emit_owner_changed(old_owner: old_owner, new_owner: owner)
            store_address(slot: OWNER_SLOT, value: owner)
        }

        EnableFeeAmount { fee, tickSpacing } uses (ctx, mut evm) {
            assert(ctx.caller() == address_at(OWNER_SLOT))
            assert(checked_fee(fee) < 1000000)
            let tick_spacing = checked_int24(tickSpacing)
            assert(tick_spacing > 0 && tick_spacing < 16384)
            assert(fee_amount_tick_spacing(fee).val == 0)
            set_fee_amount_tick_spacing(fee, tick_spacing: tickSpacing)
            emit_fee_amount_enabled(fee, tick_spacing: tickSpacing)
        }
    }
}
