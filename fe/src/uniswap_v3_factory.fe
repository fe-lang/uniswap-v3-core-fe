use std::evm::encode_abi_payload
use core::ptr::MemSpan
use std::abi::sol::{self, Int24, Uint24}
use std::evm::{Address, Create, Ctx, Evm, Log, StorageMap}
use super::libraries::tick_bitmap::int_key
use super::uniswap_v3_pool::UniswapV3Pool

// Full words retain the existing slots 0..4; the declared maps reserve roots 5 and 6.
struct FactoryStore {
    factory: u256,
    token0: u256,
    token1: u256,
    parameters: u256,
    owner: u256,
    fees: StorageMap<u256, u256>,
    pools: StorageMap<u256, StorageMap<u256, StorageMap<u256, u256>>>,
}

const MASK_U24: u256 = 0xffffff
const MASK_U160: u256 = 0xffffffffffffffffffffffffffffffffffffffff
const OWNER_CHANGED_TOPIC: u256 = 0xb532073b38c83145e3e5135377a08bf9aab55bc0fd7c1179cd4fb995d2a5159c
const POOL_CREATED_TOPIC: u256 = 0x783cca1c0412dd0d695e784568c96da2e9c22ff989357a2e8b1d9b2b4e6b7118
const FEE_AMOUNT_ENABLED_TOPIC: u256 = 0xc66a3fdf07232cdd185febcc6579d408c241b47ae2f9907d84be655141eeaecc

fn int24_word(_ value: i32) -> u256 {
    int_key(value as i256) & MASK_U24
}

fn int24_abi_word(_ value: i32) -> u256 {
    int_key(value as i256)
}

fn decode_int24(_ word: u256) -> i32 {
    let value = word & MASK_U24
    if (value & 0x800000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((MASK_U24 - value) + 1) & MASK_U24
    let magnitude_i: i32 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

fn fee_amount_tick_spacing(_ fee: Uint24) -> Int24 uses (store: FactoryStore) {
    Int24 { val: decode_int24(store.fees[fee.val as u256]) }
}

fn set_fee_amount_tick_spacing(fee: Uint24, tick_spacing: Int24)
uses (store: mut FactoryStore)
{
    store.fees[fee.val as u256] = int24_word(tick_spacing.val)
}

fn get_pool(token0: Address, token1: Address, fee: Uint24) -> Address
uses (store: FactoryStore)
{
    Address { inner: store.pools[token0.inner][token1.inner][fee.val as u256] & MASK_U160 }
}

fn set_pool(token0: Address, token1: Address, fee: Uint24, pool: Address)
uses (store: mut FactoryStore)
{
    store.pools[token0.inner][token1.inner][fee.val as u256] = pool.inner
}

fn set_parameters(
    factory: Address,
    token0: Address,
    token1: Address,
    fee: Uint24,
    tick_spacing: Int24,
)
uses (store: mut FactoryStore)
{
    store.factory = factory.inner
    store.token0 = token0.inner
    store.token1 = token1.inner
    store.parameters = (fee.val as u256) | (int24_word(tick_spacing.val) << 24)
}

fn clear_parameters() uses (store: mut FactoryStore) {
    store.factory = 0
    store.token0 = 0
    store.token1 = 0
    store.parameters = 0
}

fn pool_salt(token0: Address, token1: Address, fee: Uint24) -> u256
uses (evm: mut Evm)
{
    let ptr = encode_abi_payload((token0.inner, token1.inner, fee.val as u256))
    evm.keccak256(data: ptr.span().head(96))
}

fn check_not_delegate_call(_ original: Address) uses (ctx: Ctx) {
    assert(ctx.address() == original)
}

fn emit_owner_changed(old_owner: Address, new_owner: Address)
uses (evm: mut Evm)
{
    evm.log3(
        data: MemSpan::empty(),
        topic0: OWNER_CHANGED_TOPIC,
        topic1: old_owner.inner,
        topic2: new_owner.inner,
    )
}

fn emit_fee_amount_enabled(fee: Uint24, tick_spacing: Int24)
uses (evm: mut Evm)
{
    evm.log3(
        data: MemSpan::empty(),
        topic0: FEE_AMOUNT_ENABLED_TOPIC,
        topic1: fee.val as u256,
        topic2: int24_abi_word(tick_spacing.val),
    )
}

fn emit_pool_created(
    token0: Address,
    token1: Address,
    fee: Uint24,
    tick_spacing: Int24,
    pool: Address,
)
uses (evm: mut Evm)
{
    let ptr = encode_abi_payload((int24_abi_word(tick_spacing.val), pool.inner))
    evm.log4(
        data: ptr.span().head(64),
        topic0: POOL_CREATED_TOPIC,
        topic1: token0.inner,
        topic2: token1.inner,
        topic3: fee.val as u256,
    )
}

msg UniswapV3FactoryMsg {
    #[selector = sol("parameters()")]
    Parameters -> (u256, u256, u256, u32, i32),

    #[selector = sol("owner()")]
    Owner -> u256,

    #[selector = sol("feeAmountTickSpacing(uint24)")]
    FeeAmountTickSpacing { fee: Uint24 } -> i32,

    #[selector = sol("getPool(address,address,uint24)")]
    GetPool { tokenA: Address, tokenB: Address, fee: Uint24 } -> u256,

    #[selector = sol("createPool(address,address,uint24)")]
    CreatePool { tokenA: Address, tokenB: Address, fee: Uint24 } -> u256,

    #[selector = sol("setOwner(address)")]
    SetOwner { owner: Address },

    #[selector = sol("enableFeeAmount(uint24,int24)")]
    EnableFeeAmount { fee: Uint24, tickSpacing: Int24 },
}

pub contract UniswapV3Factory uses (ctx: Ctx, evm: mut Evm) {
    original: Address,
    mut store: FactoryStore,

    init()
    uses (ctx, mut evm, mut original, mut store)
    {
        original = ctx.address()
        let owner = ctx.caller()
        store.owner = owner.inner
        emit_owner_changed(old_owner: Address::zero(), new_owner: owner)
        set_fee_amount_tick_spacing(fee: Uint24 { val: 500 }, tick_spacing: Int24 { val: 10 })
        emit_fee_amount_enabled(fee: Uint24 { val: 500 }, tick_spacing: Int24 { val: 10 })
        set_fee_amount_tick_spacing(fee: Uint24 { val: 3000 }, tick_spacing: Int24 { val: 60 })
        emit_fee_amount_enabled(fee: Uint24 { val: 3000 }, tick_spacing: Int24 { val: 60 })
        set_fee_amount_tick_spacing(
            fee: Uint24 { val: 10000 },
            tick_spacing: Int24 { val: 200 },
        )
        emit_fee_amount_enabled(
            fee: Uint24 { val: 10000 },
            tick_spacing: Int24 { val: 200 },
        )
    }

    recv UniswapV3FactoryMsg {
        Parameters -> (u256, u256, u256, u32, i32)
        uses (store)
        {
            (
                store.factory & MASK_U160,
                store.token0 & MASK_U160,
                store.token1 & MASK_U160,
                (store.parameters & MASK_U24).downcast_unchecked(),
                decode_int24(store.parameters >> 24),
            )
        }

        Owner -> u256 uses (store) {
            store.owner & MASK_U160
        }

        FeeAmountTickSpacing { fee } -> i32 uses (store) {
            fee_amount_tick_spacing(fee).val
        }

        GetPool { tokenA, tokenB, fee } -> u256 uses (store) {
            get_pool(token0: tokenA, token1: tokenB, fee).inner
        }

        CreatePool { tokenA, tokenB, fee } -> u256
        uses (ctx, mut evm, original, mut store)
        {
            check_not_delegate_call(original)
            assert(tokenA != tokenB)
            let (token0, token1) = if tokenA.inner < tokenB.inner {
                (tokenA, tokenB)
            } else {
                (tokenB, tokenA)
            }
            assert(token0 != Address::zero())
            let tick_spacing = fee_amount_tick_spacing(fee)
            assert(tick_spacing.val != 0)
            assert(get_pool(token0, token1, fee) == Address::zero())
            set_parameters(
                factory: ctx.address(),
                token0,
                token1,
                fee,
                tick_spacing: tick_spacing,
            )
            let pool = evm
                .create2<UniswapV3Pool>(value: 0, args: (), salt: pool_salt(token0, token1, fee))
            assert(pool.inner != 0)
            clear_parameters()
            set_pool(token0, token1, fee, pool)
            set_pool(token0: token1, token1: token0, fee, pool)
            emit_pool_created(token0, token1, fee, tick_spacing: tick_spacing, pool)
            pool.inner
        }

        SetOwner { owner } uses (ctx, mut evm, mut store) {
            let old_owner = Address { inner: store.owner & MASK_U160 }
            assert(ctx.caller() == old_owner)
            emit_owner_changed(old_owner: old_owner, new_owner: owner)
            store.owner = owner.inner
        }

        EnableFeeAmount { fee, tickSpacing } uses (ctx, mut evm, mut store) {
            assert(ctx.caller().inner == store.owner & MASK_U160)
            assert(fee.val < 1000000)
            let tick_spacing = tickSpacing.val
            assert(tick_spacing > 0 && tick_spacing < 16384)
            assert(store.fees[fee.val as u256] == 0)
            store.fees[fee.val as u256] = int24_word(tick_spacing)
            emit_fee_amount_enabled(fee, tick_spacing: tickSpacing)
        }
    }
}
