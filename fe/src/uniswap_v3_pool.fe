struct PoolStore {
    slot0: PackedSlot0,
    observation0_block_timestamp: u32,
    observation0_tick_cumulative: i64,
    observation0_seconds_per_liquidity_cumulative_x128: u256,
    liquidity: u128,
    fee_growth_global0_x128: u256,
    fee_growth_global1_x128: u256,
    protocol_fee0: u128,
    protocol_fee1: u128,
}

#[arithmetic(unchecked)]
fn int24_abi_word(_ value: i32) -> u256 {
    int_key(value as i256)
}

#[arithmetic(unchecked)]
fn decode_int24_word(_ word: u256) -> i256 {
    signextend(byte: 2, value: word).downcast_unchecked()
}

#[arithmetic(unchecked)]
fn decode_int16_word(_ word: u256) -> i256 {
    let value = word & 0xffff
    if (value & 0x8000) == 0 {
        return value.downcast_unchecked()
    }

    let magnitude = ((0xffff - value) + 1) & 0xffff
    let magnitude_i: i256 = magnitude.downcast_unchecked()
    0 - magnitude_i
}

#[arithmetic(unchecked)]
fn require_msg(_ evm: mut Evm, condition: bool, code: u256, len: u256) {
    if !condition {
        let out = ptr::alloc_bytes(100)
        evm.mstore(addr: out, value: ERROR_STRING_SELECTOR_WORD)
        evm.mstore(addr: at(out, 4), value: 32)
        evm.mstore(addr: at(out, 36), value: len)
        evm.mstore(addr: at(out, 68), value: code)
        evm.revert(data: span(out, 100))
    }
}

#[arithmetic(unchecked)]
fn check_ticks(_ evm: mut Evm, tick_lower: i256, tick_upper: i256) {
    require_msg(
        mut evm,
        condition: tick_lower < tick_upper,
        code: MSG_TLU,
        len: 3,
    )
    require_msg(
        mut evm,
        condition: tick_lower >= MIN_TICK,
        code: MSG_TLM,
        len: 3,
    )
    require_msg(
        mut evm,
        condition: tick_upper <= MAX_TICK,
        code: MSG_TUM,
        len: 3,
    )
}

#[arithmetic(unchecked)]
fn check_unlocked(_ evm: mut Evm, _ unlocked: bool) {
    require_msg(mut evm, condition: unlocked, code: MSG_LOK, len: 3)
}

#[arithmetic(unchecked)]
fn tick_at_sqrt_ratio(sqrt_price_x96: u256) -> i32 {
    get_tick_at_sqrt_ratio(sqrt_price_x96).downcast_unchecked()
}

#[arithmetic(unchecked)]
fn current_tick_cumulative(tick_cumulative: i64, tick_current: i32, time_delta: u32) -> i256 {
    (tick_cumulative as i256) + ((tick_current as i256) * (time_delta as i256))
}

#[arithmetic(unchecked)]
fn current_seconds_per_liquidity(
    seconds_per_liquidity_cumulative_x128: u256,
    time_delta: u32,
    liquidity: u128,
) -> u256 {
    let denominator = if liquidity > 0 { liquidity as u256 } else { 1 }
    seconds_per_liquidity_cumulative_x128 + (((time_delta as u256) << 128) / denominator)
}

#[arithmetic(unchecked)]
fn current_observation(
    current_time: u32,
    block_timestamp: u32,
    tick_cumulative: i64,
    tick_current: i32,
    seconds_per_liquidity_cumulative_x128: u256,
    liquidity: u128,
) -> (i256, u256) {
    let time_delta = current_time - block_timestamp
    (
        current_tick_cumulative(tick_cumulative, tick_current, time_delta),
        current_seconds_per_liquidity(
            seconds_per_liquidity_cumulative_x128,
            time_delta,
            liquidity,
        ),
    )
}

#[arithmetic(unchecked)]
fn min_u128(_ a: u128, _ b: u128) -> u128 {
    if a < b { return a }
    b
}

#[arithmetic(unchecked)]
fn decode_u128_word(_ word: u256) -> u128 {
    assert(word <= MAX_U128_WORD)
    word.downcast_unchecked()
}

#[arithmetic(unchecked)]
fn add_u256(a: u256, b: u256) -> u256 {
    a + b
}

#[arithmetic(unchecked)]
fn sub_u256(a: u256, b: u256) -> u256 {
    a - b
}

#[arithmetic(unchecked)]
fn sub_i256(a: i256, b: i256) -> i256 {
    a - b
}

#[arithmetic(unchecked)]
fn sub_u32(a: u32, b: u32) -> u32 {
    a - b
}

#[arithmetic(unchecked)]
fn next_sqrt_price_amount0_add(sqrt_p_x96: u256, _ liquidity: u128, amount: u256) -> u256 {
    if amount == 0 {
        return sqrt_p_x96
    }

    let numerator1 = (liquidity as u256) << 96
    let product = amount * sqrt_p_x96
    if product / amount == sqrt_p_x96 {
        let denominator = numerator1 + product
        if denominator >= numerator1 {
            return mul_div_rounding_up(numerator1, sqrt_p_x96, denominator)
        }
    }

    let quotient = numerator1 / sqrt_p_x96
    assert(amount <= U256_MAX - quotient)
    div_rounding_up(numerator: numerator1, denominator: quotient + amount)
}

#[arithmetic(unchecked)]
fn next_sqrt_price_amount1_add(sqrt_p_x96: u256, _ liquidity: u128, amount: u256) -> u256 {
    let quotient = if amount <= MAX_U160_WORD {
        (amount << 96) / (liquidity as u256)
    } else {
        mul_div(amount, Q96, denominator: liquidity as u256)
    }
    sqrt_p_x96 + quotient
}

#[arithmetic(unchecked)]
fn next_sqrt_price_amount0_sub(sqrt_p_x96: u256, _ liquidity: u128, amount: u256) -> u256 {
    let numerator1 = (liquidity as u256) << 96
    let product = amount * sqrt_p_x96
    assert(product / amount == sqrt_p_x96 && numerator1 > product)
    mul_div_rounding_up(numerator1, sqrt_p_x96, denominator: numerator1 - product)
}

#[arithmetic(unchecked)]
fn next_sqrt_price_amount1_sub(sqrt_p_x96: u256, _ liquidity: u128, amount: u256) -> u256 {
    let quotient = if amount <= MAX_U160_WORD {
        div_rounding_up(numerator: amount << 96, denominator: liquidity as u256)
    } else {
        mul_div_rounding_up(amount, Q96, denominator: liquidity as u256)
    }
    assert(sqrt_p_x96 > quotient)
    sqrt_p_x96 - quotient
}

fn balance_of(token: Address, account: Address) -> u256
uses (call: mut Call, evm: mut Evm)
{
    let args = ptr::alloc_bytes(36)
    evm.mstore(addr: args, value: (0x70a08231 as u256) << 224)
    evm.mstore(addr: at(args, 4), value: account.inner)
    let mut ret = MemBuffer::with_capacity(32)
    let outcome = call.raw_staticcall(
            addr: token,
            gas: 1000000,
            args: span(args, 36),
            ret: mut ret,
        )
    assert(outcome.success() && outcome.returndata_len() >= 32)
    evm.mload(ret.ptr())
}

#[arithmetic(unchecked)]
fn factory_owner(factory: Address) -> u256 uses (call: mut Call, evm: mut Evm) {
    let args = ptr::alloc_bytes(32)
    evm.mstore(addr: args, value: (0x8da5cb5b as u256) << 224)
    let mut ret = MemBuffer::with_capacity(32)
    let outcome = call
        .raw_staticcall(
            addr: factory,
            gas: evm.gas(),
            args: span(args, 4),
            ret: mut ret,
        )
    assert(outcome.success() && outcome.returndata_len() >= 32)
    evm.mload(ret.ptr())
}

#[arithmetic(unchecked)]
fn load_deployer_parameters(deployer: Address) -> (Address, Address, Address, u32, i32)
uses (call: mut Call, evm: mut Evm)
{
    let args = ptr::alloc_bytes(32)
    evm.mstore(addr: args, value: (0x89035730 as u256) << 224)
    let mut ret = MemBuffer::with_capacity(160)
    let outcome = call
        .raw_staticcall(
            addr: deployer,
            gas: evm.gas(),
            args: span(args, 4),
            ret: mut ret,
        )
    assert(outcome.success() && outcome.returndata_len() >= 160)
    let ptr = ret.ptr()
    (
        Address { inner: evm.mload(ptr) },
        Address { inner: evm.mload(at(ptr, 32)) },
        Address { inner: evm.mload(at(ptr, 64)) },
        evm.mload(at(ptr, 96)).downcast_unchecked(),
        decode_int24_word(evm.mload(at(ptr, 128))).downcast_unchecked(),
    )
}

#[arithmetic(unchecked)]
fn compact_transfer(token: Address, to: Address, value: u256)
uses (evm: mut Evm)
{
    let ptr = ptr::alloc_bytes(68)
    evm.mstore(addr: ptr, value: (0xa9059cbb as u256) << 224)
    evm.mstore(addr: at(ptr, 4), value: to.inner)
    evm.mstore(addr: at(ptr, 36), value)

    let mut ret = MemBuffer::with_capacity(32)
    let outcome = evm
        .raw_call(
            addr: token,
            gas: evm.gas(),
            value: 0,
            args: span(ptr, 68),
            ret: mut ret,
        )
    let ret_len = outcome.returndata_len()
    assert(outcome.success())
    if ret_len >= 32 {
        assert(evm.mload(ret.ptr()) != 0)
    } else {
        assert(ret_len == 0)
    }
}

#[arithmetic(unchecked)]
#[inline(never)]
fn modify_position(
    owner: Address,
    tick_lower: i256,
    tick_upper: i256,
    liquidity_delta: i128,
    pool_config: u256,
) -> (u256, u256)
uses (evm: mut Evm, store: mut PoolStore)
{
    check_ticks(mut evm, tick_lower, tick_upper: tick_upper)

    let slot0 = store.slot0
    let tick_current_i = slot0.tick() as i256
    let fee_growth_global0_x128 = store.fee_growth_global0_x128
    let fee_growth_global1_x128 = store.fee_growth_global1_x128

    let mut current_time: u32 = 0
    let mut tick_cumulative: i256 = 0
    let mut seconds_per_liquidity_cumulative_x128: u256 = 0
    let mut liquidity_before: u128 = 0
    let mut flipped_lower = false
    let mut flipped_upper = false
    if liquidity_delta != 0 {
        let pool_config = pool_config
        let tick_spacing = config_tick_spacing(pool_config) as i256
        let max_liquidity = config_max_liquidity(pool_config)
        liquidity_before = store.liquidity
        current_time = evm.timestamp().downcast_unchecked()
        let time_delta = current_time - store.observation0_block_timestamp
        tick_cumulative = current_tick_cumulative(
            tick_cumulative: store.observation0_tick_cumulative,
            tick_current: slot0.tick(),
            time_delta,
        )
        seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
            seconds_per_liquidity_cumulative_x128: store
                .observation0_seconds_per_liquidity_cumulative_x128,
            time_delta,
            liquidity: liquidity_before,
        )
        flipped_lower = tick::update_at(
            tick: tick_lower,
            tick_current: tick_current_i,
            liquidity_delta,
            fee_growth_global0_x128,
            fee_growth_global1_x128,
            seconds_per_liquidity_cumulative_x128,
            tick_cumulative,
            time: current_time,
            upper: false,
            max_liquidity,
            ticks_slot: TICKS_SLOT,
        )
        flipped_upper = tick::update_at(
            tick: tick_upper,
            tick_current: tick_current_i,
            liquidity_delta,
            fee_growth_global0_x128,
            fee_growth_global1_x128,
            seconds_per_liquidity_cumulative_x128,
            tick_cumulative,
            time: current_time,
            upper: true,
            max_liquidity,
            ticks_slot: TICKS_SLOT,
        )

        if flipped_lower {
            flip_tick_at(
                tick: tick_lower,
                tick_spacing,
                bitmap_slot: TICK_BITMAP_SLOT,
            )
        }
        if flipped_upper {
            flip_tick_at(
                tick: tick_upper,
                tick_spacing,
                bitmap_slot: TICK_BITMAP_SLOT,
            )
        }
    }

    let (fee_growth_inside0_x128, fee_growth_inside1_x128) = tick::get_fee_growth_inside_at(
        tick_lower,
        tick_upper,
        tick_current: tick_current_i,
        fee_growth_global0_x128,
        fee_growth_global1_x128,
        ticks_slot: TICKS_SLOT,
    )
    let position_slot = position::position_slot(
        owner,
        tick_lower,
        tick_upper,
        positions_slot: POSITIONS_SLOT,
    )

    let mut amount0: u256 = 0
    let mut amount1: u256 = 0
    let in_range = tick_current_i >= tick_lower && tick_current_i < tick_upper
    if liquidity_delta != 0 {
        let amount: u128 = if liquidity_delta < 0 {
            (0 - (liquidity_delta as i256)).downcast_unchecked()
        } else {
            liquidity_delta.downcast_unchecked()
        }
        let round_up = liquidity_delta > 0
        let sqrt_ratio_lower_x96 = get_sqrt_ratio_at_tick(tick: tick_lower)
        let sqrt_ratio_upper_x96 = get_sqrt_ratio_at_tick(tick: tick_upper)
        amount0 = if tick_current_i < tick_lower {
            get_amount0_delta(
                sqrt_ratio_a_x96: sqrt_ratio_lower_x96,
                sqrt_ratio_b_x96: sqrt_ratio_upper_x96,
                amount,
                round_up,
            )
        } else if tick_current_i < tick_upper {
            get_amount0_delta(
                sqrt_ratio_a_x96: slot0.sqrt_price_x96(),
                sqrt_ratio_b_x96: sqrt_ratio_upper_x96,
                amount,
                round_up,
            )
        } else {
            0
        }
        amount1 = if tick_current_i < tick_lower {
            0
        } else if tick_current_i < tick_upper {
            get_amount1_delta(
                sqrt_ratio_a_x96: sqrt_ratio_lower_x96,
                sqrt_ratio_b_x96: slot0.sqrt_price_x96(),
                amount,
                round_up,
            )
        } else {
            get_amount1_delta(
                sqrt_ratio_a_x96: sqrt_ratio_lower_x96,
                sqrt_ratio_b_x96: sqrt_ratio_upper_x96,
                amount,
                round_up,
            )
        }
    }

    let principal_owed0_delta: u128 = if liquidity_delta < 0 {
        amount0.downcast_unchecked()
    } else {
        0
    }
    let principal_owed1_delta: u128 = if liquidity_delta < 0 {
        amount1.downcast_unchecked()
    } else {
        0
    }
    position::update(
        base_slot: position_slot,
        liquidity_delta,
        fee_growth_inside0_x128,
        fee_growth_inside1_x128,
        principal_owed0_delta,
        principal_owed1_delta,
    )

    if liquidity_delta < 0 {
        if flipped_lower {
            tick::clear_at(tick: tick_lower, ticks_slot: TICKS_SLOT)
        }
        if flipped_upper {
            tick::clear_at(tick: tick_upper, ticks_slot: TICKS_SLOT)
        }
    }

    if liquidity_delta != 0 && in_range {
        store.observation0_block_timestamp = current_time
        store.observation0_tick_cumulative = tick_cumulative.downcast_unchecked()
        store
            .observation0_seconds_per_liquidity_cumulative_x128 = seconds_per_liquidity_cumulative_x128
        store.liquidity = add_delta(liquidity_before, liquidity_delta)
    }

    (amount0, amount1)
}

#[arithmetic(unchecked)]
fn call_swap_step(
    sqrt_ratio_current_x96: u256,
    sqrt_ratio_target_x96: u256,
    liquidity: u128,
    amount_remaining: u256,
    fee_pips: u256,
) -> (u256, u256, u256, u256) {
    let zero_for_one = sqrt_ratio_current_x96 >= sqrt_ratio_target_x96
    let exact_input = amount_remaining <= MAX_I256_WORD
    let amount_remaining_abs = if exact_input {
        amount_remaining
    } else {
        sub_u256(a: 0, b: amount_remaining)
    }
    let mut amount_in: u256 = 0
    let mut amount_out: u256 = 0
    let mut sqrt_ratio_next_x96: u256 = 0
    if exact_input {
        let amount_remaining_less_fee = mul_div(
            amount_remaining_abs,
            1000000 - fee_pips,
            denominator: 1000000,
        )
        amount_in = if zero_for_one {
            get_amount0_delta(
                sqrt_ratio_a_x96: sqrt_ratio_target_x96,
                sqrt_ratio_b_x96: sqrt_ratio_current_x96,
                liquidity,
                round_up: true,
            )
        } else {
            get_amount1_delta(
                sqrt_ratio_a_x96: sqrt_ratio_current_x96,
                sqrt_ratio_b_x96: sqrt_ratio_target_x96,
                liquidity,
                round_up: true,
            )
        }
        sqrt_ratio_next_x96 = if amount_remaining_less_fee >= amount_in {
            sqrt_ratio_target_x96
        } else if zero_for_one {
            next_sqrt_price_amount0_add(
                sqrt_p_x96: sqrt_ratio_current_x96,
                liquidity,
                amount: amount_remaining_less_fee,
            )
        } else {
            next_sqrt_price_amount1_add(
                sqrt_p_x96: sqrt_ratio_current_x96,
                liquidity,
                amount: amount_remaining_less_fee,
            )
        }
    } else {
        amount_out = if zero_for_one {
            get_amount1_delta(
                sqrt_ratio_a_x96: sqrt_ratio_target_x96,
                sqrt_ratio_b_x96: sqrt_ratio_current_x96,
                liquidity,
                round_up: false,
            )
        } else {
            get_amount0_delta(
                sqrt_ratio_a_x96: sqrt_ratio_current_x96,
                sqrt_ratio_b_x96: sqrt_ratio_target_x96,
                liquidity,
                round_up: false,
            )
        }
        sqrt_ratio_next_x96 = if amount_remaining_abs >= amount_out {
            sqrt_ratio_target_x96
        } else if zero_for_one {
            next_sqrt_price_amount1_sub(
                sqrt_p_x96: sqrt_ratio_current_x96,
                liquidity,
                amount: amount_remaining_abs,
            )
        } else {
            next_sqrt_price_amount0_sub(
                sqrt_p_x96: sqrt_ratio_current_x96,
                liquidity,
                amount: amount_remaining_abs,
            )
        }
    }
    let max = sqrt_ratio_next_x96 == sqrt_ratio_target_x96
    amount_in = if max && exact_input {
        amount_in
    } else if zero_for_one {
        get_amount0_delta(
            sqrt_ratio_a_x96: sqrt_ratio_next_x96,
            sqrt_ratio_b_x96: sqrt_ratio_current_x96,
            liquidity,
            round_up: true,
        )
    } else {
        get_amount1_delta(
            sqrt_ratio_a_x96: sqrt_ratio_current_x96,
            sqrt_ratio_b_x96: sqrt_ratio_next_x96,
            liquidity,
            round_up: true,
        )
    }
    amount_out = if max && !exact_input {
        amount_out
    } else if zero_for_one {
        get_amount1_delta(
            sqrt_ratio_a_x96: sqrt_ratio_next_x96,
            sqrt_ratio_b_x96: sqrt_ratio_current_x96,
            liquidity,
            round_up: false,
        )
    } else {
        get_amount0_delta(
            sqrt_ratio_a_x96: sqrt_ratio_current_x96,
            sqrt_ratio_b_x96: sqrt_ratio_next_x96,
            liquidity,
            round_up: false,
        )
    }
    if !exact_input && amount_out > amount_remaining_abs {
        amount_out = amount_remaining_abs
    }
    let fee_amount = if exact_input && sqrt_ratio_next_x96 != sqrt_ratio_target_x96 {
        sub_u256(a: amount_remaining_abs, b: amount_in)
    } else {
        mul_div_rounding_up(amount_in, fee_pips, denominator: 1000000 - fee_pips)
    }
    (sqrt_ratio_next_x96, amount_in, amount_out, fee_amount)
}

#[arithmetic(unchecked)]
fn mint_callback_calldata(caller: Address, amount0: u256, amount1: u256, data_start: u256)
uses (call: mut Call, evm: mut Evm)
{
    let data_len = evm.calldataload(data_start)
    let data_size = 32 + (((data_len + 31) / 32) * 32)
    let len = 100 + data_size
    let mut buf = MemBuffer::alloc(len)
    let ptr = buf.ptr()
    evm.mstore(addr: ptr, value: (0xd3487997 as u256) << 224)
    evm.mstore(addr: at(ptr, 4), value: amount0)
    evm.mstore(addr: at(ptr, 36), value: amount1)
    evm.mstore(addr: at(ptr, 68), value: 96)
    evm.calldatacopy(
        dest: mut buf,
        dest_offset: 100,
        src_offset: data_start,
        len: data_size,
    )
    let mut ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: caller,
            gas: evm.gas(),
            value: 0,
            args: buf.span(),
            ret: mut ret,
        )
    if !outcome.success() {
        bubble_last_revert()
    }
}

#[arithmetic(unchecked)]
fn flash_callback(caller: Address, fee0: u256, fee1: u256, data_start: u256)
uses (call: mut Call, evm: mut Evm)
{
    let mut buf = MemBuffer::alloc(228)
    let ptr = buf.ptr()
    evm.mstore(addr: ptr, value: FLASH_CALLBACK_SELECTOR << 224)
    evm.mstore(addr: at(ptr, 4), value: fee0)
    evm.mstore(addr: at(ptr, 36), value: fee1)
    evm.mstore(addr: at(ptr, 68), value: 96)
    evm.mstore(addr: at(ptr, 100), value: 96)
    evm.calldatacopy(
        dest: mut buf,
        dest_offset: 132,
        src_offset: data_start + 32,
        len: 96,
    )
    let mut ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: caller,
            gas: evm.gas(),
            value: 0,
            args: buf.span(),
            ret: mut ret,
        )
    if !outcome.success() {
        bubble_last_revert()
    }
}

#[arithmetic(unchecked)]
fn swap_callback_calldata(
    caller: Address,
    amount0_delta: u256,
    amount1_delta: u256,
    data_start: u256,
)
uses (call: mut Call, evm: mut Evm)
{
    let data_len = evm.calldataload(data_start)
    let data_size = 32 + (((data_len + 31) / 32) * 32)
    let len = 100 + data_size
    let mut buf = MemBuffer::alloc(len)
    let ptr = buf.ptr()
    evm.mstore(addr: ptr, value: SWAP_CALLBACK_SELECTOR << 224)
    evm.mstore(addr: at(ptr, 4), value: amount0_delta)
    evm.mstore(addr: at(ptr, 36), value: amount1_delta)
    evm.mstore(addr: at(ptr, 68), value: 96)
    evm.calldatacopy(
        dest: mut buf,
        dest_offset: 100,
        src_offset: data_start,
        len: data_size,
    )
    let mut ret = MemBuffer::empty()
    let outcome = call
        .raw_call(
            addr: caller,
            gas: evm.gas(),
            value: 0,
            args: buf.span(),
            ret: mut ret,
        )
    if !outcome.success() {
        bubble_last_revert()
    }
}

#[arithmetic(unchecked)]
fn emit_initialize(sqrt_price_x96: u256, tick: i32) uses (evm: mut Evm) {
    let out = ptr::alloc_bytes(64)
    evm.mstore(addr: out, value: sqrt_price_x96)
    evm.mstore(addr: at(out, 32), value: int24_abi_word(tick))
    evm.log1(data: span(out, 64), topic0: INITIALIZE_TOPIC)
}

#[arithmetic(unchecked)]
fn emit_increase_observation_cardinality_next(old: u16, new: u16)
uses (evm: mut Evm)
{
    let out = ptr::alloc_bytes(64)
    evm.mstore(addr: out, value: old as u256)
    evm.mstore(addr: at(out, 32), value: new as u256)
    evm.log1(
        data: span(out, 64),
        topic0: INCREASE_OBSERVATION_CARDINALITY_NEXT_TOPIC,
    )
}

#[arithmetic(unchecked)]
fn emit_mint(
    sender: Address,
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    let ptr = ptr::alloc_bytes(128)
    evm.mstore(addr: ptr, value: sender.inner)
    evm.mstore(addr: at(ptr, 32), value: amount as u256)
    evm.mstore(addr: at(ptr, 64), value: amount0)
    evm.mstore(addr: at(ptr, 96), value: amount1)
    evm.log4(
        data: span(ptr, 128),
        topic0: MINT_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

#[arithmetic(unchecked)]
fn emit_burn(
    owner: Address,
    tick_lower: i32,
    tick_upper: i32,
    amount: u128,
    amount0: u256,
    amount1: u256,
)
uses (evm: mut Evm)
{
    let ptr = ptr::alloc_bytes(96)
    evm.mstore(addr: ptr, value: amount as u256)
    evm.mstore(addr: at(ptr, 32), value: amount0)
    evm.mstore(addr: at(ptr, 64), value: amount1)
    evm.log4(
        data: span(ptr, 96),
        topic0: BURN_TOPIC,
        topic1: owner.inner,
        topic2: int24_abi_word(tick_lower),
        topic3: int24_abi_word(tick_upper),
    )
}

#[arithmetic(unchecked)]
fn emit_flash(
    sender: Address,
    recipient: Address,
    amount0: u256,
    amount1: u256,
    paid0: u256,
    paid1: u256,
)
uses (evm: mut Evm)
{
    let ptr = ptr::alloc_bytes(128)
    evm.mstore(addr: ptr, value: amount0)
    evm.mstore(addr: at(ptr, 32), value: amount1)
    evm.mstore(addr: at(ptr, 64), value: paid0)
    evm.mstore(addr: at(ptr, 96), value: paid1)
    evm.log3(
        data: span(ptr, 128),
        topic0: FLASH_TOPIC,
        topic1: sender.inner,
        topic2: recipient.inner,
    )
}

#[arithmetic(unchecked)]
fn return_snapshot(
    tick_cumulative_inside: i256,
    seconds_per_liquidity_inside_x128: u256,
    seconds_inside: u32,
) -> !
uses (evm: mut Evm)
{
    let out = ptr::alloc_bytes(96)
    evm.mstore(addr: out, value: int_key(tick_cumulative_inside))
    evm.mstore(
        addr: at(out, 32),
        value: seconds_per_liquidity_inside_x128,
    )
    evm.mstore(addr: at(out, 64), value: seconds_inside as u256)
    evm.return_data(data: span(out, 96))
}

#[arithmetic(unchecked)]
fn return_pair(amount0: u256, amount1: u256) -> ! uses (evm: mut Evm) {
    let out = ptr::alloc_bytes(64)
    evm.mstore(addr: out, value: amount0)
    evm.mstore(addr: at(out, 32), value: amount1)
    evm.return_data(data: span(out, 64))
}

#[arithmetic(unchecked)]
fn return_word(value: u256) -> ! uses (evm: mut Evm) {
    let out = ptr::alloc_bytes(32)
    evm.mstore(addr: out, value)
    evm.return_data(data: span(out, 32))
}

#[arithmetic(unchecked)]
fn return_slot0(
    sqrt_price_x96: u256,
    tick: i32,
    observation_index: u16,
    observation_cardinality: u16,
    observation_cardinality_next: u16,
    fee_protocol: u8,
    unlocked: bool,
) -> !
uses (evm: mut Evm)
{
    let out = ptr::alloc_bytes(224)
    evm.mstore(addr: out, value: sqrt_price_x96)
    evm.mstore(addr: at(out, 32), value: int_key(tick as i256))
    evm.mstore(addr: at(out, 64), value: observation_index as u256)
    evm.mstore(addr: at(out, 96), value: observation_cardinality as u256)
    evm.mstore(
        addr: at(out, 128),
        value: observation_cardinality_next as u256,
    )
    evm.mstore(addr: at(out, 160), value: fee_protocol as u256)
    evm.mstore(addr: at(out, 192), value: if unlocked { 1 } else { 0 })
    evm.return_data(data: span(out, 224))
}

#[arithmetic(unchecked)]
fn return_observation(
    block_timestamp: u32,
    tick_cumulative: i64,
    seconds_per_liquidity_cumulative_x128: u256,
    initialized: bool,
) -> !
uses (evm: mut Evm)
{
    let out = ptr::alloc_bytes(128)
    evm.mstore(addr: out, value: block_timestamp as u256)
    evm.mstore(addr: at(out, 32), value: int_key(tick_cumulative as i256))
    evm.mstore(
        addr: at(out, 64),
        value: seconds_per_liquidity_cumulative_x128,
    )
    evm.mstore(addr: at(out, 96), value: if initialized { 1 } else { 0 })
    evm.return_data(data: span(out, 128))
}

#[arithmetic(unchecked)]
fn return_tick_info(
    liquidity_gross: u128,
    liquidity_net: i128,
    fee_growth_outside0_x128: u256,
    fee_growth_outside1_x128: u256,
    tick_cumulative_outside: i256,
    seconds_per_liquidity_outside_x128: u256,
    seconds_outside: u32,
    initialized: bool,
) -> !
uses (evm: mut Evm)
{
    let out = ptr::alloc_bytes(256)
    evm.mstore(addr: out, value: liquidity_gross as u256)
    evm.mstore(addr: at(out, 32), value: int_key(liquidity_net as i256))
    evm.mstore(addr: at(out, 64), value: fee_growth_outside0_x128)
    evm.mstore(addr: at(out, 96), value: fee_growth_outside1_x128)
    evm.mstore(
        addr: at(out, 128),
        value: int_key(tick_cumulative_outside),
    )
    evm.mstore(
        addr: at(out, 160),
        value: seconds_per_liquidity_outside_x128,
    )
    evm.mstore(addr: at(out, 192), value: seconds_outside as u256)
    evm.mstore(addr: at(out, 224), value: if initialized { 1 } else { 0 })
    evm.return_data(data: span(out, 256))
}

#[arithmetic(unchecked)]
fn return_position_info(
    liquidity_value: u128,
    fee_growth_inside0_last_x128: u256,
    fee_growth_inside1_last_x128: u256,
    tokens_owed0: u128,
    tokens_owed1: u128,
) -> !
uses (evm: mut Evm)
{
    let out = ptr::alloc_bytes(160)
    evm.mstore(addr: out, value: liquidity_value as u256)
    evm.mstore(addr: at(out, 32), value: fee_growth_inside0_last_x128)
    evm.mstore(addr: at(out, 64), value: fee_growth_inside1_last_x128)
    evm.mstore(addr: at(out, 96), value: tokens_owed0 as u256)
    evm.mstore(addr: at(out, 128), value: tokens_owed1 as u256)
    evm.return_data(data: span(out, 160))
}

pub contract UniswapV3Pool uses (ctx: Ctx, call: mut Call, evm: mut Evm) {
    factory: Address,
    token0: Address,
    token1: Address,
    pool_config: u256,
    mut store: PoolStore,

    init()
    uses (ctx, mut call, mut evm, mut factory, mut token0, mut token1, mut pool_config)
    {
        let (
            deployer_factory,
            deployer_token0,
            deployer_token1,
            fee,
            tick_spacing,
        ) = load_deployer_parameters(deployer: ctx.caller())
        factory = deployer_factory
        token0 = deployer_token0
        token1 = deployer_token1
        pool_config = pack_config(
            fee,
            tick_spacing,
            max_liquidity: tick_spacing_to_max_liquidity_per_tick(tick_spacing as i256),
        )
    }

    recv UniswapV3PoolMsg {
        Factory uses (mut evm, factory) {
            return_word(value: factory.inner)
        }

        Token0 uses (mut evm, token0) {
            return_word(value: token0.inner)
        }

        Token1 uses (mut evm, token1) {
            return_word(value: token1.inner)
        }

        Fee uses (mut evm, pool_config) {
            return_word(value: config_fee(pool_config) as u256)
        }

        TickSpacing uses (mut evm, pool_config) {
            return_word(value: int_key(config_tick_spacing(pool_config) as i256))
        }

        MaxLiquidityPerTick uses (mut evm, pool_config) {
            return_word(value: config_max_liquidity(pool_config) as u256)
        }

        Slot0 uses (store, mut evm) {
            let slot0 = store.slot0
            return_slot0(
                sqrt_price_x96: slot0.sqrt_price_x96(),
                tick: slot0.tick(),
                observation_index: slot0.observation_index(),
                observation_cardinality: slot0.observation_cardinality(),
                observation_cardinality_next: slot0.observation_cardinality_next(),
                fee_protocol: slot0.fee_protocol(),
                unlocked: slot0.unlocked(),
            )
        }

        Observations uses (store, mut evm) {
            if evm.calldataload(4) == 0 {
                return_observation(
                    block_timestamp: store.observation0_block_timestamp,
                    tick_cumulative: store.observation0_tick_cumulative,
                    seconds_per_liquidity_cumulative_x128: store
                        .observation0_seconds_per_liquidity_cumulative_x128,
                    initialized: true,
                )
            }
            return_observation(
                block_timestamp: 0,
                tick_cumulative: 0,
                seconds_per_liquidity_cumulative_x128: 0,
                initialized: false,
            )
        }

        Initialize uses (mut store, mut evm) {
            let sqrt_price_x96 = evm.calldataload(4)
            assert(!store.slot0.is_initialized())
            require_msg(
                mut evm,
                condition: sqrt_price_x96 >= min_sqrt_ratio() && sqrt_price_x96 < max_sqrt_ratio(),
                code: MSG_R,
                len: 1,
            )
            let tick = tick_at_sqrt_ratio(sqrt_price_x96)
            store.slot0 = PackedSlot0::initialized(sqrt_price_x96, tick)
            store.observation0_block_timestamp = evm.timestamp().downcast_unchecked()
            store.observation0_tick_cumulative = 0
            store.observation0_seconds_per_liquidity_cumulative_x128 = 0
            emit_initialize(sqrt_price_x96, tick)
        }

        IncreaseObservationCardinalityNext uses (mut store, mut evm) {
            let word = evm.calldataload(4)
            assert(word <= 0xffff)
            let observation_cardinality_next: u16 = word.downcast_unchecked()
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()
            let old = slot0.observation_cardinality_next()
            let new = if observation_cardinality_next > old {
                observation_cardinality_next
            } else {
                old
            }
            store.slot0 = store.slot0.with_observation_cardinality_next(new)
            if old != new {
                emit_increase_observation_cardinality_next(old, new)
            }
            store.slot0 = store.slot0.unlock()
        }
        FeeGrowthGlobal0X128 uses (store, mut evm) {
            return_word(value: store.fee_growth_global0_x128)
        }

        FeeGrowthGlobal1X128 uses (store, mut evm) {
            return_word(value: store.fee_growth_global1_x128)
        }

        Liquidity uses (store, mut evm) {
            return_word(value: store.liquidity as u256)
        }

        ProtocolFees uses (store, mut evm) {
            return_pair(
                amount0: store.protocol_fee0 as u256,
                amount1: store.protocol_fee1 as u256,
            )
        }

        SnapshotCumulativesInside uses (mut evm, store) {
            let lower = decode_int24_word(evm.calldataload(4))
            let upper = decode_int24_word(evm.calldataload(36))
            check_ticks(mut evm, tick_lower: lower, tick_upper: upper)

            let (
                _,
                _,
                _,
                _,
                tick_cumulative_lower,
                seconds_per_liquidity_outside_lower,
                seconds_outside_lower,
                initialized_lower,
            ) = tick::read_tick_at(lower, ticks_slot: TICKS_SLOT)
            assert(initialized_lower)
            let (
                _,
                _,
                _,
                _,
                tick_cumulative_upper,
                seconds_per_liquidity_outside_upper,
                seconds_outside_upper,
                initialized_upper,
            ) = tick::read_tick_at(upper, ticks_slot: TICKS_SLOT)
            assert(initialized_upper)

            let slot0 = store.slot0
            let tick_current = slot0.tick() as i256
            let mut tick_cumulative_inside = 0
            let mut seconds_per_liquidity_inside_x128 = 0
            let mut seconds_inside: u32 = 0
            if tick_current < lower {
                tick_cumulative_inside = sub_i256(
                    a: tick_cumulative_lower,
                    b: tick_cumulative_upper,
                )
                seconds_per_liquidity_inside_x128 = sub_u256(
                    a: seconds_per_liquidity_outside_lower,
                    b: seconds_per_liquidity_outside_upper,
                )
                seconds_inside = sub_u32(a: seconds_outside_lower, b: seconds_outside_upper)
            } else if tick_current < upper {
                let current_time: u32 = evm.timestamp().downcast_unchecked()
                let time_delta = current_time - store.observation0_block_timestamp
                let tick_cumulative = current_tick_cumulative(
                    tick_cumulative: store.observation0_tick_cumulative,
                    tick_current: slot0.tick(),
                    time_delta,
                )
                let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                    seconds_per_liquidity_cumulative_x128: store
                        .observation0_seconds_per_liquidity_cumulative_x128,
                    time_delta,
                    liquidity: store.liquidity,
                )
                let seconds_per_liquidity_inside_minus_lower = sub_u256(
                    a: seconds_per_liquidity_cumulative_x128,
                    b: seconds_per_liquidity_outside_lower,
                )
                seconds_per_liquidity_inside_x128 = sub_u256(
                    a: seconds_per_liquidity_inside_minus_lower,
                    b: seconds_per_liquidity_outside_upper,
                )
                seconds_inside = sub_u32(
                    a: sub_u32(a: current_time, b: seconds_outside_lower),
                    b: seconds_outside_upper,
                )
                let tick_cumulative_inside_minus_lower = sub_i256(
                    a: tick_cumulative,
                    b: tick_cumulative_lower,
                )
                tick_cumulative_inside = sub_i256(
                    a: tick_cumulative_inside_minus_lower,
                    b: tick_cumulative_upper,
                )
            } else {
                tick_cumulative_inside = sub_i256(
                    a: tick_cumulative_upper,
                    b: tick_cumulative_lower,
                )
                seconds_per_liquidity_inside_x128 = sub_u256(
                    a: seconds_per_liquidity_outside_upper,
                    b: seconds_per_liquidity_outside_lower,
                )
                seconds_inside = sub_u32(a: seconds_outside_upper, b: seconds_outside_lower)
            }
            return_snapshot(
                tick_cumulative_inside,
                seconds_per_liquidity_inside_x128,
                seconds_inside,
            )
        }

        SetFeeProtocol uses (ctx, mut call, mut evm, mut store, factory) {
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()
            assert(evm.calldatasize() >= 68)
            let fee0_word = evm.calldataload(4)
            let fee1_word = evm.calldataload(36)
            assert(fee0_word <= 255)
            assert(fee1_word <= 255)
            let feeProtocol0: u8 = fee0_word.downcast_unchecked()
            let feeProtocol1: u8 = fee1_word.downcast_unchecked()
            assert(ctx.caller().inner == factory_owner(factory: factory))
            let fee_mask = ((1 as u256) << (feeProtocol0 as u256))
                | ((1 as u256) << (feeProtocol1 as u256))
            assert((fee_mask & 0x7f1) == fee_mask)

            let old = slot0.fee_protocol()
            let fee_protocol: u8 = ((feeProtocol0 as u256) | ((feeProtocol1 as u256) << 4))
                .downcast_unchecked()
            store.slot0 = store.slot0.with_fee_protocol(fee_protocol)
            let log_data = ptr::alloc_bytes(128)
            evm.mstore(addr: log_data, value: (old & 0x0f) as u256)
            evm.mstore(addr: at(log_data, 32), value: (old >> 4) as u256)
            evm.mstore(addr: at(log_data, 64), value: feeProtocol0 as u256)
            evm.mstore(addr: at(log_data, 96), value: feeProtocol1 as u256)
            evm.log1(data: span(log_data, 128), topic0: SET_FEE_PROTOCOL_TOPIC)
            store.slot0 = store.slot0.unlock()
        }

        CollectProtocol uses (ctx, mut call, mut evm, mut store, factory, token0, token1) {
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()
            assert(ctx.caller().inner == factory_owner(factory: factory))

            let recipient = Address { inner: evm.calldataload(4) }
            let amount0_requested = decode_u128_word(evm.calldataload(36))
            let amount1_requested = decode_u128_word(evm.calldataload(68))
            let mut amount0 = min_u128(a: amount0_requested, b: store.protocol_fee0)
            let mut amount1 = min_u128(a: amount1_requested, b: store.protocol_fee1)

            if amount0 > 0 {
                if amount0 == store.protocol_fee0 {
                    amount0 -= 1
                }
                store.protocol_fee0 -= amount0
                compact_transfer(token: token0, to: recipient, value: amount0 as u256)
            }
            if amount1 > 0 {
                if amount1 == store.protocol_fee1 {
                    amount1 -= 1
                }
                store.protocol_fee1 -= amount1
                compact_transfer(token: token1, to: recipient, value: amount1 as u256)
            }

            let out = ptr::alloc_bytes(64)
            evm.mstore(addr: out, value: amount0 as u256)
            evm.mstore(addr: at(out, 32), value: amount1 as u256)
            evm.log3(
                data: span(out, 64),
                topic0: COLLECT_PROTOCOL_TOPIC,
                topic1: ctx.caller().inner,
                topic2: recipient.inner,
            )
            store.slot0 = store.slot0.unlock()
            return_pair(amount0: amount0 as u256, amount1: amount1 as u256)
        }

        Flash uses (ctx, mut call, mut evm, mut store, token0, token1, pool_config) {
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()
            let fee_protocol = slot0.fee_protocol()
            require_msg(
                mut evm,
                condition: store.liquidity != 0,
                code: MSG_L,
                len: 1,
            )
            let recipient = Address { inner: evm.calldataload(4) }
            let amount0 = evm.calldataload(36)
            let amount1 = evm.calldataload(68)
            let data_offset = evm.calldataload(100)
            let data_start = 4 + data_offset
            let fee = config_fee(pool_config) as u256
            let fee0 = ((amount0 * fee) + 999999) / 1000000
            let fee1 = ((amount1 * fee) + 999999) / 1000000
            let balance0_before = balance_of(token: token0, account: ctx.address())
            let balance1_before = balance_of(token: token1, account: ctx.address())
            if amount0 > 0 {
                compact_transfer(token: token0, to: recipient, value: amount0)
            }
            if amount1 > 0 {
                compact_transfer(token: token1, to: recipient, value: amount1)
            }
            flash_callback(caller: ctx.caller(), fee0, fee1, data_start)
            let balance0_after = balance_of(token: token0, account: ctx.address())
            let balance1_after = balance_of(token: token1, account: ctx.address())
            assert(balance0_before + fee0 <= balance0_after)
            assert(balance1_before + fee1 <= balance1_after)
            let paid0 = sub_u256(a: balance0_after, b: balance0_before)
            let paid1 = sub_u256(a: balance1_after, b: balance1_before)
            if paid0 > 0 {
                let feeProtocol0 = fee_protocol & 0x0f
                let fees0 = if feeProtocol0 == 0 {
                    0
                } else {
                    paid0 / (feeProtocol0 as u256)
                }
                store.protocol_fee0 += fees0.downcast_unchecked()
                store.fee_growth_global0_x128 = add_u256(
                    a: store.fee_growth_global0_x128,
                    b: mul_div(paid0 - fees0, Q128, denominator: store.liquidity as u256),
                )
            }
            if paid1 > 0 {
                let feeProtocol1 = fee_protocol >> 4
                let fees1 = if feeProtocol1 == 0 {
                    0
                } else {
                    paid1 / (feeProtocol1 as u256)
                }
                store.protocol_fee1 += fees1.downcast_unchecked()
                store.fee_growth_global1_x128 = add_u256(
                    a: store.fee_growth_global1_x128,
                    b: mul_div(paid1 - fees1, Q128, denominator: store.liquidity as u256),
                )
            }
            emit_flash(
                sender: ctx.caller(),
                recipient,
                amount0,
                amount1,
                paid0,
                paid1,
            )
            store.slot0 = slot0
        }

        Swap uses (ctx, mut call, mut evm, mut store, token0, token1, pool_config) {
            let slot0_start = store.slot0
            check_unlocked(mut evm, slot0_start.unlocked())
            let recipient = Address { inner: evm.calldataload(4) }
            let zero_for_one = evm.calldataload(36) != 0
            let amount_specified = evm.calldataload(68)
            let sqrt_price_limit_x96 = evm.calldataload(100)
            let data_offset = evm.calldataload(132)
            let data_start = 4 + data_offset
            require_msg(
                mut evm,
                condition: amount_specified != 0,
                code: MSG_AS,
                len: 2,
            )
            require_msg(
                mut evm,
                condition: if zero_for_one {
                    sqrt_price_limit_x96 < slot0_start.sqrt_price_x96()
                        && sqrt_price_limit_x96 > min_sqrt_ratio()
                } else {
                    sqrt_price_limit_x96 > slot0_start.sqrt_price_x96()
                        && sqrt_price_limit_x96 < max_sqrt_ratio()
                },
                code: MSG_SPL,
                len: 3,
            )
            let mut slot0_next = slot0_start.lock()
            store.slot0 = slot0_next
            let input_token = if zero_for_one { token0 } else { token1 }
            let output_token = if zero_for_one { token1 } else { token0 }
            let sqrt_price_start_x96 = slot0_start.sqrt_price_x96()
            let tick_start = slot0_start.tick()
            let current_time: u32 = evm.timestamp().downcast_unchecked()
            let pool_config = pool_config
            let fee_pips = config_fee(pool_config) as u256
            let tick_spacing = config_tick_spacing(pool_config) as i256
            let mut tick_cumulative: i256 = 0
            let mut seconds_per_liquidity_cumulative_x128: u256 = 0
            let mut computed_latest_observation = false

            let exact_input = amount_specified <= MAX_I256_WORD
            let mut amount_remaining = amount_specified
            let mut amount_owed = 0
            let mut amount_out_total = 0
            let mut sqrt_price_x96 = sqrt_price_start_x96
            let mut tick_current = tick_start as i256
            let liquidity_start = store.liquidity
            let mut liquidity_current = liquidity_start
            let mut protocol_fees = 0
            let fee_protocol_word = slot0_start.fee_protocol()
            let fee_protocol = if zero_for_one {
                fee_protocol_word & 0x0f
            } else {
                fee_protocol_word >> 4
            }
            let mut fee_growth_global_x128 = if zero_for_one {
                store.fee_growth_global0_x128
            } else {
                store.fee_growth_global1_x128
            }

            while amount_remaining != 0 && sqrt_price_x96 != sqrt_price_limit_x96 {
                let sqrt_price_step_start_x96 = sqrt_price_x96
                let (mut tick_next, initialized) = next_initialized_tick_within_one_word_at(
                    tick: tick_current,
                    tick_spacing,
                    lte: zero_for_one,
                    bitmap_slot: TICK_BITMAP_SLOT,
                )
                if tick_next < MIN_TICK {
                    tick_next = MIN_TICK
                } else if tick_next > MAX_TICK {
                    tick_next = MAX_TICK
                }
                let sqrt_price_next_tick_x96 = get_sqrt_ratio_at_tick(
                    tick: tick_next.downcast_unchecked(),
                )
                let sqrt_price_target_x96 = if zero_for_one {
                    if sqrt_price_next_tick_x96 < sqrt_price_limit_x96 {
                        sqrt_price_limit_x96
                    } else {
                        sqrt_price_next_tick_x96
                    }
                } else if sqrt_price_next_tick_x96 > sqrt_price_limit_x96 {
                    sqrt_price_limit_x96
                } else {
                    sqrt_price_next_tick_x96
                }

                let (sqrt_price_next_x96, amount_in, amount_out, fee_amount) = call_swap_step(
                    sqrt_ratio_current_x96: sqrt_price_x96,
                    sqrt_ratio_target_x96: sqrt_price_target_x96,
                    liquidity: liquidity_current,
                    amount_remaining,
                    fee_pips,
                )
                sqrt_price_x96 = sqrt_price_next_x96
                let amount_in_with_fee = add_u256(a: amount_in, b: fee_amount)
                amount_owed = add_u256(a: amount_owed, b: amount_in_with_fee)
                if exact_input {
                    amount_remaining = if amount_in_with_fee >= amount_remaining {
                        0
                    } else {
                        sub_u256(a: amount_remaining, b: amount_in_with_fee)
                    }
                } else {
                    amount_remaining = add_u256(a: amount_remaining, b: amount_out)
                }
                amount_out_total = add_u256(a: amount_out_total, b: amount_out)

                let fee_amount_after_protocol = if fee_protocol == 0 {
                    fee_amount
                } else {
                    let protocol_fee_delta = fee_amount / (fee_protocol as u256)
                    protocol_fees = add_u256(a: protocol_fees, b: protocol_fee_delta)
                    fee_amount - protocol_fee_delta
                }
                if liquidity_current > 0 {
                    fee_growth_global_x128 = add_u256(
                        a: fee_growth_global_x128,
                        b: mul_div(
                            fee_amount_after_protocol,
                            Q128,
                            denominator: liquidity_current as u256,
                        ),
                    )
                }

                if sqrt_price_x96 == sqrt_price_next_tick_x96 {
                    if initialized {
                        if !computed_latest_observation {
                            let observation = current_observation(
                                current_time,
                                block_timestamp: store.observation0_block_timestamp,
                                tick_cumulative: store.observation0_tick_cumulative,
                                tick_current: tick_start,
                                seconds_per_liquidity_cumulative_x128: store
                                    .observation0_seconds_per_liquidity_cumulative_x128,
                                liquidity: liquidity_start,
                            )
                            tick_cumulative = observation.0
                            seconds_per_liquidity_cumulative_x128 = observation.1
                            computed_latest_observation = true
                        }
                        let mut liquidity_net = tick::cross_at(
                            tick: tick_next,
                            fee_growth_global0_x128: if zero_for_one {
                                fee_growth_global_x128
                            } else {
                                store.fee_growth_global0_x128
                            },
                            fee_growth_global1_x128: if zero_for_one {
                                store.fee_growth_global1_x128
                            } else {
                                fee_growth_global_x128
                            },
                            seconds_per_liquidity_cumulative_x128,
                            tick_cumulative,
                            time: current_time,
                            ticks_slot: TICKS_SLOT,
                        )
                        if zero_for_one {
                            liquidity_net = to_int128(0 - (liquidity_net as i256))
                        }
                        liquidity_current = add_delta(liquidity_current, liquidity_net)
                    }
                    tick_current = if zero_for_one {
                        tick_next - 1
                    } else {
                        tick_next
                    }
                } else if sqrt_price_x96 != sqrt_price_step_start_x96 {
                    tick_current = tick_at_sqrt_ratio(sqrt_price_x96: sqrt_price_x96) as i256
                }
            }

            if tick_current != tick_start as i256 {
                if !computed_latest_observation {
                    let observation = current_observation(
                        current_time,
                        block_timestamp: store.observation0_block_timestamp,
                        tick_cumulative: store.observation0_tick_cumulative,
                        tick_current: tick_start,
                        seconds_per_liquidity_cumulative_x128: store
                            .observation0_seconds_per_liquidity_cumulative_x128,
                        liquidity: liquidity_start,
                    )
                    tick_cumulative = observation.0
                    seconds_per_liquidity_cumulative_x128 = observation.1
                }
                store.observation0_block_timestamp = current_time
                store.observation0_tick_cumulative = tick_cumulative.downcast_unchecked()
                store
                    .observation0_seconds_per_liquidity_cumulative_x128 = seconds_per_liquidity_cumulative_x128
                slot0_next = slot0_next
                    .with_sqrt_price_x96(sqrt_price_x96)
                    .with_tick(tick_current.downcast_unchecked())
                store.slot0 = slot0_next
            } else if sqrt_price_x96 != sqrt_price_start_x96 {
                slot0_next = slot0_next.with_sqrt_price_x96(sqrt_price_x96)
                store.slot0 = slot0_next
            }
            if liquidity_current != liquidity_start {
                store.liquidity = liquidity_current
            }
            if zero_for_one {
                store.fee_growth_global0_x128 = fee_growth_global_x128
                if protocol_fees > 0 {
                    store.protocol_fee0 += protocol_fees.downcast_unchecked()
                }
            } else {
                store.fee_growth_global1_x128 = fee_growth_global_x128
                if protocol_fees > 0 {
                    store.protocol_fee1 += protocol_fees.downcast_unchecked()
                }
            }

            let balance_before = balance_of(token: input_token, account: ctx.address())
            if amount_out_total > 0 {
                compact_transfer(
                    token: output_token,
                    to: recipient,
                    value: amount_out_total,
                )
            }
            let amount0_delta = if zero_for_one {
                amount_owed
            } else {
                sub_u256(a: 0, b: amount_out_total)
            }
            let amount1_delta = if zero_for_one {
                sub_u256(a: 0, b: amount_out_total)
            } else {
                amount_owed
            }
            swap_callback_calldata(
                caller: ctx.caller(),
                amount0_delta,
                amount1_delta,
                data_start,
            )
            let balance_after = balance_of(token: input_token, account: ctx.address())
            require_msg(
                mut evm,
                condition: balance_before + amount_owed <= balance_after,
                code: MSG_IIA,
                len: 3,
            )
            let log_data = ptr::alloc_bytes(160)
            evm.mstore(addr: log_data, value: amount0_delta)
            evm.mstore(addr: at(log_data, 32), value: amount1_delta)
            evm.mstore(addr: at(log_data, 64), value: sqrt_price_x96)
            evm.mstore(addr: at(log_data, 96), value: liquidity_current as u256)
            evm.mstore(addr: at(log_data, 128), value: int_key(tick_current))
            evm.log3(
                data: span(log_data, 160),
                topic0: SWAP_TOPIC,
                topic1: ctx.caller().inner,
                topic2: recipient.inner,
            )
            store.slot0 = slot0_next.unlock()
            if zero_for_one {
                return_pair(
                    amount0: amount_owed,
                    amount1: sub_u256(a: 0, b: amount_out_total),
                )
            }
            return_pair(
                amount0: sub_u256(a: 0, b: amount_out_total),
                amount1: amount_owed,
            )
        }

        Observe uses (mut evm, store) {
            let current_time: u32 = evm.timestamp().downcast_unchecked()
            let time_delta = current_time - store.observation0_block_timestamp
            let tick_cumulative = (store.observation0_tick_cumulative as i256)
                + ((store.slot0.tick() as i256) * (time_delta as i256))
            let seconds_per_liquidity_cumulative_x128 = current_seconds_per_liquidity(
                seconds_per_liquidity_cumulative_x128: store
                    .observation0_seconds_per_liquidity_cumulative_x128,
                time_delta,
                liquidity: store.liquidity,
            )
            let out = ptr::alloc_bytes(192)
            evm.mstore(addr: out, value: 64)
            evm.mstore(addr: at(out, 32), value: 128)
            evm.mstore(addr: at(out, 64), value: 1)
            evm.mstore(addr: at(out, 96), value: int_key(tick_cumulative))
            evm.mstore(addr: at(out, 128), value: 1)
            evm.mstore(
                addr: at(out, 160),
                value: seconds_per_liquidity_cumulative_x128,
            )
            evm.return_data(data: span(out, 192))
        }

        Ticks uses (mut evm) {
            let tick = decode_int24_word(evm.calldataload(4))
            let (
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside,
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            ) = tick::read_tick_at(tick, ticks_slot: TICKS_SLOT)
            return_tick_info(
                liquidity_gross,
                liquidity_net,
                fee_growth_outside0_x128,
                fee_growth_outside1_x128,
                tick_cumulative_outside,
                seconds_per_liquidity_outside_x128,
                seconds_outside,
                initialized,
            )
        }

        TickBitmap uses (mut evm) {
            let word_pos = decode_int16_word(evm.calldataload(4))
            return_word(
                value: evm.sload(word_slot(word_pos, bitmap_slot: TICK_BITMAP_SLOT)),
            )
        }

        Positions uses (mut evm) {
            let (
                liquidity_value,
                fee_growth_inside0_last_x128,
                fee_growth_inside1_last_x128,
                tokens_owed0,
                tokens_owed1,
            ) = position::read_position(
                position::mapping_slot(key: evm.calldataload(4), positions_slot: POSITIONS_SLOT),
            )
            return_position_info(
                liquidity_value,
                fee_growth_inside0_last_x128,
                fee_growth_inside1_last_x128,
                tokens_owed0,
                tokens_owed1,
            )
        }

        Mint uses (ctx, mut call, mut evm, mut store, token0, token1, pool_config) {
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()

            let recipient = Address { inner: evm.calldataload(4) }
            let tick_lower: i32 = decode_int24_word(evm.calldataload(36)).downcast_unchecked()
            let tick_upper: i32 = decode_int24_word(evm.calldataload(68)).downcast_unchecked()
            let amount = decode_u128_word(evm.calldataload(100))
            let data_start = 4 + evm.calldataload(132)
            assert(amount > 0)
            let liquidity_delta = to_int128(amount as i256)
            let (amount0, amount1) = modify_position(
                owner: recipient,
                tick_lower: tick_lower as i256,
                tick_upper: tick_upper as i256,
                liquidity_delta,
                pool_config,
            )

            let balance0_before = if amount0 > 0 {
                balance_of(token: token0, account: ctx.address())
            } else {
                0
            }
            let balance1_before = if amount1 > 0 {
                balance_of(token: token1, account: ctx.address())
            } else {
                0
            }

            mint_callback_calldata(caller: ctx.caller(), amount0, amount1, data_start)

            if amount0 > 0 {
                let balance0_after: u256 = balance_of(token: token0, account: ctx.address())
                require_msg(
                    mut evm,
                    condition: balance0_before + amount0 <= balance0_after,
                    code: MSG_M0,
                    len: 2,
                )
            }
            if amount1 > 0 {
                let balance1_after: u256 = balance_of(token: token1, account: ctx.address())
                require_msg(
                    mut evm,
                    condition: balance1_before + amount1 <= balance1_after,
                    code: MSG_M1,
                    len: 2,
                )
            }

            store.slot0 = store.slot0.unlock()
            emit_mint(
                sender: ctx.caller(),
                owner: recipient,
                tick_lower,
                tick_upper,
                amount,
                amount0,
                amount1,
            )
            return_pair(amount0, amount1)
        }

        Burn uses (ctx, mut call, mut evm, mut store, pool_config) {
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()

            let tick_lower: i32 = decode_int24_word(evm.calldataload(4)).downcast_unchecked()
            let tick_upper: i32 = decode_int24_word(evm.calldataload(36)).downcast_unchecked()
            let amount = decode_u128_word(evm.calldataload(68))
            let liquidity_delta = 0 - to_int128(amount as i256)
            let (amount0, amount1) = modify_position(
                owner: ctx.caller(),
                tick_lower: tick_lower as i256,
                tick_upper: tick_upper as i256,
                liquidity_delta,
                pool_config,
            )

            store.slot0 = store.slot0.unlock()
            emit_burn(
                owner: ctx.caller(),
                tick_lower,
                tick_upper,
                amount,
                amount0,
                amount1,
            )
            return_pair(amount0, amount1)
        }

        Collect uses (ctx, mut evm, mut store, token0, token1) {
            let slot0 = store.slot0
            check_unlocked(mut evm, slot0.unlocked())
            store.slot0 = slot0.lock()

            let recipient = Address { inner: evm.calldataload(4) }
            let tick_lower = decode_int24_word(evm.calldataload(36))
            let tick_upper = decode_int24_word(evm.calldataload(68))
            let amount0_requested = decode_u128_word(evm.calldataload(100))
            let amount1_requested = decode_u128_word(evm.calldataload(132))
            let position_slot = position::position_slot(
                owner: ctx.caller(),
                tick_lower,
                tick_upper,
                positions_slot: POSITIONS_SLOT,
            )
            let (tokens_owed0, tokens_owed1) = position::read_tokens_owed(position_slot)
            let amount0 = min_u128(a: amount0_requested, b: tokens_owed0)
            let amount1 = min_u128(a: amount1_requested, b: tokens_owed1)

            if amount0 > 0 || amount1 > 0 {
                position::set_tokens_owed(
                    base_slot: position_slot,
                    token0: tokens_owed0 - amount0,
                    token1: tokens_owed1 - amount1,
                )
            }
            if amount0 > 0 {
                compact_transfer(token: token0, to: recipient, value: amount0 as u256)
            }
            if amount1 > 0 {
                compact_transfer(token: token1, to: recipient, value: amount1 as u256)
            }
            store.slot0 = store.slot0.unlock()
            let log_data = ptr::alloc_bytes(96)
            evm.mstore(addr: log_data, value: recipient.inner)
            evm.mstore(addr: at(log_data, 32), value: amount0 as u256)
            evm.mstore(addr: at(log_data, 64), value: amount1 as u256)
            evm.log4(
                data: span(log_data, 96),
                topic0: COLLECT_TOPIC,
                topic1: ctx.caller().inner,
                topic2: int24_abi_word(tick_lower.downcast_unchecked()),
                topic3: int24_abi_word(tick_upper.downcast_unchecked()),
            )
            return_pair(amount0: amount0 as u256, amount1: amount1 as u256)
        }
    }
}
